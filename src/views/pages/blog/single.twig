{#
| Variable                | Type           | Description |
|-------------------------|----------------|-------------|
| article.title           | string         |             |
| article.body            | string *HTML   |             |
| article.url             | string         |             |
| article.has_image       | Bool           |             |
| article.image           | object         |             |
| article.image.url       | string         |             |
| article.image.alt       | string         |             |
| article.thumbnail       | string         |             |
| article.created_at      | ?Date *Carbon  |             |
| article.author.name     | string         |             |
| article.author.url      | string         |             |
| article.related         | Article[]      |             |
| article.tags            | BlogTag[]      |             |
| article.tags[].name     | string         |             |
| article.tags[].url      | string         |             |

UNIX (ROADMAP 5.4 · DS §8.42, §8.43, §14 · D101): unix.sa article.json → centred article header (tags, date,
h1 title, author), wide hero image, the body in a reading column, then «قد يعجبكِ أيضًا» (unix.sa's aside heading)
as a section under the article. The title is the page's only h1: an h1 typed inside the body becomes h2, and
body images get loading="lazy", and each table is wrapped in a keyboard-scrollable box (all server-side). BlogPosting JSON-LD: components/seo/unix-jsonld-article.twig.
The like button keeps Raed's #blog-like contract (blog.js: an <i> icon + a <span> count).
#}
{% extends "layouts.master" %}
{% block content %}
  {% set unix_related = related is defined and related ? related : article.related|default([]) %}
  {% set unix_image = article.image.url is defined ? article.image.url|default('') : '' %}
  {% set unix_has_image = article.has_image and unix_image and not (unix_image|is_placeholder) %}
  {# Assumes Salla-editor HTML (lowercase tags, no loading attribute); pasted HTML may get a duplicate attribute (DS §8.43, D101) #}
  {% set unix_table_open = '<div class="unix-rte__table" role="region" tabindex="0" aria-label="' ~ trans('blocks.unix.blog.table')|e('html_attr') ~ '">' %}
  {% set unix_body = article.body|default('')|replace({
    '&nbsp;': ' ',
    '<h1': '<h2', '<H1': '<h2', '</h1>': '</h2>', '</H1>': '</h2>',
    '<img ': '<img loading="lazy" decoding="async" ', '<IMG ': '<img loading="lazy" decoding="async" ',
    '<table': unix_table_open ~ '<table', '<TABLE': unix_table_open ~ '<table',
    '</table>': '</table></div>', '</TABLE>': '</table></div>'
  }) %}

  {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
  <div class="unix-container">
    <nav class="breadcrumbs w-full py-5">
      <salla-breadcrumb></salla-breadcrumb>
    </nav>
  </div>

  <article class="unix-article" aria-labelledby="unix-article-title">
    <div class="unix-container">
      <header class="unix-article__header">
        {% if article.tags|default([])|length %}
          <ul class="unix-article__tags" role="list" aria-label="{{ trans('blocks.unix.blog.tags') }}">
            {% for tag in article.tags %}
              <li><a class="unix-article__tag" href="{{ tag.url }}">{{ tag.name }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
        {% if article.created_at %}
          <time class="unix-article__date" datetime="{{ article.created_at|date('Y-m-d') }}">{{ article.created_at|date }}</time>
        {% endif %}
        <h1 class="unix-article__title" id="unix-article-title">{{ article.title }}</h1>
        {% if article.author.name|default('') %}
          <p class="unix-article__author">
            {{ trans('blocks.unix.blog.by') }}
            {% if article.author.url|default('') %}
              <a href="{{ article.author.url }}">{{ article.author.name }}</a>
            {% else %}
              <span>{{ article.author.name }}</span>
            {% endif %}
          </p>
        {% endif %}
      </header>

      {% if unix_has_image %}
        <figure class="unix-article__hero">
          {# 6.2 (PERF-PLAYBOOK §6.1 rule 5): LCP image, wide hero #}
          <img src="{{ unix_image|cdn(1280) }}"
               srcset="{{ unix_image|cdn(640) }} 640w, {{ unix_image|cdn(960) }} 960w, {{ unix_image|cdn(1280) }} 1280w, {{ unix_image|cdn(1920) }} 1920w"
               sizes="(min-width: 1600px) 1600px, 100vw"
               alt="{{ article.image.alt|default('') }}" width="1600" height="900"
               loading="eager" fetchpriority="high">
        </figure>
      {% endif %}

      <div class="unix-article__body unix-rte">{{ unix_body|raw }}</div>

      {% if store.settings.blog.allow_likes_and_comments %}
        <div class="unix-article__actions">
          <button type="button" id="blog-like" class="unix-article__like" data-blog-id="{{ article.key }}"
                  aria-pressed="false">
            <i class="sicon-thumbs-up" aria-hidden="true"></i>
            {# the count stays the first span: blog.js reads it #}
            <span>{{ article.likes_count|default(0) }}</span>
            <span class="sr-only">{{ trans('blocks.unix.blog.like') }}</span>
          </button>
          {% if article.comments_count %}
            <span class="unix-article__count">
              <i class="sicon-chat" aria-hidden="true"></i>
              <span class="sr-only">{{ trans('blocks.unix.blog.comments') }}</span>
              {{ article.comments_count }}
            </span>
          {% endif %}
        </div>
      {% endif %}

      {% if article.tags|default([])|length %}
        <footer class="unix-article__footer">
          <ul class="unix-article__tags" role="list" aria-label="{{ trans('blocks.unix.blog.tags') }}">
            {% for tag in article.tags %}
              <li><a class="unix-article__tag" href="{{ tag.url }}">{{ tag.name }}</a></li>
            {% endfor %}
          </ul>
        </footer>
      {% endif %}

      {% if store.settings.blog.allow_likes_and_comments %}
        <div class="unix-article__comments">
          <salla-comments data-testid="store-blog-comments" item-id="{{ article.key }}" type="blog"></salla-comments>
        </div>
      {% endif %}
    </div>
  </article>

  {% if unix_related|length %}
    <section class="unix-article-related" aria-labelledby="unix-article-related-title">
      <div class="unix-container">
        <div class="unix-article-related__head">
          <h2 class="unix-article-related__title" id="unix-article-related-title">{{ trans('blocks.unix.blog.related') }}</h2>
          {# ROADMAP 6.1 · DS §8.2 (D106): section-header «عرض الكل» = primary site-wide #}
          <a class="unix-btn unix-btn--sm" href="{{ link('blog') }}">{{ trans('blocks.unix.blog.view_all') }}</a>
        </div>

        {% hook 'blog:single.items.start' %}
        <div class="unix-article-related__grid">
          {% for item in unix_related|slice(0, 4) %}
            {% include 'components.blog.unix-article-card' with { article: item, heading: 'h3', hide_excerpt: true } only %}
          {% endfor %}
        </div>
        {% hook 'blog:single.items.end' %}
      </div>
    </section>
  {% endif %}

  {% include 'components.seo.unix-jsonld-article' %}
{% endblock %}
