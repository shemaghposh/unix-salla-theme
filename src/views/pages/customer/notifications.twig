{% extends "layouts.customer" %}
{% block inner_content %}
	{#
		ROADMAP 5.8 · DS §8.48: Salla's salla-notifications as is (fetch, «load more», links), inside an
		account panel and restyled through its public .s-notifications-* classes (unix-account.scss).
	#}
	{% hook 'customer:notifications.items.start' %}

	<div class="unix-account-panel unix-notifications">
		{# ROADMAP 6.3: Salla's item titles are h4; an h2 keeps the outline from jumping h1 → h4 #}
		<h2 class="sr-only">{{ trans('blocks.unix.account.notifications') }}</h2>
		<salla-notifications data-testid="store-notifications"></salla-notifications>
	</div>

	{% hook 'customer:notifications.items.end' %}
{% endblock %}
