UNIX (ROADMAP 5.1 · DS §8.37 · D94): Salla's profile form (`salla.form.onSubmit('profile.update')`,
salla-tel-input, salla-datetime-picker, custom fields, salla-verify, salla-user-settings) and its hooks are
kept as they are; only the markup classes change, so the look comes from the system (.unix-account-panel,
.form-label, .form-input / .s-form-control, salla-button).
#}
{% extends "layouts.customer" %}
{% block inner_content %}
    {% hook 'customer:profile.form.start' %}
    <form class="form form--user-profile unix-account-panel unix-profile ajax" onsubmit="return salla.form.onSubmit('profile.update', event)">
        <div class="unix-profile__grid">

            {% hook 'customer:profile.form.fields.start' %}

            <div class="profile-field-item unix-profile__field">
                <label for="first-name" class="form-label">
                    {{ trans('pages.profile.first_name') }}
                </label>
                <input data-testid="store-profile-first-name" type="text" name="first_name" value="{{ user.first_name }}" id="first-name" required
                       autocomplete="given-name" class="form-input">
            </div>

            <div class="profile-field-item unix-profile__field">
                <label for="last-name" class="form-label">
                    {{ trans('pages.profile.last_name') }}
                </label>
                <input data-testid="store-profile-last-name" type="text" name="last_name" value="{{ user.last_name }}" id="last-name" autocomplete="family-name"
                       required class="form-input">
            </div>

            <div class="profile-field-item unix-profile__field">
                <label for="birthday" class="form-label">
                    {{ trans('pages.profile.birthday') }}
                </label>
                <salla-datetime-picker
                        data-testid="store-profile-birthday"
                        date-format="Y-m-d"
                        value="{{ user.birthday }}"
                        placeholder="{{ trans('pages.profile.birthday_placeholder') }}"
                        required
                        name="birthday"
                ></salla-datetime-picker>
            </div>

            <div class="profile-field-item unix-profile__field">
                <label for="gender" class="form-label">
                    {{ trans('pages.profile.gender') }}
                </label>
                <select data-testid="store-profile-gender" class="form-input" id="gender" name="gender" required>
                    <option placeholder value="">{{ trans('pages.profile.gender_placeholder') }}</option>
                    <option value="male" {{ user.gender=='male'?'selected':'' }}>
                        {{ trans('pages.profile.male') }}
                    </option>
                    <option value="female" {{ user.gender=='female'?'selected':'' }}>
                        {{ trans('pages.profile.female') }}
                    </option>
                </select>
            </div>

            <div class="profile-field-item unix-profile__field">
                <label for="email" class="form-label">
                    {{ trans('common.elements.email') }}
                </label>
                <input data-testid="store-profile-email" type="email" name="email" value="{{ user.email }}" id="email" autocomplete="email" class="form-input" required>
            </div>

            <div class="profile-field-item unix-profile__field">
                <label for="international-mobile" class="form-label">
                    {{ trans('common.elements.mobile') }}
                </label>
                <salla-tel-input data-testid="store-profile-phone" phone="{{ user.mobile }}"></salla-tel-input>
            </div>
            {% for field in custom_fields %}
                <div class="profile-field-item unix-profile__field">
                    <label for="{{ field.id }}" class="form-label">
                        {{ field.label }}
                    </label>
                    {% if field.type == 'photo' %}
                        <salla-file-upload
                                instant-upload
                                value="{{ field.value }}"
                                url="{{ store.url|trim('/'~user.language_code) }}/upload-image"
                                name="custom_fields[{{ field.id }}]"
                                payload-name="image"
                                height="120px"
                        >
                            <div class="profile-filepond-placholder">
                                <span class="profile-filepond-placholder-icon"><i class="sicon-camera" aria-hidden="true"></i></span>
                                <p class="profile-filepond-placholder-text">{{ trans('common.uploader.drag_and_drop') }}</p>
                                <span class="filepond--label-action">{{ trans('common.uploader.browse') }}</span>
                            </div>
                        </salla-file-upload>
                        <input type="hidden" name="custom_fields[{{ field.id }}]" value="{{ field.value }}">
                    {% else %}
                        <input type="{{ field.type }}"
                               id="{{ field.id }}"
                               value="{{ field.value }}"
                               name="custom_fields[{{ field.id }}]"
                               class="form-input" {{ field.required?'required':'' }}/>
                    {% endif %}
                </div>
            {% endfor %}

            {% hook 'customer:profile.form.fields.end' %}
        </div>

        {% hook 'customer:profile.form.submit.start' %}

        <div class="unix-profile__actions">
            <salla-button data-testid="store-profile-submit" type="submit" loader-position="end" class="unix-profile__submit">
                {{ trans('common.elements.save') }}
            </salla-button>
        </div>

        {% hook 'customer:profile.form.submit.end' %}
    </form>
    {% hook 'customer:profile.form.end' %}

    <salla-verify data-testid="store-profile-verify"></salla-verify>

    <salla-user-settings data-testid="store-profile-settings" {{ user.is_notifiable?'is-notifiable':0 }} class="unix-account-panel unix-profile__settings"></salla-user-settings>
{% endblock %}
