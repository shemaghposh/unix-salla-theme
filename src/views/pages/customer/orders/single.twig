{#
| Variable                         | Type                              | Description                                                                              |
|----------------------------------|-----------------------------------|------------------------------------------------------------------------------------------|
| page                             | object                            |                                                                                          |
| page.title                       | string                            |                                                                                          |
| page.slug                        | string                            |                                                                                          |
| order                            | Order                             |                                                                                          |
| order.id                         | integer                           |                                                                                          |
| order.reference_id               | integer                           |                                                                                          |
| order.created_at                 | date                              |                                                                                          |
| order.sub_total                  | float                             |                                                                                          |
| order.total                      | float                             |                                                                                          |
| order.cod_cost                   | float                             | * Cash On Delivery                                                                       |
| order.can_reorder                | bool                              |                                                                                          |
| order.can_cancel                 | bool                              |                                                                                          |
| order.can_rate                   | bool                              |                                                                                          |
| order.cancel_url                 | string                            |                                                                                          |
| order.payment_url                | string                            |                                                                                          |
| order.is_pending_payment         | bool                              |                                                                                          |
| order.pending_payment_ends_in    | int                               | How much many seconds untile pending payment ends, zero if it's already expired          |
| order.shipping                   | ?object                           |                                                                                          |
| order.shipping.id                | integer                           |                                                                                          |
| order.shipping.name              | string                            |                                                                                          |
| order.shipping.number            | string                            | number/string/link (..) for shipment number (tracking number)                            |
| order.shipping.logo              | ?string                           |                                                                                          |
| order.shipping.cost              | ?Money                            |                                                                                          |
| order.shipments[]                | ShipmentObject[]                  |                                                                                          |
| order.tax                        | ?object                           |                                                                                          |
| order.tax.amount                 | float                             |                                                                                          |
| order.tax.percent                | float                             |                                                                                          |
| order.status                     | object                            |                                                                                          |
| order.status.name                | string                            |                                                                                          |
| order.status.icon                | string                            |                                                                                          |
| order.status.color               | string                            |                                                                                          |
| order.items                      | OrderItem[]                       |                                                                                          |
| order.options                    | OrderOption[]                     |                                                                                          |
| order.items[].name               |                                   |                                                                                          |
| order.items[].image              |                                   |                                                                                          |
| order.items[].price              | TaxableMoney                      |                                                                                          |
| order.items[].quantity           |                                   |                                                                                          |
| order.items[].total              | TaxableMoney                      |                                                                                          |
| order.items[].product            | ?Product                          | There are cases product is null, when merchant adds special product to the order         |
| order.items[].sub_products       | ?Product[] *Collection            |                                                                                          |
| order.items[].note               |                                   |                                                                                          |
| order.items[].attachments        | OrderItemAttachment[] *Collection | if it's empty will be empty array so you can use it as check `{% if item.attachments %}` |
| order.items[].attachments[].type | string                            |                                                                                          |
| order.items[].attachments[].url  | string                            |                                                                                          |
| order.items[].options            | ?OrderItemOption[] *Collection    |                                                                                          |
| order.items[].options[].name     | string                            |                                                                                          |
| order.items[].options[].value    | string                            |                                                                                          |
| order.items[].options[].is_image | bool                              |                                                                                          |
| order.items[].options[].color    | string                            | option hex color                                                                         |
| order.items[].rating             | ?Rating                           |                                                                                          |
| order.items[].rating.content     | string                            | *HTML                                                                                    |
| order.items[].rating.is_pending  | bool                              |                                                                                          |
| order.items[].rating.stars       | int                               |                                                                                          |
| order.items[].rating.images      | array                             |                                                                                          |
| order.items[].rating.created_at  | date                              |                                                                                          |
| order.discounts                  | array                             |                                                                                          |
| order.discounts[].name           | string                            |                                                                                          |
| order.discounts[].discount       | float                             | minus number                                                                             |
| order.is_rated                   | bool                              |                                                                                          |
| order.rating                     | ?OrderRatings                     |                                                                                          |
| order.rating.store               | ?Rating                           |                                                                                          |
| order.rating.shipping            | ?Rating                           |                                                                                          |
| order.rating.product             | ?array                            | Product ratings array with factor_reviews                                                |
| order.links                      | array                             |                                                                                          |
| order.links[].url                | string                            |                                                                                          |
| order.links[].label              | string                            |                                                                                          |
| order.links[].type               | string                            | One of ['print', 'shipment', 'digital']                                                  |

UNIX (ROADMAP 5.2 · DS §8.39 · D96): Raed's order page logic, hooks and Salla components are kept
(js/order.js still drives #btn-reorder / #confirm-cancel); the markup moves onto the account panels:
summary, notes, rating call-out, one panel per shipment with its items, options, Salla's totals card,
reorder / cancel / pay, and the store / shipping ratings. One h1 (page.title). Status colours from the
dashboard are not used (the status name carries the meaning).
#}

{% extends "layouts.customer" %}
{% block inner_title %}
    <div class="unix-account__heading">
        <h1 class="unix-account__title">
            {{ page.title }}
            {% if order.source is same as('buy_as_gift') %}
                <span class="unix-order__gift"><i class="sicon-gift-sharing" aria-hidden="true"></i>{{ trans('pages.orders.gift_tag') }}</span>
            {% endif %}
        </h1>
    </div>
    <div class="unix-order__head-actions">
        <salla-edit-order-button data-testid="store-order-edit-btn"></salla-edit-order-button>
    </div>
{% endblock %}

{% block inner_content %}
    <div class="unix-order">

        {% hook 'customer:orders.single.details.start' %}

        {# Order summary: date, status, links, print #}
        <section class="unix-account-panel unix-order__meta" data-testid="store-order-status">
            <dl class="unix-order__facts">
                <div class="unix-order__fact">
                    <dt>{{ trans('pages.orders.date') }}</dt>
                    <dd>{{ order.created_at|date|number }}</dd>
                </div>
                <div class="unix-order__fact">
                    <dt>{{ trans('pages.orders.status') }}</dt>
                    <dd>
                        {% if order.is_pending_payment and order.pending_payment_ends_in == 0 %}
                            <span class="unix-order__expired">{{ trans('pages.orders.pending_payment_expired') }}</span>
                        {% else %}
                            <span class="unix-order__status">
                                {% if order.status.icon %}<i class="{{ order.status.icon }}" aria-hidden="true"></i>{% endif %}
                                <span>{{ order.status.name }}</span>
                            </span>
                        {% endif %}
                    </dd>
                </div>
            </dl>

            {% if order.is_price_quote %}
                <p class="unix-order__note"><i class="sicon-info" aria-hidden="true"></i><span>{{ trans('pages.orders.your_order_is_under_review') }}</span></p>
            {% endif %}

            <div class="unix-order__actions">
                {% for link in order.links %}
                    <a href="{{ link.url }}" class="unix-btn unix-btn--outline unix-btn--sm" target="_blank" rel="noopener">
                        {{ link.label }}
                        <i class="sicon-arrow-up-right icon-dir" aria-hidden="true"></i>
                    </a>
                {% endfor %}
                {% if can_print_invoice %}
                    <salla-button fill="outline" size="small"
                                  onclick="window.open('{{ order.print_url() }}', '_blank', 'toolbar=yes, scrollbars=yes, resizable=yes, width=900, height=700');">
                        <i class="sicon-printer2" aria-hidden="true"></i>
                        {{ trans('pages.orders.print') }}
                    </salla-button>
                {% endif %}
            </div>

            {% if not can_print_invoice %}
                <p class="unix-order__hint">
                    {{ trans('pages.orders.to_order_invoice_contact_vendor') }}
                    {{ trans('pages.orders.print_order_details') }}
                    <button type="button" class="unix-btn unix-btn--link unix-order__hint-link"
                            onclick="window.open('{{ order.print_url() }}', '_blank', 'toolbar=yes, scrollbars=yes, resizable=yes, width=900, height=700');">{{ trans('pages.orders.click_here') }}</button>
                </p>
            {% endif %}
        </section>

        {% if order.is_pickable %}
            <salla-order-branch data-testid="store-order-branch" stack-cards></salla-order-branch>
        {% endif %}

        {% if order.refund_message %}
            <div class="unix-order__note">
                <i class="sicon-refund" aria-hidden="true"></i>
                <div>{{ order.refund_message|raw }}</div>
            </div>
        {% endif %}

        {% if store.settings.rating.allow_update and order.rating is not empty %}
            <p class="unix-order__note">
                <i class="sicon-info" aria-hidden="true"></i>
                <span>{{ trans('pages.order.can_edit_or_delete_your_review_within') }} {{ store.settings.rating.update_period }} {{ trans('pages.order.days_since_added') }}.</span>
            </p>
        {% endif %}

        {# Order rating call-out #}
        {% if order.can_rate %}
            <section class="unix-account-panel unix-order__row-panel">
                <div class="unix-order__row-text">
                    <h2 class="unix-order__h2">{{ trans('pages.order.order_rating_title') }}</h2>
                    <p class="unix-order__row-desc">{{ trans('pages.order.order_rating_message') }}</p>
                </div>
                <salla-button data-testid="store-order-rate-btn" class="unix-order__row-btn" onclick="salla.event.dispatch('rating::open')">{{ trans('pages.rating.rate') }}</salla-button>
            </section>
        {% endif %}

        {# Shipments and their items #}
        {% for package in order.packages %}
            <section class="unix-account-panel unix-order__package shipping-orders">
                {% if package.shipping_company and not order.is_pickable %}
                    <div class="unix-order__package-head">
                        <div class="unix-order__carrier">
                            {% if package.shipping_company.logo %}
                                <img src="{{ package.shipping_company.logo }}" class="unix-order__carrier-logo" alt="" loading="lazy" width="96" height="32">
                            {% endif %}
                            <span>{{ package.shipping_company.name }}</span>
                        </div>
                        <div class="unix-order__package-facts">
                            {% if package.branch %}
                                <span>{{ trans('pages.orders.branch') }}: <b>{{ package.branch.name }}</b></span>
                            {% endif %}
                            {% if package.shipping_company.number %}
                                <span>{{ trans('pages.orders.shipment_no') }}: <b>{{ package.shipping_company.number|raw }}</b></span>
                            {% endif %}
                            {% if package.is_delivered %}
                                <span>{{ trans('pages.orders.status') }}:
                                    <span class="unix-order__status">
                                        {% if package.status.icon %}<i class="{{ package.status.icon }}" aria-hidden="true"></i>{% endif %}
                                        <b>{{ package.status.name }}</b>
                                    </span>
                                </span>
                            {% elseif package.shipping_company.tracing_link %}
                                <a class="unix-btn unix-btn--link" href="{{ package.shipping_company.tracing_link|raw }}" target="_blank" rel="noopener">
                                    <span class="sicon-shipping" aria-hidden="true"></span>
                                    {{ trans('pages.orders.tracking_url') }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                <div class="unix-order__items">
                    {% for item in package.items %}
                        <div data-testid="store-order-item-{{ item.id }}" data-order-item-id="{{ item.id }}" data-order-item-product-id="{{ item.product.id }}" class="order-item unix-order-item">
                            <div class="unix-order-item__row">
                                {% if item.product %}
                                    <a href="{{ item.product.url }}" class="unix-order-item__media" tabindex="-1" aria-hidden="true">
                                        <img src="{{ item.image ?: 'images/placeholder.png'|asset }}" alt=""
                                             width="120" height="160" loading="lazy"
                                             class="unix-order-item__img{{ item.image ? '' : ' is-placeholder' }}">
                                    </a>
                                {% endif %}
                                <div class="unix-order-item__info">
                                    <h2 class="unix-order-item__name">
                                        {% if item.product %}
                                            <a href="{{ item.product.url }}">{{ item.name }}</a>
                                        {% else %}
                                            {{ item.name }}
                                        {% endif %}
                                    </h2>
                                    <dl class="unix-order-item__facts">
                                        <div>
                                            <dt>{{ trans('pages.products.quantity') }}</dt>
                                            <dd>{{ item.quantity }}</dd>
                                        </div>
                                        <div>
                                            <dt>{{ trans('pages.products.price') }}</dt>
                                            <dd>{{ item.price|money }}</dd>
                                        </div>
                                        <div class="is-total">
                                            <dt>{{ trans('pages.orders.total') }}</dt>
                                            <dd>{{ item.total|money }}</dd>
                                        </div>
                                    </dl>
                                </div>
                            </div>

                            {% if item.availability_date %}
                                <p class="unix-order__note">
                                    <i class="sicon-info" aria-hidden="true"></i>
                                    <span>{{ trans('pages.products.expected_to_be') }}: <b>{{ item.availability_date|date('Y-m-d') }}</b></span>
                                </p>
                            {% endif %}

                            {% if item.product.type == 'booking' and item.product_reservations is not empty %}
                                {% if item.booking_location != null %}
                                    <dl class="unix-order-item__facts">
                                        <div>
                                            <dt>{{ trans('common.elements.location') }}</dt>
                                            <dd class="text-unicode">{{ item.booking_location }}</dd>
                                        </div>
                                    </dl>
                                {% endif %}
                                <h3 class="unix-order-item__sub">
                                    {{ item.product_reservations.count() > 1 ? trans('pages.cart.reservations') : trans('pages.cart.item_options') }}
                                </h3>
                                <div class="unix-order-item__box">
                                    {% include 'pages.partials.product.reservations' with { reservations: item.product_reservations } %}
                                </div>
                            {% endif %}

                            {# order details sub products and options #}
                            <salla-order-details order-details="{{ item | json_encode }}"></salla-order-details>

                            {% if item.note %}
                                <p class="unix-order-item__note">
                                    <span>{{ trans('common.elements.note') }}:</span> {{ item.note }}
                                </p>
                            {% endif %}

                            {% if item.attachments %}
                                <dl class="unix-order-item__box unix-order-item__attachments">
                                    {% for attachment in item.attachments %}
                                        <div>
                                            <dt>{{ trans('pages.products.attachments') }}</dt>
                                            <dd>
                                                <a href="{{ attachment.url }}" target="_blank" rel="noopener">
                                                    {% if attachment.type == 'image' %}
                                                        <img class="unix-order-item__attachment-img" src="{{ attachment.url }}" alt="{{ item.name }}" width="32" height="32" loading="lazy">
                                                    {% else %}
                                                        {{ trans('pages.orders.file_url') }}
                                                    {% endif %}
                                                </a>
                                            </dd>
                                        </div>
                                    {% endfor %}
                                </dl>
                            {% endif %}

                            <salla-review-order-item product-id="{{ item.product.id }}"></salla-review-order-item>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}

        {% if order.options|length %}
            <section class="unix-account-panel">
                <h2 class="unix-order__h2">{{ trans('pages.cart.cart_options') }}</h2>
                <table class="unix-order__table">
                    <thead>
                        <tr>
                            <th scope="col">{{ trans('pages.order.option_name') }}</th>
                            <th scope="col">{{ trans('pages.order.option_content') }}</th>
                            <th scope="col">{{ trans('pages.products.price') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in order.options %}
                            {% for option in item.options %}
                                <tr>
                                    <td>{{ option.name }}</td>
                                    <td>
                                        {% if option.reservations %}
                                            {% include 'pages.partials.product.reservations' with { reservations: option.reservations } %}
                                        {% else %}
                                            {{ option.value }}
                                        {% endif %}
                                    </td>
                                    <td>{{ option.price|money }}</td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </section>
        {% endif %}

        <salla-order-totals-card data-testid="store-order-totals" order="{{ order }}"></salla-order-totals-card>

        {# Reorder, cancel, finish payment #}
        {% if order.can_reorder or order.can_cancel or order.is_pending_payment %}
            <section class="unix-account-panel unix-order__manage">
                {% if order.can_reorder or order.is_pending_payment %}
                    {% if order.is_pending_payment %}
                        <div class="unix-order__row unix-order__row--center">
                            {% if order.pending_payment_ends_in == 0 %}
                                <span class="unix-order__expired">{{ trans('pages.orders.pending_payment_expired') }}</span>
                            {% else %}
                                <salla-button width="wide" href="{{ order.payment_url }}">
                                    <i class="sicon-wallet" aria-hidden="true"></i>
                                    <span>{{ trans('pages.orders.finish_payment') }}</span>
                                </salla-button>
                            {% endif %}
                        </div>
                    {% elseif user.type == 'user' %}
                        <div class="unix-order__row">
                            <div class="unix-order__row-text">
                                <h2 class="unix-order__h2">{{ trans('pages.orders.reorder') }}</h2>
                                <p class="unix-order__row-desc">{{ trans('pages.orders.reorder_description') }}</p>
                            </div>
                            <salla-button data-testid="store-order-reorder-btn" fill="outline" class="unix-order__row-btn" onclick="document.querySelector('#reorder-modal').open()">
                                <i class="sicon-rotate" aria-hidden="true"></i>
                                <span>{{ trans('pages.orders.reorder') }}</span>
                            </salla-button>
                        </div>
                    {% endif %}
                {% endif %}

                {% if order.can_cancel %}
                    <div class="unix-order__row">
                        <div class="unix-order__row-text">
                            <h2 class="unix-order__h2">{{ trans('pages.orders.cancel') }}</h2>
                            <p class="unix-order__row-desc">{{ trans('pages.order.order_cancelation_desc') }}</p>
                        </div>
                        <salla-button data-testid="store-order-cancel-btn" shape="link" class="unix-order__row-btn" onclick="document.querySelector('#modal-order-cancel').open()">
                            <span>{{ trans('pages.orders.cancel') }}</span>
                        </salla-button>
                    </div>
                {% endif %}
            </section>

            {# Reorder Modal #}
            {% if user.type == 'user' and order.can_reorder %}
                <salla-modal width="sm" sub-title="{{ trans('pages.orders.reorder_confirmation')|raw }}"
                             icon="sicon-rotate" id="reorder-modal" icon-style="success"
                             modal-title="{{ trans('pages.orders.reorder') }}">
                    <div slot="footer" class="unix-order__modal-actions">
                        <salla-button id="btn-reorder" width="wide">
                            {{ trans('common.elements.ok') }}
                        </salla-button>
                        <salla-button width="wide" fill="outline" color="light" onclick="document.querySelector('#reorder-modal').close()">
                            {{ trans('common.elements.cancel') }}
                        </salla-button>
                    </div>
                </salla-modal>
            {% endif %}

            {# Cancel Modal #}
            {% if order.can_cancel %}
                <salla-modal width="sm" sub-title="{{ trans('pages.orders.cancel_confirmation') }}"
                             icon="sicon-cancel" id="modal-order-cancel" icon-style="error"
                             modal-title="{{ trans('common.elements.warning') }}">
                    <div slot="footer" class="unix-order__modal-actions">
                        <salla-button id="confirm-cancel" color="danger" width="wide">
                            {{ trans('common.elements.ok') }}
                        </salla-button>
                        <salla-button width="wide" fill="outline" color="light" onclick="document.querySelector('#modal-order-cancel').close()">
                            {{ trans('common.elements.cancel') }}
                        </salla-button>
                    </div>
                </salla-modal>
            {% endif %}
        {% endif %}

        {# Store and shipping ratings #}
        {% for unix_rating_type in ['store', 'shipping'] %}
            {% set unix_rating = unix_rating_type == 'store' ? order.rating.store : order.rating.shipping %}
            {% if unix_rating.stars %}
                <section class="unix-account-panel unix-order__rating">
                    <div class="unix-order__rating-body">
                        <h2 class="unix-order__h2">{{ unix_rating_type == 'store' ? trans('pages.rating.rate_the_store') : trans('pages.rating.rate_shipping') }}</h2>
                        {% if unix_rating.content %}<div class="unix-order__rating-text">{{ unix_rating.content|raw }}</div>{% endif %}
                        <salla-rating-stars with-label value="{{ unix_rating.stars }}"></salla-rating-stars>
                    </div>
                    {% if store.settings.rating.allow_update %}
                        <div class="unix-order__rating-actions">
                            {# Raed showed "period ended" in hover-only tooltips; here it is a visible note (keyboard/touch) #}
                            <div class="rating-actions">
                                <salla-button
                                    loader-position="center"
                                    {% if not unix_rating.can_update %} disabled {% endif %}
                                    shape="icon"
                                    fill="outline"
                                    color="dark"
                                    size="medium"
                                    {% if unix_rating.can_update %}
                                        onclick="salla.event.dispatch('rating::edit', {type: '{{ unix_rating_type }}', feedback_id: '{{ unix_rating.id }}' })"
                                    {% endif %}
                                    >
                                    <i class="sicon-format-border-color" aria-hidden="true"></i>
                                    <span class="sr-only">{{ trans('blocks.unix.account.edit_rating') }}</span>
                                </salla-button>
                                <salla-button
                                    loader-position="center"
                                    shape="icon"
                                    {% if not unix_rating.can_update %} disabled {% endif %}
                                    fill="outline"
                                    color="dark"
                                    size="medium"
                                    {% if unix_rating.can_update %}
                                        onclick="salla.event.dispatch('rating::delete', {feedback_id: '{{ unix_rating.id }}' })"
                                    {% endif %}
                                    >
                                    <i class="sicon-trash-2" aria-hidden="true"></i>
                                    <span class="sr-only">{{ trans('blocks.unix.account.delete_rating') }}</span>
                                </salla-button>
                            </div>
                            {% if not unix_rating.can_update %}
                                <p class="unix-order__row-desc">{{ trans('pages.order.edit_period_ended') }}.</p>
                            {% endif %}
                        </div>
                    {% endif %}
                </section>
            {% endif %}
        {% endfor %}

        {% hook 'customer:orders.single.details.end' %}

        {% if order.can_rate or store.settings.rating.allow_update %}
            <salla-rating-modal data-testid="store-order-rating-modal"></salla-rating-modal>
        {% endif %}
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script defer src="{{ 'order.js' | asset }}"></script>
{% endblock %}
