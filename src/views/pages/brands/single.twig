{#
| Variable          | Type                 | Description                                               |
|-------------------|----------------------|-----------------------------------------------------------|
| page              | object               |                                                           |
| page.title        | string               |                                                           |
| page.slug         | string               |                                                           |
| brand             | Brand *              |                                                           |
| brand.id          | int                  |                                                           |
| brand.name        | string               |                                                           |
| brand.url         | string               |                                                           |
| brand.logo        | string               |                                                           |
| brand.banner      | ?string              | Null when is not set, or merchant doesn't want to show it |
| brand.description | string               |                                                           |

UNIX (ROADMAP 5.7 · DS §8.45 · D104): unix.sa has no brand pages; light token restyle only. The brand name
is the page's single h1; its description is body text (Raed had it in an h2).
#}
{% extends "layouts.master" %}
{% block content %}
  <div class="unix-brands">

  {# Brand banner #} 
  {% if brand.banner %} 
        <div class="brand-page__banner">
            <img loading="eager" width="1200" height="300" class="w-full max-h-[300px] object-cover rounded-md bg-gray-100" src="{{ brand.banner }}" alt="{{ brand.name }}"/>
        </div>
    {% endif %}

    <div class="container">
        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        {% hook 'brands:single.details.start' %}
   
        {# brand header #}
        <header class="flex flex-col md:flex-row items-center md:items-start text-center rtl:md:text-right ltr:md:text-left mt-2 mb-12 md:mb-20">
            {# decorative next to the h1 brand name; it is the LCP image when there is no banner #}
            <img class="unix-brands__logo w-40 h-24 object-contain p-4 shrink-0" src="{{ brand.logo }}" width="160" height="96"
                 {% if brand.banner %}loading="lazy"{% else %}loading="eager"{% endif %} alt="">
            <div class="px-5 pt-3 rtl:text-right">
                <h1 class="unix-brands__title">{{ brand.name }}</h1>
                <div class="unix-brands__desc">{{ brand.description|raw }}</div>
            </div>
        </header>

        {% hook 'brands:single.details.end' %}

        <div class="flex items-start flex-col md:flex-row">
            <div class="main-content w-full">
                {% if products|length %}
                    {% hook 'brands:single.items.start' %}
                        <salla-products-list data-testid="store-brand-products" source="{{page.slug}}" source-value="{{page.id}}"></salla-products-list>
                    {% hook 'brands:single.items.end' %}
                {% else %}
                    {# DS §8.47 shared empty state (Tailwind gray icon circle dropped) #}
                    <div class="unix-empty">
                        <span class="unix-empty__icon" aria-hidden="true"><i class="sicon-award-ribbon"></i></span>
                        <h2 class="unix-empty__title">{{ trans('pages.brands.non_products') }} {{ brand.name }}</h2>
                        <a class="unix-btn" href="{{ link('products') }}">{{ trans('blocks.unix.blog.shop') }}</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
  </div>
{% endblock %}
