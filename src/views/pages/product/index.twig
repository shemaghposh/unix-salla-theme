{#
| Variable                   | Type        | Description                                                          |
|----------------------------|-------------|----------------------------------------------------------------------|
| page                       | object      |                                                                      |
| page.title                 | string      | *could be html                                                       |
| page.slug                  | string      | ex: "cat.show"                                                       |
| category                   | ?Category   |                                                                      |
| category.name              | string      |                                                                      |
| category.url               | string      |                                                                      |
| category.sub_categories    | ?Category[] |                                                                      |
| category.image             | ?string     |                                                                      |
| filters                     | bool        | is filters allowed here or not                                        |
| sort_options[]             | SortList[]  |                                                                      |
| sort_options[].id          | string      | ourSuggest, bestSell, topRated, priceFromTopToLow, priceFromLowToTop |
| sort_options[].name        | string      |                                                                      |
| sort_options[].is_selected | bool        | Is current page sorted by it                                         |
| search_query               | ?string     |                                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
	{% if theme.settings.get('product_index_show_breadcrumbs', true) %}
		<div
			class="container container--breadcrumbs">
			{# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
			<nav class="breadcrumbs w-full py-5">
				<salla-breadcrumb></salla-breadcrumb>
			</nav>
		</div>
	{% elseif category is defined and category and category.name|default('') %}
		{# ROADMAP 3.11 · D76: no salla-breadcrumb → no BreadcrumbList from Salla; print ours server-side #}
		{% include 'components.seo.unix-jsonld-breadcrumb' with { crumbs: [{ name: store.name, url: store.url }, { name: category.name, url: category.url }] } %}
	{% endif %}

	{#
		Collection banner (ROADMAP 4.1 · DS §8.29 · SPEC §6), unix.sa sections/main-collection-banner.liquid:
		scheme «Ink», the page's only h1 (category name, else the page title) at h2 size, the category
		description, no image by default. Optional category image (16:9 / 4:5) behind a theme setting.
		Settings: unix_collection_show_description (on) · unix_collection_show_image (off).
	#}
	{% set has_category = category is defined and category and category.name|default('') %}
	{% set banner_desc = '' %}
	{% if has_category and theme.settings.get('unix_collection_show_description', true) %}
		{% set banner_desc = category.description|default('')|trim %}
	{% endif %}
	{% set banner_img = '' %}
	{% if has_category and theme.settings.get('unix_collection_show_image', false) %}
		{% set banner_img = category.image|default('') %}
	{% endif %}
	<section class="unix-plp-banner{{ banner_img ? ' unix-plp-banner--media' : '' }}" aria-labelledby="page-main-title">
		<div class="unix-container unix-plp-banner__inner">
			<div class="unix-plp-banner__text">
				{% if has_category %}
					<h1 class="unix-plp-banner__title unix-size-h2" id="page-main-title">{{ category.name }}</h1>
				{% else %}
					<h1 class="unix-plp-banner__title unix-size-h2" id="page-main-title">{{ page.title|raw }}</h1>
				{% endif %}
				{% if banner_desc %}
					<div class="unix-plp-banner__desc">{{ banner_desc|raw }}</div>
				{% endif %}
			</div>
			{% if banner_img %}
				<div class="unix-plp-banner__media">
					{# The LCP image of the page when shown: eager, high priority, sizes reserved by aspect-ratio #}
					<img class="unix-plp-banner__img"
						 src="{{ banner_img|cdn(1600) }}"
						 srcset="{{ banner_img|cdn(480) }} 480w, {{ banner_img|cdn(768) }} 768w, {{ banner_img|cdn(1080) }} 1080w, {{ banner_img|cdn(1600) }} 1600w, {{ banner_img|cdn(1920) }} 1920w"
						 sizes="(min-width: 1568px) 1440px, 100vw"
						 width="1600" height="900"
						 alt="{{ category.name }}"
						 loading="eager" fetchpriority="high">
				</div>
			{% endif %}
		</div>
	</section>

	{#
    Hook: product.index.before_products_group_with_filter
    Fires before the products grid and filter sidebar wrapper.
    Use this hook to inject content above the products listing area.
  #}
	<div class="s-blocks-wrapper s-before-products-list !mt-0">{% hook 'product.index.before_products_group_with_filter' %}</div>

	<div class="container container--products-list flex items-start flex-col md:flex-row">
		{% if filters %}
			<button class="btn--close-sm close-filters sicon-cancel hidden"></button>
			<salla-filters data-testid="store-products-filters" class="md:w-72 lg:sticky lg:top-20 flex-none" id="filters-menu"></salla-filters>
		{% endif %}

		<div class="main-content flex-1 w-full {{ filters ? 'ltr:lg:ml-8 rtl:lg:mr-8' : '' }}">
			<div class="mb-4 sm:mb-6 flex justify-end items-center">
				<div class="flex items-center space-x-2 rtl:space-x-reverse">
					{% if filters %}
						<a data-testid="store-products-filters-mobile-trigger" href="#filters-menu" class="filters-trigger bg-border-color text-primary lg:hidden mt-2">
							<i class="sicon-filter text-gray-text text-2xl me-2.5"></i>
						</a>
					{% endif %}
					{% if sort_options|length %}
						<div class="flex items-center">
							<label class="hidden sm:block rtl:ml-3 ltr:mr-3 whitespace-nowrap" for="product-filter">{{ trans('pages.categories.sorting') }}</label>
							<select id="product-filter" class="form-input pt-0 pb-1 rtl:md:pl-10 ltr:md:pr-10">
								{% for sort in sort_options %}
									<option value="{{ sort.id }}" {{ sort.is_selected?'selected':'' }}>{{ sort.name }}</option>
								{% endfor %}
							</select>
						</div>
					{% endif %}
				</div>
			</div>

			{% hook 'product:index.items.start' %}

			{# nothing is marked selected when the store default sort is disabled, so send the shown option with the first request #}
			{% set sort_list = sort_options|default([]) %}
			{% set first_sort = sort_list|first %}
			{% set has_selected_sort = sort_list|filter(sort => sort.is_selected)|length %}
			{% set fallback_sort = (sort_list|length and not has_selected_sort and first_sort.id != 'ourSuggest') ? first_sort.id : '' %}

			<div class="flex">
				<salla-products-list data-testid="store-products-list" class="flex-1 min-w-0" source="{{ page.slug }}" source-value="{{ page.id }}" sort-by="{{ fallback_sort }}" {{ filters ?'filters-Results':'' }}></salla-products-list>
			</div>

			{% hook 'product:index.items.end' %}
		</div>
	</div>

	{#
    Hook: product.index.after_products_group_with_filter
    Fires after the products grid and filter sidebar wrapper.
    Use this hook to inject content below the products listing area.
  #}
	<div class="s-blocks-wrapper s-after-products-list">{% hook 'product.index.after_products_group_with_filter' %}</div>

	{% if store.settings.category.testimonial_enabled %}
		{% component 'home.testimonials' %}
	{% endif %}

	{#
    Hook: product.index.after_testimonials
    Fires after the testimonials (store reviews) section.
    Use this hook to inject content below the testimonials area.
  #}
	<div class="s-blocks-wrapper s-after-testimonials">{% hook 'product.index.after_testimonials' %}</div>
{% endblock %}

{% block scripts %}
	<script defer src="{{ 'product.js' | asset }}"></script>
{% endblock %}
