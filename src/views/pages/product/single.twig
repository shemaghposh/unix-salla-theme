{#
| Variable                               | Type                        | Description                                                            |
|----------------------------------------|-----------------------------|------------------------------------------------------------------------|
| page                                   | object                      |                                                                        |
| page.title                             | string                      | *could be html                                                         |
| page.slug                              | string                      | ex: "cat.show"                                                         |
| product                                | Product                     |                                                                        |
| product.id                             | int                         |                                                                        |
| product.name                           | string                      |                                                                        |
| product.description                    | string                      | HTML                                                                   |
| product.url                            | string                      |                                                                        |
| product.promotion_title                | string                      |                                                                        |
| product.subtitle                       | string                      |                                                                        |
| product.type                           | string                      | product, service, group_products, codes, digital, food, donating       |
| product.status                         | string                      | sale, out, out-and-notify                                              |
| product.weight                         | ?string                     |                                                                        |
| product.calories                       | ?float                      |                                                                        |
| product.sku                            | ?string                     |                                                                        |
| product.barcode                        | ?string                     |                                                                        |
| product.shows_sku                      | bool                        | SKU row belongs on the page (selected, and a value exists somewhere)   |
| product.shows_barcode                  | bool                        | Barcode row belongs on the page (selected, and a value exists)         |
| product.rating                         | ?Rating                     |                                                                        |
| product.rating.count                   | int                         |                                                                        |
| product.rating.stars                   | int                         |                                                                        |
| product.price                          | float                       | can be string too `-`, when merchant doesn't want to show zero         |
| product.sale_price                     | float                       |                                                                        |
| product.regular_price                  | float                       |                                                                        |
| product.starting_price                 | ?float                      |                                                                        |
| product.quantity                       | ?int                        | if it's null, means it's unlimited                                     |
| product.sold_quantity                  | int                         |                                                                        |
| product.max_quantity                   | int                         |                                                                        |
| product.discount_ends                  | ?date                       |                                                                        |
| product.is_taxable                     | bool                        | Is the tax included in the price                                       |
| product.category                       | ?Category                   |                                                                        |
| product.category.name                  | string                      |                                                                        |
| product.category.url                   | string                      |                                                                        |
| product.image                          | object                      |                                                                        |
| product.image.url                      | string                      |                                                                        |
| product.image.alt                      | ?string                     |                                                                        |
| product.images                         | array                       |                                                                        |
| product.images[].id                    | int                         |                                                                        |
| product.images[].url                   | string                      |                                                                        |
| product.images[].alt                   | ?string                     |                                                                        |
| product.images[].video_url             | ?string                     |                                                                        |
| product.images[].video_type            | ?string                     | 'video' 'youtube'                                                      |
| product.images[].type                  | string                      | `image` `video`                                                        |
| product.brand                          | ?object                     |                                                                        |
| product.brand.id                       | int                         |                                                                        |
| product.brand.url                      | ?string                     |                                                                        |
| product.brand.name                     | ?string                     |                                                                        |
| product.brand.logo                     | ?string                     |                                                                        |
| product.tags                           | ?Tags[] *Collection         |                                                                        |
| product.tags[].name                    | string                      |                                                                        |
| product.tags[].url                     | string                      |                                                                        |
| product.options                        | ProductOption[] *Collection | @see views/pages/partials/product/options.twig                         |
| product.notify_availability            | ?object                     | does product outOfStock & can visitor subscribe to notify availability |
| product.notify_availability.channels   | array                       | ex: ['sms', 'email']                                                   |
| product.notify_availability.subscribed | bool                        | Does user subscribed before                                            |
| product.donation                       | ?ProductDonation            |                                                                        |
| product.donation.target_message        | ?string                     | Message if reached to target or target expired                         |
| product.donation.collected_amount      | float                       |                                                                        |
| product.donation.target_amount         | float                       |                                                                        |
| product.donation.target_percent        | float                       |                                                                        |
| product.donation.target_end_date       | ?Date                       |                                                                        |
| product.donation.can_donate            | bool                        | `true` When there is no campaign or (target not reached & not expired) |
| product.has_read_more                  | bool                        |                                                                        |
| product.can_add_note                   | bool                        |                                                                        |
| product.can_show_remained_quantity     | bool                        |                                                                        |
| product.can_show_sold                  | bool                        |                                                                        |
| product.can_upload_file                | bool                        |                                                                        |
| product.has_custom_form                | bool                        | Is it for  `Food` or `Custom Service` product                          |
| product.has_metadata                   | bool                        |                                                                        |
| product.has_options                    | bool                        |                                                                        |
| product.is_on_sale                     | bool                        | Product has discounted price                                           |
| product.is_hidden_quantity             | bool                        | The quantity is hidden by merchant, or product not available           |
| product.is_available                   | bool                        |                                                                        |
| product.is_in_wishlist                 | bool                        |                                                                        |
| product.is_out_of_stock                | bool                        |                                                                        |
| product.is_require_shipping            | bool                        |                                                                        |
| product.base_currency_price            | float                       | product.price with base currency (SAR)                                 |
| product.discount_percentage            | ?string                     | ex: "20%"                                                              |
| product.has_3d_image                   | bool                        |                                                                        |
| product.has_size_guide                 | bool                        |                                                                        |
| product.is_giftable                    | bool                        |                                                                        |
| product.add_to_cart_label              | string                      |                                                                        |
| product.currency                       | string                      |                                                                        |
#}
{% extends "layouts.master" %}
{% block content %}
    {#
        ROADMAP 3.10 · DS §8.28 · SPEC §5.2 item 7, §9: colour links (unix.sa's G: Combined Listings).
        Each colour is its own product. Siblings come from the theme setting unix_colour_links
        (multilanguage textarea), one line per colour product: «group key | product URL | colour name | #hex».
        The hex is optional (no hex → text chip). The current product is the line whose URL ends in
        /p{product.id}. Parsed here, not in the include, so the JSON-LD (3.11) can reuse the group key and
        colour name (D72). Twig can't query other products, so the links come from the setting and
        render server-side as real <a href> (crawlable).
        unix_colours = { group: key of the current product's group, name: its colour, items: rows of that group (≥ 2, else []) }
    #}
    {% set unix_colours = { group: '', name: '', items: [] } %}
    {% set cl_raw = theme.settings.get('unix_colour_links') %}
    {% if cl_raw is iterable %}
        {% set cl_lang = cl_raw[language.code] is defined ? cl_raw[language.code]|default('')|trim : '' %}
        {% set cl_raw = cl_lang ?: (cl_raw.ar is defined ? cl_raw.ar|default('') : '') %}
    {% endif %}
    {% if theme.settings.get('unix_colour_links_enabled', true) and cl_raw|default('')|trim %}
        {% set cl_rows = [] %}
        {% for cl_line in cl_raw|replace({"\r": ''})|split("\n") %}
            {% set cl_cells = cl_line|split('|') %}
            {% if cl_cells|length >= 3 %}
                {% set cl_url = cl_cells[1]|trim %}
                {% set cl_hex = cl_cells|length > 3 ? cl_cells[3]|trim|lower : '' %}
                {% set cl_path_end = cl_url|split('#')|first|split('?')|first|trim('/', 'right')|split('/')|last %}
                {% set cl_row = {
                    key: cl_cells[0]|trim|lower,
                    url: cl_url,
                    name: cl_cells[2]|trim,
                    hex: (cl_hex matches '/^#([0-9a-f]{3}|[0-9a-f]{6})$/') ? cl_hex : '',
                    current: cl_path_end == ('p' ~ product.id)
                } %}
                {% if cl_row.key and cl_row.name and (cl_url starts with 'https://' or cl_url starts with 'http://' or cl_url starts with '/') %}
                    {% set cl_rows = cl_rows|merge([cl_row]) %}
                    {% if cl_row.current and not unix_colours.group %}
                        {% set unix_colours = unix_colours|merge({ group: cl_row.key, name: cl_row.name }) %}
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if unix_colours.group %}
            {% set cl_items = [] %}
            {% for cl_row in cl_rows %}
                {% if cl_row.key == unix_colours.group %}
                    {% set cl_items = cl_items|merge([cl_row]) %}
                {% endif %}
            {% endfor %}
            {% set unix_colours = unix_colours|merge({ items: cl_items|length > 1 ? cl_items : [] }) %}
        {% endif %}
    {% endif %}

    {% if theme.settings.get('product_show_breadcrumbs', true) %}
      <div class="container container--breadcrumbs">
          {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
          <nav class="breadcrumbs w-full py-5">
              <salla-breadcrumb></salla-breadcrumb>
          </nav>
      </div>
    {% endif %}

    {#
        Hook: product.single.before_product_info
        Fires before the main product information section (images, title, price, etc.).
        Use this hook to inject custom content or components above the product details area.
    #}
    <div class="s-blocks-wrapper s-before-product-info !mt-0">{% hook 'product.single.before_product_info' %}</div>

    <div class="container container--product-details">
        <div class="flex flex-col items-start md:flex-row" id="product-{{ product.id }}">
            <div class="sidebar unix-pdp-media md:sticky top-24 w-full md:!w-2/4 rtl:ml-8 ltr:mr-8 mb-5 md:mb-0 shrink-0">
                {# ROADMAP 3.1 · DS §8.20: UNIX gallery (replaces Raed's thumbs slider) #}
                {% include 'components.product.unix-gallery' %}
            </div>

            {#
                ROADMAP 3.2 · DS §8.21 · SPEC §5.2: info column in unix.sa block order
                (templates/product.json): title → price → [promo] → installments → options →
                size finder → size charts (3.4) → buy buttons → delivery estimate (3.6) →
                accordions → rating. Removed Raed extras unix.sa doesn't have: brand logo,
                tags, social share, read-more, the second price box (D54).
            #}
            {# plain products get the original's feminine CTA; Salla's own label for preorder/booking/donation/notify (D55) #}
            {% set unix_atc_plain = product.status == 'sale' and product.type not in ['booking', 'donating'] and not product.has_preorder_campaign %}
            {% set unix_atc_label = unix_atc_plain ? trans('blocks.unix.pdp_info.add_to_cart') : product.add_to_cart_label %}

            <div class="main-content unix-pdp-info md:sticky md:overflow-hidden top-24 w-full md:w-2/4">
                {% hook 'product:single.description.start' %}

                {# 1 · Title: h1 tag at product-title size (--t-h3), centred like unix.sa #}
                <div class="unix-pdp-info__head">
                    <h1 data-testid="store-product-title" class="unix-pdp-info__title">{{ product.name }}</h1>

                    {% if product.subtitle %}
                        <p class="unix-pdp-info__subtitle">{{ product.subtitle }}</p>
                    {% endif %}

                    {#
                        2 · Price. One block only: product.js updates .total-price / .before-price
                        and toggles .price_is_on_sale / .starting-or-normal-price with the `hidden`
                        utility, so those wrappers get their display only via :not(.hidden) in SCSS.
                    #}
                    <div data-testid="store-product-price" class="price-wrapper unix-pdp-price">
                        <div class="price_is_on_sale unix-pdp-price__row {{ product.is_on_sale ? '' : 'hidden' }}">
                            <span class="sr-only">{{ trans('blocks.unix.pdp_info.sale_price') }}</span>
                            <span class="total-price unix-pdp-price__now is-sale">{{ product.sale_price|money }}</span>
                            <span class="sr-only">{{ trans('blocks.unix.pdp_info.regular_price') }}</span>
                            <s class="before-price unix-pdp-price__old">{{ product.regular_price|money }}</s>
                            <span class="unix-pdp-price__badge" aria-hidden="true">{{ trans('blocks.unix.pdp_info.on_sale') }}</span>
                        </div>
                        <div class="starting-or-normal-price unix-pdp-price__row {{ product.is_on_sale ? 'hidden' : '' }}">
                            {% if product.starting_price %}
                                <span class="starting-price-title unix-pdp-price__from">{{ trans('pages.products.starting_price') }}</span>
                            {% endif %}
                            <span class="total-price unix-pdp-price__now">{{ product.starting_price ? product.starting_price|money : product.price|money }}</span>
                        </div>
                    </div>
                    <p data-testid="store-product-out-of-stock" class="out-of-stock unix-pdp-price__out hidden" role="status">{{ trans('pages.products.out_of_stock') }}</p>

                    {% if product.is_taxable %}
                        <p class="unix-pdp-info__note">{{ trans('pages.products.tax_included') }}</p>
                    {% endif %}

                    {# Salla merchant toggles (sold / remaining counters): render only when switched on (D54) #}
                    {% if product.sold_quantity or product.can_show_remained_quantity %}
                        <p class="unix-pdp-info__note">
                            {% if product.sold_quantity %}
                                <span>{{ trans('pages.products.sold') }} {{ pluralize('pages.products.sold_times', product.sold_quantity)|raw }}</span>
                            {% endif %}
                            {% if product.can_show_remained_quantity %}
                                <span>{{ trans('pages.products.remained') }} {{ product.quantity }}</span>
                            {% endif %}
                        </p>
                    {% endif %}
                </div>

                {# 3 · Promo-code chip slot (unix.sa unix_promo_code: renders nothing today, SPEC §5.2.4) #}

                {% hook 'product:single.description' %}

                {#
                    4 · Installments (ROADMAP 3.5 · DS §8.22): Salla's native Tamara / Tabby widgets with the
                    store's own keys, where unix.sa renders unix_tamara + Tabby (after price, before options).
                    No Tamara CDN script or public key in the theme; styling in unix-installment.scss.
                #}
                <salla-installment data-testid="store-product-installment" class="unix-pdp-installment" price="{{ product.price }}"></salla-installment>

                {# Digital Files Settings #}
                {% if product.digital_files_settings %}
                    <digital-files-settings settings='{{ product.digital_files_settings|json_encode }}'></digital-files-settings>
                {% endif %}

                <form data-testid="store-product-form" class="form product-form unix-pdp-info__form" enctype="multipart/form-data" method="post"
                      onsubmit="return salla.form.onSubmit('cart.addItem', event)">
                    <input type="hidden" name="id" value="{{ product.id }}">

                    {% hook 'product:single.form.start' %}

                    {# 5a · Colour links to sibling products (ROADMAP 3.10 · DS §8.28): before the size options, like unix.sa #}
                    {% include 'components.product.unix-colour-links' %}
                    {# 5 · Variant picker: button mode like unix.sa picker_type: button (DS §8.21) #}
                    {% include 'pages.partials.product.options' with { unix_option_buttons: true } %}
                    {# 6 · Size finder (ROADMAP 3.3) #}
                    {% include 'components.product.unix-size-finder' %}
                    {# ROADMAP 3.4 · DS §8.23: size charts (Salla size guides) #}
                    {% include 'components.product.unix-size-charts' %}

                    {% hook 'product:single.form.end' %}

                    {# Pre-order Campaign #}
                    {% if product.has_preorder_campaign %}
                        <salla-count-down data-testid="store-product-preorder-countdown" pre-order='{{ product.preorder|json_encode }}' boxed labeled></salla-count-down>
                    {% endif %}

                    {# 7 · Buy buttons: quantity + add to cart (+ wishlist from 640px) in one row, like unix.sa #}
                    <div class="unix-pdp-buy" data-unix-atc-row>
                        {% if product.is_hidden_quantity or product.type == 'booking' %}
                            <input type="hidden" value="1" name="quantity">
                        {% else %}
                            <salla-quantity-input data-testid="store-product-quantity" class="unix-pdp-buy__qty"
                                                  max="{{ product.max_quantity }}" value="1" name="quantity"
                                                  aria-label="{{ trans('pages.products.quantity') }}"></salla-quantity-input>
                        {% endif %}

                        <salla-add-product-button
                                data-testid="store-product-add-to-cart"
                                data-unix-atc
                                {{ product.can_quick_buy ? 'quick-buy' : '' }}
                                {{ product.is_require_shipping ? 'required-shipping' : '' }}
                                {{ product.has_preorder_campaign ? 'has-pre-order' : '' }}
                                amount="{{ product.base_currency_price }}"
                                class="unix-pdp-buy__btn"
                                product-status="{{ product.status }}"
                                product-type="{{ product.type }}"
                                product-id="{{ product.id }}"
                                loader-position="end"
                                type="submit"
                                width="wide"
                                {# Notify availability props #}
                                {% if product.notify_availability %}
                                    {{ product.notify_availability.subscribed ? 'is-subscribed' : '' }}
                                    channels="{{ product.notify_availability.channels|join(',') }}"
                                    subscribed-options="{{ product.notify_availability.subscribed_options|json_encode }}"
                                    {{ product.notify_availability.options ? 'notify-options-availability' : '' }}
                                {% endif %}>{{ unix_atc_label }}</salla-add-product-button>

                        {# below 640px the wishlist button sits on the gallery (DS §8.20) #}
                        <salla-button
                                data-testid="store-product-wishlist-btn"
                                class="btn--wishlist unix-pdp-buy__wish hidden sm:inline-flex"
                                data-id="{{ product.id }}"
                                onclick="salla.wishlist.toggle('{{ product.id }}')"
                                shape="icon"
                                fill="outline"
                                color="light"
                                aria-label="{{ trans('blocks.unix.gallery.wishlist') }}">
                            <i class="sicon-heart" aria-hidden="true"></i>
                        </salla-button>
                    </div>

                    {% if product.is_giftable %}
                        <salla-gifting data-testid="store-product-gifting" widget-subtitle="{{ gifting_intro }}" product-id="{{ product.id }}" {{ product.is_require_shipping ? 'physical-products' : '' }}></salla-gifting>
                    {% endif %}
                </form>

                {# ROADMAP 3.6 · DS §8.24: «متى يصلك طلبك؟» #}
                {% include 'components.product.unix-delivery-estimate' %}

                {#
                    Mobile sticky add-to-cart (DS §8.21): below 576px, visible while the real button
                    is off-screen and the footer isn't; it only clicks the real Salla button
                    (js/partials/unix-sticky-atc.js). Hidden + inert until the JS shows it.
                #}
                {% if theme.settings.get('sticky_add_to_cart', true) and product.status == 'sale' %}
                    <div class="unix-sticky-atc" data-unix-sticky-atc role="region"
                         aria-label="{{ trans('blocks.unix.pdp_info.sticky_label') }}" inert>
                        <button type="button" class="unix-btn unix-btn--block unix-sticky-atc__btn" data-unix-sticky-atc-btn>
                            {{ unix_atc_label }}
                        </button>
                    </div>
                {% endif %}

                {% hook 'product:single.description.end' %}

                {# Salla merchant features kept (render only when enabled, D54) #}
                <salla-quick-order data-testid="store-product-quick-order" class="unix-pdp-info__quick-order"></salla-quick-order>

                {% if product.show_availability %}
                    <button type="button" class="unix-pdp-info__branches"
                            onclick="salla.event.dispatch('scopes::open', {mode: 'availability', product_id: '{{ product.id }}' })">
                        <span>{{ trans('pages.products.availability') }}</span>
                        <span class="unix-pdp-info__branches-cta">
                            {{ trans('pages.products.select_branch') }}
                            <svg class="icon-dir" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"/></svg>
                        </span>
                    </button>
                {% endif %}

                {#
                    8 · Accordions (unix.sa dropdown_information ×3, all closed, one open at a time).
                    Salla has no metafields for «مميزات المنتج» / «تعليمات العناية», so only «الوصف»
                    renders; the merchant's custom fields (salla-metadata) follow it (D56).
                #}
                {% set product_desc = product.description|replace({"&nbsp;": "\n"}) %}
                {% if product_desc|trim %}
                    <div class="unix-pdp-acc">
                        <details class="unix-pdp-acc__item" name="unix-pdp-info">
                            <summary class="unix-pdp-acc__summary">
                                <span class="unix-pdp-acc__title">{{ trans('blocks.unix.pdp_info.description') }}</span>
                                <svg class="unix-pdp-acc__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                                    <path d="M5 12h14"/>
                                    <path class="unix-pdp-acc__icon-v" d="M12 5v14"/>
                                </svg>
                            </summary>
                            <div class="unix-pdp-acc__panel">
                                <div data-testid="store-product-description" class="unix-pdp-acc__body article--main">
                                    {{ product_desc|raw }}
                                </div>
                            </div>
                        </details>
                    </div>
                {% endif %}

                {% if product.has_metadata %}
                    <salla-metadata data-testid="store-product-metadata" class="unix-pdp-info__metadata"></salla-metadata>
                {% endif %}

                {#
                    Identifier rows render only when a value could ever fill them; product.js toggles
                    `hidden` on the wrapper per variant, so the wrapper has no display rule of its own.
                #}
                {% if product.shows_sku %}
                    <div class="product-sku-wrapper {% if not product.sku %}hidden{% endif %}">
                        <p class="unix-pdp-info__note">{{ trans('pages.products.sku') }}: <span class="text-unicode break-all product-sku">{{ product.sku }}</span></p>
                    </div>
                {% endif %}
                {% if product.shows_barcode %}
                    <div class="product-barcode-wrapper {% if not product.barcode %}hidden{% endif %}">
                        <p class="unix-pdp-info__note">{{ trans('pages.products.barcode') }}: <span class="text-unicode break-all product-barcode">{{ product.barcode }}</span></p>
                    </div>
                {% endif %}

                {# 9 · Rating (unix.sa Judge.me preview badge at the bottom of the column) #}
                {% if product.rating %}
                    <salla-rating-stars data-testid="store-product-rating" class="unix-pdp-info__rating"
                                        value="{{ product.rating.stars }}"
                                        reviews="{{ product.rating.count }}"></salla-rating-stars>
                {% endif %}
            </div>
        </div>
        <salla-offer data-testid="store-product-offer"></salla-offer>
    </div>

    {#
        «أكملي الإطلالة» (ROADMAP 3.9 · DS §8.27 · SPEC §5.3, §8.12), unix.sa sections/complete-the-look.liquid.
        Source (D68): theme setting unix_complete_look_data, JSON {"productId": [id, id, ...]} in place of
        the custom.complements metafield. Rendered only when this product's id is a key in it ("id": string check
        here, real parse in js/partials/unix-pdp-related.js, which mounts salla-products-list source "selected",
        limit 2, and hides the section on bad JSON / no products). Cards: custom-salla-product-card with
        an in-flow «أضيفي» button (data-unix-add-label, product-card.js).
    #}
    {% set ctl_data = theme.settings.get('unix_complete_look_data') %}
    {% if ctl_data is iterable %}{% set ctl_data = '' %}{% endif %}
    {% if theme.settings.get('unix_complete_look_enabled', true) and ('"' ~ product.id ~ '":') in ctl_data|default('') %}
        {% set ctl_title = theme.settings.get('unix_complete_look_title') %}
        {% if ctl_title is iterable %}
            {% set ctl_title = ctl_title[language.code] is defined ? ctl_title[language.code] : null %}
        {% endif %}
        {% if not ctl_title|trim %}{% set ctl_title = trans('blocks.unix.complete_look.title') %}{% endif %}
        <section class="unix-ctl unix-products"
                 data-unix-ctl
                 data-product-id="{{ product.id }}"
                 data-limit="2"
                 data-unix-add-label="{{ trans('blocks.unix.complete_look.add')|e('html_attr') }}"
                 aria-labelledby="unix-ctl-title">
            <script type="application/json" data-unix-ctl-config>{{ ctl_data|json_encode|raw }}</script>
            <div class="unix-container">
                <h2 id="unix-ctl-title" class="unix-pdp-heading">{{ ctl_title|trim }}</h2>
                <div class="unix-pdp-body" data-unix-pdp-slot>
                    <div class="unix-products__skeleton unix-pdp-skeleton" aria-hidden="true">
                        {% for n in 1..2 %}
                            <div class="unix-products__skel-card">
                                <span class="unix-products__skel-media"></span>
                                <span class="unix-products__skel-line"></span>
                                <span class="unix-products__skel-line"></span>
                                <span class="unix-products__skel-line unix-products__skel-line--short"></span>
                                <span class="unix-pdp-skel-btn"></span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {#
        Hook: product.single.before_customer_reviews
        Fires before the customer reviews/comments section.
        Use this hook to inject content between the product info and the reviews block.
    #}
    <div class="s-blocks-wrapper s-before-reviews">{% hook 'product.single.before_customer_reviews' %}</div>

    {#
        Reviews (ROADMAP 3.8 · DS §8.26): Salla's own reviews in place of unix.sa's Judge.me widget,
        styled through the public .s-comments-* / .s-rating-stars-* classes (unix-reviews.scss).
        Title: theme setting unix_reviews_title (multilanguage), else the translated default (D67).
    #}
    {% if store.settings.rating.show_on_product %}
        {% set reviews_title = theme.settings.get('unix_reviews_title') %}
        {% if reviews_title is iterable %}
            {% set reviews_title = reviews_title[language.code] is defined ? reviews_title[language.code] : null %}
        {% endif %}
        {% if not reviews_title|trim %}{% set reviews_title = trans('blocks.unix.reviews.title') %}{% endif %}
        <salla-comments data-testid="store-product-comments" item-id="{{product.id}}" type="product"
                        block-title="{{ reviews_title|trim|e('html_attr') }}"></salla-comments>
    {% endif %}

    {#
        Hook: product.single.before_product_recommendations
        Fires before the similar/related products slider.
        Use this hook to inject content between the reviews and the recommendations section.
    #}
    <div class="s-blocks-wrapper s-before-related">{% hook 'product.single.before_product_recommendations' %}</div>

    {#
        «قد يعجبك أيضًا» (ROADMAP 3.9 · DS §8.27 · SPEC §5.3), unix.sa sections/product-recommendations.liquid:
        Cream scheme, 4 products, grid (2 columns → 4 from lg), no carousel, «عرض الكل» → all products.
        Source (D69): Salla's related products (salla-products-list source "related"). The section hides
        when Salla returns none or the store turned related products off (js/partials/unix-pdp-related.js).
        Settings: unix_recommendations_enabled / _title / _button_label / _button_link (empty → link('products')).
    #}
    {% if theme.settings.get('unix_recommendations_enabled', true) %}
        {% set recs_title = theme.settings.get('unix_recommendations_title') %}
        {% if recs_title is iterable %}
            {% set recs_title = recs_title[language.code] is defined ? recs_title[language.code] : null %}
        {% endif %}
        {% if not recs_title|trim %}{% set recs_title = trans('blocks.unix.recommendations.title') %}{% endif %}
        {% set recs_label = theme.settings.get('unix_recommendations_button_label') %}
        {% if recs_label is iterable %}
            {% set recs_label = recs_label[language.code] is defined ? recs_label[language.code] : null %}
        {% endif %}
        {% if not recs_label|trim %}{% set recs_label = trans('blocks.unix.recommendations.view_all') %}{% endif %}
        {% set recs_url = theme.settings.get('unix_recommendations_button_link') %}
        {% if recs_url is iterable %}{% set recs_url = recs_url.url|default('') %}{% endif %}
        {% set recs_url = recs_url|default('')|trim ?: link('products') %}
        <section class="unix-recs unix-products"
                 data-unix-recs
                 data-testid="store-product-related"
                 aria-labelledby="unix-recs-title">
            <div class="unix-container unix-recs__inner">
                <h2 id="unix-recs-title" class="unix-pdp-heading unix-recs__title">{{ recs_title|trim }}</h2>
                <div class="unix-recs__cta">
                    <a class="unix-btn" href="{{ recs_url }}">{{ recs_label|trim }}</a>
                </div>
                <div class="unix-pdp-body unix-recs__body">
                    <div class="unix-products__skeleton unix-pdp-skeleton" aria-hidden="true">
                        {% for n in 1..4 %}
                            <div class="unix-products__skel-card">
                                <span class="unix-products__skel-media"></span>
                                <span class="unix-products__skel-line"></span>
                                <span class="unix-products__skel-line"></span>
                                <span class="unix-products__skel-line unix-products__skel-line--short"></span>
                            </div>
                        {% endfor %}
                    </div>
                    <salla-products-list class="unix-pdp-list"
                                         source="related"
                                         source-value="{{ product.id }}"
                                         limit="4"
                                         includes='["images"]'></salla-products-list>
                </div>
            </div>
        </section>
    {% endif %}

    {#
        Hook: product.single.after_product_recommendations
        Fires after the similar/related products slider, at the very end of the product page content.
        Use this hook to append content below the recommendations section.
    #}
    <div class="s-blocks-wrapper s-after-related">{% hook 'product.single.after_product_recommendations' %}</div>
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'product.js' | asset }}"></script>
    {% if product.has_3d_image %}
        <script type="module" defer src="https://unpkg.com/@google/model-viewer/dist/model-viewer.min.js"></script>
    {% endif %}
    {% if product.digital_files_settings %}
        <script type="module" defer src="{{ 'digital-files.js'|asset }}"></script>
    {% endif %}
{% endblock %}