{#
UNIX (ROADMAP 5.7 · DS §8.45 · D104): unix.sa has no testimonials page (reviews live on the product page, 3.8).
Salla's store testimonials page stays reachable with a light token restyle only (.unix-testimonials in
unix-legacy-pages.scss; the review cards already follow DS §8.26). The page title is the single h1.
#}
{% extends "layouts.master" %}
{% block content %}
<div class="unix-container unix-testimonials">

    {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
    <nav class="breadcrumbs w-full py-5">
        <salla-breadcrumb></salla-breadcrumb>
    </nav>

    <div class="unix-testimonials__head">
        <h1 class="unix-testimonials__title">{{ page.title }}</h1>
        <div class="unix-testimonials__sort">
            <label class="unix-testimonials__label" for="testimonials-filter">{{ trans('pages.categories.sorting') }}</label>
            <select id="testimonials-filter" class="form-input">
                <option value="latest">{{ trans('pages.testimonials.sort_by_date_desc') }}</option>
                <option value="oldest">{{ trans('pages.testimonials.sort_by_date_asc') }}</option>
                <option value="top_rating">{{ trans('pages.testimonials.sort_by_rating_desc') }}</option>
                <option value="bottom_rating">{{ trans('pages.testimonials.sort_by_rating_asc') }}</option>
            </select>
        </div>
    </div>

    <salla-comments data-testid="store-testimonials-comments" testimonials></salla-comments>
</div>
{% endblock %}

{% block scripts %}
<script defer src="{{ 'testimonials.js' | asset }}"></script>
{% endblock %}
