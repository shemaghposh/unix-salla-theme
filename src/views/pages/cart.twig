{#
| Variable                                          | Type                | Description                                                    |
|---------------------------------------------------|---------------------|----------------------------------------------------------------|
| page                                              | object              |                                                                |
| page.title                                        | string              |                                                                |
| page.slug                                         | string              |                                                                |
| cart                                              | Cart                |                                                                |
| cart.id                                           | string              | Unique string for current cart                                 |
| cart.is_require_shipping                          | bool                | Does one of cart items require shipping?                       |
| cart.has_shipping                                 | bool                | Does shipping company selected?                                |
| cart.real_shipping_cost                           | float               | Shipping cost can become free by an offer, coupon              |
| cart.sub_total                                    | float               | The sum of items price without shipping or other costs         |
| cart.discount                                     | float               | final discount                                                 |
| cart.coupon                                       | ?string             |                                                                |
| cart.total                                        | float               |                                                                |
| cart.tax_amount                                   | float               | Calculate Tax amount                                                               |
| cart.free_shipping_bar                            | ?object             |                                                                |
| cart.free_shipping_bar.minimum_amount             | float               | how much cart total should be to apply free shipping ex: 1000  |
| cart.free_shipping_bar.has_free_shipping          | bool                | true when `cart.free_shipping_bar.percent==100`                |
| cart.free_shipping_bar.percent                    | float               | `0 - 100`                                                      |
| cart.free_shipping_bar.remaining                  | float               | `830`                                                          |
| cart.items                                        | CartItem[]          |                                                                |
| cart.options                                      | CartOptions[]       | array of options                                               |
| cart.items[].id                                   | int                 |                                                                |
| cart.items[].is_hidden_quantity                   | bool                |                                                                |
| cart.items[].url                                  | string              | Product url                                                    |
| cart.items[].quantity                             | int                 |                                                                |
| cart.items[].type                                 | string              | product type                                                   |
| cart.items[].product_price                        | MoneyTaxable        |                                                                |
| cart.items[].price                                | Money\|MoneyTaxable |                                                                |
| cart.items[].total                                | Money               |                                                                |
| cart.items[].product_id                           | int                 |                                                                |
| cart.items[].notes                                | string              |                                                                |
| cart.items[].can_add_note                         | bool                |                                                                |
| cart.items[].can_upload_file                      | bool                |                                                                |
| cart.items[].is_available                         | bool                |                                                                |
| cart.items[].offer                                | ?object             |                                                                |
| cart.items[].offer.discount                       | float               |                                                                |
| cart.items[].offer.is_free                        | bool                |                                                                |
| cart.items[].offer.names                          | ?string             | ex: `Buy 3 and the 4th on us, National Day`                    |
| cart.items[].donation                             | ?object             |                                                                |
| cart.items[].attachments                          | ?array              |                                                                |
| cart.items[].attachments[].id                     | int                 | image id, to be attache with the formData                      |
| cart.items[].attachments[].url                    | string              | image url                                                      |
| cart.items[].attachments[].product_id             | int                 |                                                                |
| cart.items[].attachments[].item_id                | int                 |                                                                |
| cart.items[].attachments[].name                   | int                 | image file name                                                |

UNIX cart page (ROADMAP 4.4 · DS §8.35 · SPEC §7.2), unix.sa templates/cart.json order:
  1. items + summary (Salla's cart components, styled to the system)
  2. cashback note (3.7, after the summary card; D66)
  3. «اختيارات تناسبك» product carousel (Cream, 4 per row; D90)
JS hooks kept for src/assets/js/cart.js: #item-{id} forms, .item-* price spans, .free-ribbon, .old-offers,
.offer-name, .offer-icon, .cart-options, #cart-gifting / #salla-gifting.
#}

{% extends "layouts.master" %}
{% block content %}
    {% set lang = language.code|default('ar') %}
    <div class="unix-container unix-cart">
        {# add breadcumbs container in pages to make a space in case breadcrumbs is off #}
        <nav class="breadcrumbs w-full py-5">
            <salla-breadcrumb></salla-breadcrumb>
        </nav>
        <h1 class="sr-only">{{ trans('blocks.header.cart') }}</h1>
        <salla-conditional-offer data-testid="store-cart-conditional-offer"></salla-conditional-offer>
        <div class="unix-cart__layout">
            <div class="main-content unix-cart__main">
                {% hook 'cart:items.start' %}

                {% for item in cart.items %}
                    <form onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ item.id }}">
                        <section data-testid="store-cart-item-{{ item.id }}" class="cart-item unix-cart-item">
                            <input type="hidden" name="id" value="{{ item.id }}">
                            <div class="unix-cart-item__row">
                                {# The name link below is the accessible link; the image repeats it for pointer users only #}
                                <a href="{{ item.url }}" class="unix-cart-item__media" tabindex="-1" aria-hidden="true">
                                    <img src="{{ item.product_image }}" alt="" width="120" height="160"
                                         loading="{{ loop.first ? 'eager' : 'lazy' }}" decoding="async"
                                         class="unix-cart-item__img">
                                    <!-- free product badge -->
                                    <span class="free-ribbon unix-cart-item__badge {{ (item.price.getMoney().amount == 0 and item.has_discount) ? '' : 'hidden' }}">
                                        {{ trans('pages.loyalty_program.free_product') }}
                                    </span>
                                </a>

                                <div class="unix-cart-item__details">
                                    {# ROADMAP 3.11: one h1 per page (the sr-only «السلة» above); 4.4: items are h2 at the card-name size (DS §8.35) #}
                                    <h2 class="unix-cart-item__name">
                                        <a href="{{ item.url }}">{{ item.product_name }}</a>
                                    </h2>

                                    <p class="unix-cart-item__prices">
                                        <span class="item-regular-price unix-cart-item__price-old {{ item.offer ? '' : 'hidden' }}">{{ item.product_price|money }}</span>
                                        <span class="item-original-price unix-cart-item__price-old {{ item.is_on_sale ? '' : 'hidden' }}" id="original_price">{{ item.original_price|money }}</span>
                                        <span data-testid="store-cart-item-price" class="item-price unix-cart-item__price {{ item.has_discount ? 'is-sale' : 'is-regular' }}" id="has_discount">{{ item.price|money }}</span>
                                    </p>

                                    <p class="item-weight-row unix-cart-item__meta {{ item.weight_label ? '' : 'hidden' }}">{{ trans('pages.products.weight') }}
                                        <span class="item-weight">{{ item.weight_label }}</span>
                                    </p>
                                    <span class="old-offers unix-cart-item__offer {{ item.detailed_offers ? 'hidden' : '' }}">
                                        <i class="sicon-discount-calculator offer-icon {{ item.offer ? '' : 'hidden' }}" aria-hidden="true"></i>
                                        <span class="offer-name {{ item.offer ? '' : 'hidden' }}">{{ item.offer.names }}</span>
                                    </span>
                                    {# Cart Item Offers #}
                                    <salla-cart-item-offers
                                        quantity="{{ item.quantity }}"
                                        item-id="{{ item.id }}"
                                        product-price="{{ item.product_price }}"
                                        offers="{{ item.detailed_offers|json_encode }}"></salla-cart-item-offers>
                                    {# End Cart Item offers #}
                                </div>

                                <div class="unix-cart-item__aside">
                                    {% if item.type == 'donating' %}
                                        <span></span>
                                    {% elseif item.is_hidden_quantity %}
                                        <input type="hidden" value="{{ item.quantity }}" name="quantity" aria-label="{{ trans('blocks.unix.cart.quantity', {'name': item.product_name}) }}"/>
                                        <span class="unix-cart-item__qty-text">{{ item.quantity }}</span>
                                    {% else %}
                                        <salla-quantity-input cart-item-id="{{ item.id }}" max="{{ item.max_quantity }}"
                                            class="unix-cart-item__qty"
                                            aria-label="{{ trans('blocks.unix.cart.quantity', {'name': item.product_name}) }}"
                                            value="{{ item.quantity }}" name="quantity">
                                        </salla-quantity-input>
                                    {% endif %}
                                    {% set item_total = item.detailed_offers|length > 0 ? item.total_special_price|money : item.total|money %}
                                    <p class="unix-cart-item__total">
                                        <span class="unix-cart-item__total-label">{{ trans('pages.cart.total') }}:</span>
                                        <span data-testid="store-cart-item-total" class="item-total">{{ item.is_available ? item_total : trans('pages.cart.out_of_stock') }}</span>
                                    </p>
                                </div>

                                <button type="button" class="unix-cart-item__remove" data-testid="store-cart-delete-item"
                                        data-unix-cart-remove="{{ item.id }}"
                                        aria-label="{{ trans('blocks.unix.cart.remove', {'name': item.product_name}) }}">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>

                            {% include 'pages.partials.product.options' with {product:item} %}
                        </section>
                    </form>
                {% else %}
                    {# unix.sa main-cart-items empty state: «سلتك فارغة» + the empty text + «تسوقي الآن» #}
                    {% set empty_text = theme.settings.get('unix_cart_empty_text') %}
                    {% if empty_text is iterable %}{% set empty_text = empty_text[lang] is defined ? empty_text[lang] : null %}{% endif %}
                    {% if empty_text is null or not empty_text|trim %}{% set empty_text = trans('blocks.unix.cart_drawer.empty_text') %}{% endif %}
                    <div data-testid="store-cart-empty" class="unix-cart__empty">
                        <h2 class="unix-cart__empty-heading">{{ trans('blocks.unix.cart.empty') }}</h2>
                        <p class="unix-cart__empty-text">{{ empty_text|trim }}</p>
                        <a data-testid="store-cart-back-home" href="{{ link('products') }}" class="unix-btn">{{ trans('blocks.unix.cart_drawer.shop_now') }}</a>
                    </div>
                {% endfor %}

                {% if cart.options|length %}
                  <div class="cart-options unix-cart__options">
                    {% for product_option in cart.options %}
                      <form class="first:pt-5 relative" onchange="salla.form.onChange('cart.updateItem', event)" id="item-{{ product_option.id }}">
                        <input type="hidden" name="id" value="{{ product_option.id }}">
                        <input type="hidden" name="quantity" value="{{ product_option.quantity }}">
                        {% include 'pages.partials.product.options' with { product: product_option } %}
                      </form>
                    {% endfor %}
                  </div>
                {% endif %}

                <salla-offer data-testid="store-cart-offer"></salla-offer>

                {% hook 'cart:items.end' %}
            </div>

            {% hook 'cart:summary.start' %}

            <!-- sidebar -->
            {% if cart.items|length %}
                <div class="unix-cart__aside">
                    {# ROADMAP 4.3/4.4: the same free-shipping bar as the drawer (DS §8.34, D88), first paint from Twig #}
                    {% if theme.settings.get('unix_cart_free_shipping', true) %}
                        <div class="unix-cart__panel unix-cart__fs">
                            {% include 'components.cart.unix-free-shipping' with { fs_cart: cart } %}
                        </div>
                    {% endif %}
                    {% if loyalty %}
                        <salla-loyalty-panel
                            data-testid="store-cart-loyalty"
                            prize-points='{{ loyalty.prize.points }}'
                            prize-title='{{ loyalty.prize.title }}'>
                        </salla-loyalty-panel>
                    {% endif %}

                    <div id="cart-gifting" class="unix-cart__panel unix-cart__gifting {{gift.enabled ? '' : 'hidden' }}">
                        <salla-gifting data-testid="store-cart-gifting" id="salla-gifting" widget-title="{{ trans("pages.cart.gift_widget_title") }}"  widget-subtitle="{{ gift.text }}" {{gift.type}}-products  vertical></salla-gifting>
                    </div>

                    {% if store.settings.cart.apply_coupon_enabled %}
                        <div class="unix-cart__panel unix-cart__coupons">
                            {% hook 'cart:coupon.start' %}
                            <salla-cart-coupons data-testid="store-cart-coupons"></salla-cart-coupons>
                            {% hook 'cart:coupon.end' %}
                        </div>
                    {% endif %}

                    {% hook 'cart:summary-card.start' %}
                    <salla-cart-summary-card data-testid="store-cart-summary"></salla-cart-summary-card>
                    {% hook 'cart:summary-card.end' %}
                    {# ROADMAP 3.7: unix.sa cashback note, after the subtotal + checkout (SPEC §7.2 cashback-note-section) #}
                    {% include 'components.cart.unix-cashback-note' %}
                    {% hook 'cart:summary.end' %}

                     <!-- Tiered Offer Component -->
                    <salla-tiered-offer data-testid="store-cart-tiered-offer"></salla-tiered-offer>
                </div>
            {% endif %}
        </div>
    </div>

    {#
      «اختيارات تناسبك» (unix.sa popular-products on templates/cart.json; ROADMAP 4.4 · DS §8.35 · D90).
      Same markup and JS as the 2.3 products section (one panel, no tabs): heading row with arrows and
      the button from 576px, full-width button under the slider below that.
    #}
    {% if theme.settings.get('unix_cart_picks_enabled', true) %}
        {% set picks_title = theme.settings.get('unix_cart_picks_title') %}
        {% if picks_title is iterable %}{% set picks_title = picks_title[lang] is defined ? picks_title[lang] : null %}{% endif %}
        {% if not picks_title|trim %}{% set picks_title = trans('blocks.unix.cart.picks_title') %}{% endif %}

        {% set picks_label = theme.settings.get('unix_cart_picks_button_label') %}
        {% if picks_label is iterable %}{% set picks_label = picks_label[lang] is defined ? picks_label[lang] : null %}{% endif %}
        {% if not picks_label|trim %}{% set picks_label = trans('blocks.unix.cart.picks_button') %}{% endif %}

        {% set picks_url = theme.settings.get('unix_cart_picks_button_link') %}
        {% if picks_url is iterable %}{% set picks_url = picks_url.url|default('') %}{% endif %}
        {% set picks_url = picks_url|default('')|trim ?: link('products') %}

        {# Salla may hand the picker back as objects, {value,label} rows or bare ids #}
        {% set picks_ids = [] %}
        {% for p in theme.settings.get('unix_cart_picks_products')|default([]) %}
            {% set pid = p.id is defined ? p.id : (p.value is defined ? p.value : p) %}
            {% if pid and pid is not iterable %}{% set picks_ids = picks_ids|merge([pid]) %}{% endif %}
        {% endfor %}

        {# Swiper needs px numbers: these MIRROR --gutter (DS §3.3), same config as 2.3 #}
        {% set picks_config = '{"slidesPerView":2,"spaceBetween":12,"breakpoints":{"576":{"slidesPerView":2,"spaceBetween":16},"768":{"slidesPerView":3,"spaceBetween":20},"1024":{"slidesPerView":4,"spaceBetween":24},"1440":{"slidesPerView":4,"spaceBetween":32}}}' %}

        <section class="unix-ptabs unix-products unix-cart-picks" data-unix-ptabs data-testid="store-cart-picks" aria-labelledby="unix-cart-picks-title">
            <div class="unix-container unix-ptabs__inner">
                <h2 id="unix-cart-picks-title" class="unix-ptabs__title unix-cart-picks__title">{{ picks_title|trim }}</h2>

                <div class="unix-ptabs__nav">
                    <button type="button" class="unix-carousel-arrow" data-unix-ptabs-prev
                            aria-controls="unix-cart-picks-panels" aria-label="{{ trans('blocks.unix.products_tabs.prev') }}">
                        <svg class="icon-dir" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button type="button" class="unix-carousel-arrow" data-unix-ptabs-next
                            aria-controls="unix-cart-picks-panels" aria-label="{{ trans('blocks.unix.products_tabs.next') }}">
                        <svg class="icon-dir" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>

                <div class="unix-ptabs__panels" id="unix-cart-picks-panels">
                    <div class="unix-ptabs__panel">
                        <div class="unix-products__skeleton" aria-hidden="true">
                            {% for n in 1..4 %}
                                <div class="unix-products__skel-card">
                                    <span class="unix-products__skel-media"></span>
                                    <span class="unix-products__skel-line"></span>
                                    <span class="unix-products__skel-line"></span>
                                    <span class="unix-products__skel-line unix-products__skel-line--short"></span>
                                </div>
                            {% endfor %}
                        </div>
                        <salla-products-slider
                            class="unix-ptabs__slider"
                            {% if picks_ids|length %}
                                source="selected" source-value="{{ picks_ids|json_encode }}" limit="{{ picks_ids|length }}"
                            {% else %}
                                source="latest" limit="8"
                            {% endif %}
                            slider-id="unix-cart-picks-slider"
                            includes='["images"]'
                            slider-config='{{ picks_config|raw }}'></salla-products-slider>
                    </div>
                </div>

                <div class="unix-ptabs__cta">
                    <a class="unix-btn" data-unix-ptabs-cta href="{{ picks_url }}">{{ picks_label|trim }}</a>
                </div>
            </div>
        </section>
    {% endif %}
{% endblock %}

{% block scripts %}
    <script defer src="{{ 'checkout.js' | asset }}"></script>
{% endblock %}
