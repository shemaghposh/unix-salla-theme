{#
  Product structured data (ROADMAP 3.11 · DS §14 · D74, D76), included from pages/product/single.twig.
  unix.sa: sections/main-product.liquid → {{ product | structured_data }}.
  Salla's web components don't emit a Product schema for the product page, and we can't see whether
  {% hook head %} does, so ours sits behind unix_seo_jsonld_product (default on): check the rendered
  source and turn it off if Salla already prints one.

  Product: name, url, description (plain text), images, sku, gtin (barcode of 8, 12, 13 or 14 digits),
  brand (product brand, else unix_seo_brand_name, else store name), category, color (3.10), offers
  (price as shown, currency, availability, condition, seller → the site Organization @id when that
  JSON-LD is on, strikethrough price and priceValidUntil when on sale) and aggregateRating only when
  there are reviews.
  Colours as separate pages (3.10, D72), only with 2+ colours: inProductGroupWithID + isVariantOf →
  ProductGroup with productGroupID = the unix_colour_links group key, variesBy color, and
  hasVariant = { @type Product, @id, url } for every colour page (absolute URLs).
  Sets are ordinary products here (one price for the set).
  Expects `product` and `unix_colours` (single.twig). |json_encode escapes "/" so nothing can close the <script>.
#}
{% if theme.settings.get('unix_seo_jsonld_product', true) %}
  {% set seo_brand = product.brand.name|default('')|trim %}
  {% if not seo_brand %}{% set seo_brand = theme.settings.get('unix_seo_brand_name')|default('')|trim %}{% endif %}
  {% if not seo_brand %}{% set seo_brand = store.name %}{% endif %}
  {% set seo_brand_obj = { '@type': 'Brand', 'name': seo_brand } %}

  {% set seo_images = [] %}
  {% for seo_img in product.images|default([]) %}
    {% if (seo_img.type is not defined or seo_img.type == 'image') and seo_img.url|default('') %}
      {% set seo_images = seo_images|merge([seo_img.url]) %}
    {% endif %}
  {% endfor %}
  {% if not seo_images|length and product.image.url|default('') %}
    {% set seo_images = [product.image.url] %}
  {% endif %}

  {% set seo_desc = product.description|default('')|striptags|replace({
    '&nbsp;': ' ', '&amp;': '&', '&quot;': '"', '&#39;': "'", '&#039;': "'", '&#x27;': "'",
    '&lt;': '<', '&gt;': '>', '&hellip;': '…', '&rlm;': '', '&lrm;': '', '&ndash;': '–', '&mdash;': '—'
  })|trim|slice(0, 5000) %}
  {% if not seo_desc %}{% set seo_desc = product.subtitle|default(product.name) %}{% endif %}

  {% set seo_product = {
    '@type': 'Product',
    '@id': product.url,
    'url': product.url,
    'name': product.name,
    'description': seo_desc,
    'brand': seo_brand_obj
  } %}
  {% if seo_images|length %}{% set seo_product = seo_product|merge({ 'image': seo_images }) %}{% endif %}
  {% if product.sku %}{% set seo_product = seo_product|merge({ 'sku': product.sku ~ '' }) %}{% endif %}
  {% if product.barcode and (product.barcode ~ '') matches '/^([0-9]{8}|[0-9]{12,14})$/' %}
    {% set seo_product = seo_product|merge({ 'gtin': product.barcode ~ '' }) %}
  {% endif %}
  {% if product.category and product.category.name|default('') %}
    {% set seo_product = seo_product|merge({ 'category': product.category.name }) %}
  {% endif %}
  {% if unix_colours is defined and unix_colours.name %}
    {% set seo_product = seo_product|merge({ 'color': unix_colours.name }) %}
  {% endif %}

  {#
    Offer: the price shown on the page (single.twig price block: sale price when on sale, else
    «starting from» or the price), only when it's a real number (Salla can send "-" for hidden zero prices).
  #}
  {% set seo_price = product.is_on_sale ? product.sale_price : (product.starting_price ?: product.price) %}
  {% set seo_home = store.url|default('')|trim('/', 'right') %}
  {% if theme.settings.get('unix_seo_jsonld_site', true) %}
    {% set seo_seller = { '@id': seo_home ~ '/#organization' } %}
  {% else %}
    {% set seo_seller = { '@type': 'Organization', 'name': store.name } %}
  {% endif %}
  {% if (seo_price ~ '') matches '/^[0-9]+([.][0-9]+)?$/' %}
    {% set seo_currency = product.currency|default('SAR') %}
    {% if product.is_out_of_stock or not product.is_available %}
      {% set seo_avail = 'https://schema.org/OutOfStock' %}
    {% elseif product.has_preorder_campaign %}
      {% set seo_avail = 'https://schema.org/PreOrder' %}
    {% else %}
      {% set seo_avail = 'https://schema.org/InStock' %}
    {% endif %}
    {% set seo_offer = {
      '@type': 'Offer',
      'url': product.url,
      'price': seo_price,
      'priceCurrency': seo_currency,
      'availability': seo_avail,
      'itemCondition': 'https://schema.org/NewCondition',
      'seller': seo_seller
    } %}
    {#
      6.8: Twig's |date throws on a string it can't parse, and Raed never reads discount_ends, so its
      shape is unverified. Only a date object, a Unix timestamp or a YYYY-MM-DD… string reaches |date;
      anything else just drops priceValidUntil (optional for Google).
    #}
    {% set seo_ends = product.is_on_sale ? product.discount_ends : null %}
    {% if seo_ends and (seo_ends.timestamp is defined or (seo_ends is not iterable and (seo_ends ~ '') matches '/^([0-9]{4}-[0-9]{2}-[0-9]{2}|[0-9]{9,11}$)/')) %}
      {% set seo_offer = seo_offer|merge({ 'priceValidUntil': seo_ends|date('Y-m-d') }) %}
    {% endif %}
    {% if product.is_on_sale and (product.regular_price ~ '') matches '/^[0-9]+([.][0-9]+)?$/' %}
      {% set seo_offer = seo_offer|merge({ 'priceSpecification': {
        '@type': 'UnitPriceSpecification',
        'priceType': 'https://schema.org/StrikethroughPrice',
        'price': product.regular_price,
        'priceCurrency': seo_currency
      } }) %}
    {% endif %}
    {% set seo_product = seo_product|merge({ 'offers': seo_offer }) %}
  {% endif %}

  {% if product.rating and product.rating.count|default(0) > 0 and product.rating.stars|default(0) > 0 %}
    {% set seo_product = seo_product|merge({ 'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': product.rating.stars,
      'reviewCount': product.rating.count,
      'bestRating': 5,
      'worstRating': 1
    } }) %}
  {% endif %}

  {# Colour pages of one model (3.10): «اسم الموديل | اللون» → the model name is the part before «|» #}
  {# Only with 2+ colours (unix_colours.items is [] otherwise); item URLs are absolute (single.twig) #}
  {% if unix_colours is defined and unix_colours.group and unix_colours.items|length > 1 %}
    {% set seo_variants = [] %}
    {% for seo_item in unix_colours.items %}
      {% set seo_variant_url = seo_item.current ? product.url : seo_item.url %}
      {% set seo_variants = seo_variants|merge([{ '@type': 'Product', '@id': seo_variant_url, 'url': seo_variant_url }]) %}
    {% endfor %}
    {% set seo_product = seo_product|merge({ 'inProductGroupWithID': unix_colours.group }) %}
    {% set seo_group = {
      '@type': 'ProductGroup',
      '@id': seo_home ~ '/#product-group-' ~ unix_colours.group,
      'productGroupID': unix_colours.group,
      'name': product.name|split('|')|first|trim,
      'brand': seo_brand_obj,
      'variesBy': ['https://schema.org/color']
    } %}
    {% set seo_group = seo_group|merge({ 'hasVariant': seo_variants }) %}
    {% set seo_product = seo_product|merge({ 'isVariantOf': seo_group }) %}
  {% endif %}

  <script type="application/ld+json">{{ { '@context': 'https://schema.org' }|merge(seo_product)|json_encode|raw }}</script>
{% endif %}
