{#
  WebSite structured data, home page only (ROADMAP 3.11 / 5.4 · DS §14 · D74, amended by D129).
  6.4 batch 3 (D129): Salla's own head output is the source of truth for structured data. On every page it
  already prints Organization and WebPage (measured on the preview), so the theme no longer prints its own
  Organization (or the unix_seo_jsonld_site toggle). Salla prints no WebSite, so this one stays:
    WebSite: name + url + language + SearchAction on Salla's search page (/search?q=…). No publisher reference:
             the theme's Organization @id is gone, and Salla's Organization has no @id to point at.
  Server-rendered; |json_encode escapes "/" so no value can close the <script>.
  Title/meta/canonical/hreflang/OG stay with Salla's {% hook head %}.
#}
{% if is_page('index') %}
  {% set seo_home = store.url|default('')|trim %}
  {% set seo_site = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': seo_home|trim('/', 'right') ~ '/#website',
    'name': store.name,
    'url': seo_home,
    'inLanguage': language.code,
    'potentialAction': {
      '@type': 'SearchAction',
      'target': {
        '@type': 'EntryPoint',
        'urlTemplate': seo_home|trim('/', 'right') ~ '/search?q={search_term_string}'
      },
      'query-input': 'required name=search_term_string'
    }
  } %}
  <script type="application/ld+json">{{ seo_site|json_encode|raw }}</script>
{% endif %}
