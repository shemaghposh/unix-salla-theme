{#
  UNIX footer + trust strip (ROADMAP 1.4 · DS §8.8 · SPEC §3).
  Desktop: 4 columns — brand & newsletter · shop · help · contact. Mobile: the link columns are
  accordions (src/assets/js/partials/unix-footer.js opens them from lg up).
  Trust strip: phone, WhatsApp, Instagram, TikTok tiles · commercial registration, trademark and VAT ·
  Salla trust badges · grayscale payment marks (salla-payments) · copyright hook.
  Merchant settings (twilight.json): unix_footer_newsletter_title, unix_contact_phone, unix_contact_whatsapp,
  unix_social_instagram, unix_social_tiktok, unix_cr_number, unix_cr_badge, unix_tm_number.
#}
{% set newsletter_title = theme.settings.get('unix_footer_newsletter_title') %}
{% if newsletter_title is iterable %}
  {% set newsletter_title = newsletter_title[language.code]|default('') %}
{% endif %}

{# Contact & social: settings first, then the store's own contact details from the dashboard. #}
{% set phone = theme.settings.get('unix_contact_phone')|default(store.contacts.phone|default(store.contacts.mobile))|trim %}
{% set whatsapp = theme.settings.get('unix_contact_whatsapp')|default(store.contacts.whatsapp|default(store.social.whatsapp))|trim %}
{% set instagram = theme.settings.get('unix_social_instagram')|default(store.social.instagram)|trim %}
{% set tiktok = theme.settings.get('unix_social_tiktok')|default(store.social.tiktok)|trim %}
{% set whatsapp_url = whatsapp starts with 'http' ? whatsapp : 'https://wa.me/' ~ whatsapp|replace({'+': '', ' ': '', '-': ''}) %}
{# Accept a bare handle ("unix_theclub" or "@unix_theclub") as well as a full URL. #}
{% set instagram_url = instagram starts with 'http' ? instagram : 'https://instagram.com/' ~ instagram|trim('@', 'left') %}
{% set tiktok_url = tiktok starts with 'http' ? tiktok : 'https://www.tiktok.com/@' ~ tiktok|trim('@', 'left') %}
{% set phone_url = 'tel:' ~ phone|replace({' ': '', '-': ''}) %}

{% set cr_number = theme.settings.get('unix_cr_number')|trim %}
{% set cr_badge = theme.settings.get('unix_cr_badge') %}
{% set tm_number = theme.settings.get('unix_tm_number')|trim %}

<footer data-testid="store-footer" class="store-footer unix-footer">
  <div class="store-footer__inner unix-container unix-footer__grid">

    {# 1. Brand & newsletter #}
    <div class="unix-footer__brand">
      <a href="{{ link('/') }}" class="unix-footer__logo">
        <img src="{{ store.logo|cdn(240) }}" alt="{{ store.name }}" width="120" height="48" loading="lazy">
      </a>
      {% if store.description %}
        <div class="unix-footer__about">{{ store.description|raw }}</div>
      {% endif %}

      <div class="unix-footer__newsletter">
        {% if newsletter_title|trim %}
          <h3 class="unix-footer__newsletter-title">{{ newsletter_title }}</h3>
        {% endif %}
        {# Salla has no built-in newsletter web component. Custom hook slot for a newsletter app; the provider
           is open decision D7 (docs/ROADMAP.md). Renders nothing until something is registered on it. #}
        {% hook 'footer:newsletter' %}
      </div>
    </div>

    {# 2. Shop: the store's main menu (root links) #}
    <details class="unix-footer__col" data-footer-accordion>
      <summary class="unix-footer__title">
        <span>{{ trans('blocks.unix.footer.shop') }}</span>
        <span class="unix-footer__icon" aria-hidden="true"></span>
      </summary>
      <div class="unix-footer__content">
        <salla-menu data-testid="store-footer-shop-menu" source="header"></salla-menu>
      </div>
    </details>

    {# 3. Help: the footer menu (policies, pages) #}
    <details class="unix-footer__col" data-footer-accordion>
      <summary class="unix-footer__title">
        <span>{{ trans('blocks.unix.footer.help') }}</span>
        <span class="unix-footer__icon" aria-hidden="true"></span>
      </summary>
      <div class="unix-footer__content">
        <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
      </div>
    </details>

    {# 4. Contact #}
    <details class="unix-footer__col" data-footer-accordion>
      <summary class="unix-footer__title">
        <span>{{ trans('blocks.unix.footer.contact') }}</span>
        <span class="unix-footer__icon" aria-hidden="true"></span>
      </summary>
      <div class="unix-footer__content">
        {# Social links live once, in the trust strip tiles below. #}
        <salla-contacts data-testid="store-footer-contacts"></salla-contacts>
      </div>
    </details>
  </div>

  {# Trust strip (SPEC §3.3) #}
  <div class="unix-trust">
    <div class="unix-container unix-trust__inner">

      {% if phone or whatsapp or instagram or tiktok %}
        <ul class="unix-trust__icons">
          {% if phone %}
            <li>
              <a class="unix-trust__icon" href="{{ phone_url }}" aria-label="{{ trans('blocks.unix.footer.call') }}" title="{{ phone }}">
                <i class="sicon-phone" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
          {% if whatsapp %}
            <li>
              <a class="unix-trust__icon" href="{{ whatsapp_url }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.unix.footer.whatsapp') }}">
                <i class="sicon-whatsapp" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
          {% if instagram %}
            <li>
              <a class="unix-trust__icon" href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.unix.footer.instagram') }}">
                <i class="sicon-instagram" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
          {% if tiktok %}
            <li>
              <a class="unix-trust__icon" href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.unix.footer.tiktok') }}">
                <i class="sicon-tiktok" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
        </ul>
      {% endif %}

      <div class="unix-trust__creds">
        {% if cr_number %}
          <div class="unix-trust__cred">
            {% if cr_badge %}
              <img class="unix-trust__cred-badge" src="{{ cr_badge }}" alt="{{ trans('blocks.unix.footer.cr_badge') }}" width="56" height="53" loading="lazy">
            {% endif %}
            <div class="unix-trust__cred-text">
              <span class="unix-trust__cred-label">{{ trans('blocks.unix.footer.cr') }}</span>
              <span class="unix-trust__cred-value" dir="ltr">{{ cr_number }}</span>
            </div>
          </div>
        {% endif %}

        {% if tm_number %}
          <div class="unix-trust__cred">
            <div class="unix-trust__cred-text">
              <span class="unix-trust__cred-label">{{ trans('blocks.unix.footer.tm') }}</span>
              <span class="unix-trust__cred-value" dir="ltr">{{ tm_number }}</span>
            </div>
          </div>
        {% endif %}

        {# VAT (Raed) #}
        {% if store.settings.tax.number %}
          <div class="unix-trust__cred">
            {% if store.settings.tax.certificate %}
              <a class="load-img-onclick unix-trust__cred-badge-link" data-modal-id="modal-value-tax" href="#/" aria-label="{{ trans('common.elements.tax_number') }}">
                <img width="40" height="50" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy" class="unix-trust__cred-badge" alt="">
              </a>
            {% endif %}
            <div class="unix-trust__cred-text">
              <span class="unix-trust__cred-label">{{ trans('common.elements.tax_number') }}</span>
              <span class="unix-trust__cred-value" dir="ltr">{{ store.settings.tax.number }}</span>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}

        <salla-trust-badges data-testid="store-footer-trust-badges" class="unix-trust__badges"></salla-trust-badges>
      </div>

      <div class="unix-trust__payments">
        <salla-payments data-testid="store-footer-payments"></salla-payments>
      </div>

      <div class="unix-trust__bottom">
        <span class="unix-trust__rights copyright-text">{% hook copyright %}</span>
        <salla-apps-icons data-testid="store-footer-apps" class="unix-trust__apps"></salla-apps-icons>
      </div>
    </div>
  </div>
</footer>
