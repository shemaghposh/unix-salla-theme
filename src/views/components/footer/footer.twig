{#
  UNIX footer + trust strip (ROADMAP 1.4, rebuilt in 6.4 · DS §8.8 · SPEC §3 · D111).
  Same structure as unix.sa (reference/shopify-theme/sections/footer-group.json, assets/section-footer.css):
    1. Three blocks in a row from lg: «سياسات» (Salla footer menu) · «القائمة» (second menu, from the
       unix_footer_menu2_links setting, one "label | url" per line; Salla has only a header and a footer
       menu) · newsletter «لا يفوتك جديدنا :» (title setting + the footer:newsletter hook slot, D7).
       Below lg: newsletter first, then the two menus as accordions (src/assets/js/partials/unix-footer.js
       opens them from lg up).
    2. A divider, then the logo and the copyright hook (and Salla's app badges when unix_footer_show_apps is on).
    3. Trust strip (SPEC §3.3): phone, WhatsApp, Instagram, TikTok tiles · CR, trademark and VAT ·
       Salla trust badges · a narrower divider · payment marks in full colour on white tiles.
  Merchant settings (twilight.json): unix_footer_menu1_title, unix_footer_menu2_title, unix_footer_menu2_links,
  unix_footer_newsletter_title, unix_contact_phone, unix_contact_whatsapp, unix_social_instagram,
  unix_social_tiktok, unix_cr_number, unix_cr_badge, unix_tm_number.
#}
{% set lang = language.code %}

{# Multilanguage text settings: empty (null, '' or spaces) → translated default #}
{% set newsletter_title = theme.settings.get('unix_footer_newsletter_title') %}
{% if newsletter_title is iterable %}{% set newsletter_title = newsletter_title[lang] is defined ? newsletter_title[lang] : null %}{% endif %}
{% set newsletter_title = newsletter_title|default('')|trim ?: trans('blocks.unix.footer.newsletter') %}

{% set menu1_title = theme.settings.get('unix_footer_menu1_title') %}
{% if menu1_title is iterable %}{% set menu1_title = menu1_title[lang] is defined ? menu1_title[lang] : null %}{% endif %}
{% if not menu1_title|trim %}{% set menu1_title = trans('blocks.unix.footer.menu1') %}{% endif %}

{% set menu2_title = theme.settings.get('unix_footer_menu2_title') %}
{% if menu2_title is iterable %}{% set menu2_title = menu2_title[lang] is defined ? menu2_title[lang] : null %}{% endif %}
{% if not menu2_title|trim %}{% set menu2_title = trans('blocks.unix.footer.menu2') %}{% endif %}

{# Second menu: "label | url" per line. Lines without a label or a url are skipped, and so is any url that is
   not a site path (/…, through link() so /en stays), http(s), mailto: or tel: (no javascript: etc.). #}
{% set menu2_raw = theme.settings.get('unix_footer_menu2_links') %}
{% if menu2_raw is iterable %}{% set menu2_raw = menu2_raw[lang] is defined ? menu2_raw[lang] : '' %}{% endif %}
{% set menu2_links = [] %}
{% for line in (menu2_raw|default(''))|replace({"\r": ''})|split("\n") %}
  {% set parts = line|split('|', 2) %}
  {% set m2_url = parts|length == 2 ? parts[1]|trim : '' %}
  {% set m2_low = m2_url|lower %}
  {% if m2_url starts with '/' and not (m2_url starts with '//') %}
    {% set m2_url = link(m2_url) %}
  {% elseif not (m2_low starts with 'https://' or m2_low starts with 'http://' or m2_low starts with 'mailto:' or m2_low starts with 'tel:') %}
    {% set m2_url = '' %}
  {% endif %}
  {% if parts[0]|trim and m2_url %}
    {% set menu2_links = menu2_links|merge([{ label: parts[0]|trim, url: m2_url }]) %}
  {% endif %}
{% endfor %}

{# Contact & social: settings first, then the store's own contact details from the dashboard. #}
{% set phone = theme.settings.get('unix_contact_phone')|default(store.contacts.phone|default(store.contacts.mobile))|trim %}
{% set whatsapp = theme.settings.get('unix_contact_whatsapp')|default(store.contacts.whatsapp|default(store.social.whatsapp))|trim %}
{% set instagram = theme.settings.get('unix_social_instagram')|default(store.social.instagram)|trim %}
{% set tiktok = theme.settings.get('unix_social_tiktok')|default(store.social.tiktok)|trim %}
{# 3.12 (D138): one shared builder; digits only, 00 / 0 prefixes normalised, no link under 8 digits #}
{% set whatsapp_url %}{% include 'components.unix-whatsapp-url' with { wa_raw: whatsapp } only %}{% endset %}
{% set whatsapp_url = whatsapp_url|trim %}
{# Accept a bare handle ("unix_theclub" or "@unix_theclub") as well as a full URL. #}
{% set instagram_url = instagram starts with 'http' ? instagram : 'https://instagram.com/' ~ instagram|trim('@', 'left') %}
{% set tiktok_url = tiktok starts with 'http' ? tiktok : 'https://www.tiktok.com/@' ~ tiktok|trim('@', 'left') %}
{% set phone_url = 'tel:' ~ phone|replace({' ': '', '-': ''}) %}

{% set cr_number = theme.settings.get('unix_cr_number')|trim %}
{% set cr_badge = theme.settings.get('unix_cr_badge') %}
{% set tm_number = theme.settings.get('unix_tm_number')|trim %}

<footer data-testid="store-footer" class="store-footer unix-footer">
  <div class="store-footer__inner unix-container">

    <div class="unix-footer__blocks">
      {# 1. «سياسات»: the store's footer menu (policies, pages) #}
      <details class="unix-footer__col" data-footer-accordion>
        <summary class="unix-footer__title">
          <span>{{ menu1_title|trim }}</span>
          <span class="unix-footer__icon" aria-hidden="true"></span>
        </summary>
        <div class="unix-footer__content">
          <salla-menu data-testid="store-footer-menu" source="footer" with-cookie-preferences></salla-menu>
        </div>
      </details>

      {# 2. «القائمة»: second menu from the theme setting (hidden while it has no links) #}
      {% if menu2_links|length %}
        <details class="unix-footer__col" data-footer-accordion>
          <summary class="unix-footer__title">
            <span>{{ menu2_title|trim }}</span>
            <span class="unix-footer__icon" aria-hidden="true"></span>
          </summary>
          <div class="unix-footer__content">
            <ul class="unix-footer__links">
              {% for item in menu2_links %}
                <li><a class="unix-footer__link" href="{{ item.url }}">{{ item.label }}</a></li>
              {% endfor %}
            </ul>
          </div>
        </details>
      {% endif %}

      {# 3. Newsletter (first below lg, last from lg, like unix.sa footer-block--subscribe) #}
      <div class="unix-footer__newsletter">
        <h2 class="unix-footer__newsletter-title">{{ newsletter_title }}</h2>
        {# Salla has no built-in newsletter web component. Custom hook slot for a newsletter app; the provider
           is open decision D7 (docs/ROADMAP.md). Renders nothing until something is registered on it. #}
        {% hook 'footer:newsletter' %}
      </div>
    </div>

    {# Logo + copyright row, under a divider (unix.sa footer__content-bottom) #}
    <div class="unix-footer__bottom">
      <div class="unix-footer__brand">
        <a href="{{ link('/') }}" class="unix-footer__logo">
          <img src="{{ store.logo|cdn(240) }}" alt="{{ store.name }}" width="120" height="48" loading="lazy">
        </a>
        <span class="unix-footer__rights copyright-text">{% hook copyright %}</span>
      </div>
      {# 6.4 batch 3 (D125): unix.sa has no app badges, so the block is off unless the merchant switches
         unix_footer_show_apps on (default false; Salla rendered the «حمّلي التطبيق» title even with no badges) #}
      {% if theme.settings.get('unix_footer_show_apps', false) %}
        <salla-apps-icons data-testid="store-footer-apps" class="unix-footer__apps"
                          apps-title="{{ trans('blocks.unix.footer.download_apps') }}"></salla-apps-icons>
      {% endif %}
    </div>
  </div>

  {# Trust strip (SPEC §3.3), as before #}
  <div class="unix-trust">
    <div class="unix-trust__inner">

      {% if phone or whatsapp_url or instagram or tiktok %}
        <ul class="unix-trust__icons">
          {% if phone %}
            <li>
              <a class="unix-trust__icon" href="{{ phone_url }}" aria-label="{{ trans('blocks.unix.footer.call') }}" title="{{ phone }}">
                <i class="sicon-phone" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
          {% if whatsapp_url %}
            <li>
              <a class="unix-trust__icon" href="{{ whatsapp_url }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.unix.footer.whatsapp') }}">
                <i class="sicon-whatsapp" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
          {% if instagram %}
            <li>
              <a class="unix-trust__icon" href="{{ instagram_url }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.unix.footer.instagram') }}">
                <i class="sicon-instagram" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
          {% if tiktok %}
            <li>
              <a class="unix-trust__icon" href="{{ tiktok_url }}" target="_blank" rel="noopener" aria-label="{{ trans('blocks.unix.footer.tiktok') }}">
                <i class="sicon-tiktok" aria-hidden="true"></i>
              </a>
            </li>
          {% endif %}
        </ul>
      {% endif %}

      <div class="unix-trust__creds">
        {% if cr_number %}
          <div class="unix-trust__cred">
            {% if cr_badge %}
              <img class="unix-trust__cred-badge" src="{{ cr_badge }}" alt="{{ trans('blocks.unix.footer.cr_badge') }}" width="56" height="53" loading="lazy">
            {% endif %}
            <div class="unix-trust__cred-text">
              <span class="unix-trust__cred-label">{{ trans('blocks.unix.footer.cr') }}</span>
              <span class="unix-trust__cred-value" dir="ltr">{{ cr_number }}</span>
            </div>
          </div>
        {% endif %}

        {% if tm_number %}
          <div class="unix-trust__cred">
            <div class="unix-trust__cred-text">
              <span class="unix-trust__cred-label">{{ trans('blocks.unix.footer.tm') }}</span>
              <span class="unix-trust__cred-value" dir="ltr">{{ tm_number }}</span>
            </div>
          </div>
        {% endif %}

        {# VAT (Raed) #}
        {% if store.settings.tax.number %}
          <div class="unix-trust__cred">
            {% if store.settings.tax.certificate %}
              {# ROADMAP 6.3: opens a modal, so a button (no fake "#/" link); app.js .load-img-onclick handles the click #}
              <button type="button" class="load-img-onclick unix-trust__cred-badge-link" data-modal-id="modal-value-tax" aria-haspopup="dialog" aria-label="{{ trans('common.elements.tax_number') }}">
                <img width="40" height="50" src="{{ 'images/tax.png'|cdn(70,70) }}" loading="lazy" class="unix-trust__cred-badge" alt="">
              </button>
            {% endif %}
            <div class="unix-trust__cred-text">
              <span class="unix-trust__cred-label">{{ trans('common.elements.tax_number') }}</span>
              <span class="unix-trust__cred-value" dir="ltr">{{ store.settings.tax.number }}</span>
            </div>
          </div>

          {% if store.settings.tax.certificate %}
            <salla-modal data-testid="store-footer-tax-modal" sub-title-first sub-title="{{ trans('common.elements.tax_number') }}" modal-title="{{ store.settings.tax.number }}" id="modal-value-tax">
              <div class="flex justify-center max-w-full">
                <img class="w-full" loading="lazy" data-src="{{ store.settings.tax.certificate }}" alt="{{ store.settings.tax.number }}"/>
              </div>
            </salla-modal>
          {% endif %}
        {% endif %}

        <salla-trust-badges data-testid="store-footer-trust-badges" class="unix-trust__badges"></salla-trust-badges>
      </div>

      <div class="unix-trust__payments">
        <salla-payments data-testid="store-footer-payments"></salla-payments>
      </div>
    </div>
  </div>
</footer>
