{#
  UNIX featured products, «اختاري قطعتك المفضلة لوقت الاسترخاء» (ROADMAP 2.6 · DS §8.16 · SPEC §4.7).
  Matches unix.sa: reference/shopify-theme/sections/featured-products.liquid
  + snippets/product-card-horizontal.liquid + templates/index.json → featured-products.
  Each slide = a merchant lifestyle image with a small horizontal product card over its bottom.

  | Variable                 | Type      | Description                                                   |
  |--------------------------|-----------|---------------------------------------------------------------|
  | component.title          | ?string   | Section heading (falls back to the translated default)        |
  | component.items          | object[]  | One entry per slide                                           |
  | component.items[].product| mixed     | The product (object, picker row {value} or bare id)          |
  | component.items[].image  | ?string   | Lifestyle image URL; empty = the product image               |
  | position                 | int       | Sorting number, starts from zero                              |

  When Salla hands the product back as a full object (name/url/price), the card renders here.
  Otherwise only the id is known: the card renders a same-size skeleton marked
  data-unix-fprod-pending and src/assets/js/partials/unix-featured-products.js fills it from
  salla.product.api (one request for the whole section).
#}
{% set uid = 'unix-fprods-' ~ position %}
{% set lang = language.code|default('ar') %}

{% set title = component.title %}
{% if title is iterable %}{% set title = title[lang]|default('') %}{% endif %}
{% if title is null %}{% set title = trans('blocks.unix.featured_products.default_title') %}{% endif %}

{# Swiper config (salla-slider): per-view 1 / 2 / 3 and the DS §3.3 gutters per breakpoint #}
{% set slider_config = '{"slidesPerView":1,"spaceBetween":12,"breakpoints":{"576":{"slidesPerView":1,"spaceBetween":16},"768":{"slidesPerView":2,"spaceBetween":20},"1024":{"slidesPerView":3,"spaceBetween":24},"1440":{"slidesPerView":3,"spaceBetween":32}}}' %}

{% set slides = [] %}
{% for item in component.items|default([]) %}
  {% set prod = item.product %}
  {% if prod is iterable and prod[0] is defined %}{% set prod = prod[0] %}{% endif %}
  {% set pid = prod.id is defined ? prod.id : (prod.value is defined ? prod.value : (prod is iterable ? null : prod)) %}
  {% if pid %}
    {% set resolved = prod.name is defined and prod.url is defined %}
    {% set image = item.image %}
    {% if image is iterable %}{% set image = image.url|default('') %}{% endif %}
    {% set slides = slides|merge([{
      'id': pid,
      'resolved': resolved,
      'product': resolved ? prod : null,
      'image': image|default('')
    }]) %}
  {% endif %}
{% endfor %}

{% if slides|length %}
<section component-id="{{ componentId }}"
         class="s-block unix-fprods"
         data-unix-fprods
         {% if title|trim %}aria-labelledby="{{ uid }}-title"{% endif %}>
  <div class="unix-container">
    {% if title|trim %}
      <h2 id="{{ uid }}-title" class="unix-fprods__title">{{ title|trim }}</h2>
    {% endif %}

    <salla-slider id="{{ uid }}-slider"
                  class="unix-fprods__slider"
                  type="carousel"
                  slider-config='{{ slider_config|raw }}'>
      <div slot="items">
        {% for slide in slides %}
          {% set p = slide.product %}
          {% set thumb = p and p.image.url is defined ? p.image.url : '' %}
          {% set media = slide.image ?: thumb %}
          <div class="swiper-slide unix-fprods__slide">
            <article class="unix-fprods__item"
                     data-unix-fprod="{{ slide.id }}"
                     {% if not slide.resolved %}data-unix-fprod-pending{% endif %}
                     {% if not slide.image %}data-unix-fprod-use-thumb{% endif %}>
              <div class="unix-fprods__media">
                {# 4:5 box is reserved by CSS (--ratio-card); width/height give the same ratio #}
                <img class="unix-fprods__img"
                     {% if media %}src="{{ media }}"{% else %}hidden{% endif %}
                     alt="{{ p ? p.name|e('html_attr') : '' }}"
                     width="800" height="1000"
                     loading="lazy" decoding="async">
              </div>

              <a class="unix-fprods__card" href="{{ p ? p.url : '#' }}" {% if not p %}aria-busy="true" tabindex="-1"{% endif %}>
                <span class="unix-fprods__thumb">
                  <img {% if thumb %}src="{{ thumb }}"{% else %}hidden{% endif %} alt="" width="64" height="80" loading="lazy" decoding="async">
                </span>
                <span class="unix-fprods__info">
                  <span class="unix-fprods__name" data-unix-fprod-name>{{ p ? p.name : '' }}</span>
                  <span class="unix-fprods__price" data-unix-fprod-price>
                    {%- if p -%}
                      {%- if p.is_on_sale -%}
                        <span class="unix-fprods__price-sale">{{ p.sale_price|money }}</span>
                        <s class="unix-fprods__price-old">{{ p.regular_price|money }}</s>
                      {%- else -%}
                        {{ p.price|money }}
                      {%- endif -%}
                    {%- endif -%}
                  </span>
                </span>
                <svg class="unix-fprods__chevron icon-dir" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          </div>
        {% endfor %}
      </div>
    </salla-slider>
  </div>
</section>
{% endif %}
