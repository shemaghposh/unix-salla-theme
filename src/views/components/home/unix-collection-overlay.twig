{#
| «جديد من يونكس» — collection overlay (ROADMAP 2.4 · DS §8.13 · SPEC §4.4)
| Ground truth: reference/shopify-theme/sections/featured-collection.liquid (layout `overlay`).
|
| Variable                   | Type      | Description                                                   |
|----------------------------|-----------|---------------------------------------------------------------|
| component.subtitle         | ?string   | eyebrow, multilanguage (default «NEW COLLECTION»)             |
| component.title            | ?string   | section heading, multilanguage (default «جديد من يونكس»)       |
| component.category         | mixed     | dropdown-list (source categories, single): object {id}, picker |
|                            |           | row {value}, a list of those, or a bare / JSON-string id       |
| component.limit            | ?int      | products in the carousel (default 8)                          |
| component.image            | ?string   | background image, desktop (falls back to the category image)  |
| component.image_mobile     | ?string   | background image below 576px (optional, unix.sa switch point) |
| component.overlay          | ?int      | overlay opacity in % (20–60, default 30 like unix.sa)         |
| position                   | int       | sorting number, starts from zero                              |
|
| Text defaults: empty (null, '' or spaces; Salla saves an untouched field as '') falls back to
| trans('blocks.unix.collection_overlay.default_*').
| 6.4: the category used to be read only by `is defined` / `is iterable` checks, which Salla's list
| object defeats, so category_id stayed null and the slider never rendered. Live shape and reader
| below; a never-saved field definition (carries `source`) is dropped, only positive integer ids count.
#}
{% set subtitle = component.subtitle %}
{% if subtitle is iterable %}{% set subtitle = subtitle[language.code] is defined ? subtitle[language.code] : null %}{% endif %}
{% set subtitle = subtitle|default('')|trim ?: trans('blocks.unix.collection_overlay.default_subtitle') %}

{% set title = component.title %}
{% if title is iterable %}{% set title = title[language.code] is defined ? title[language.code] : null %}{% endif %}
{% set title = title|default('')|trim ?: trans('blocks.unix.collection_overlay.default_title') %}

{% set category = component.category %}
{# Seen on the live preview: a list [{id: 2011795657, name, image, …}]. Salla's list object reports
   `.id` / `.source` as "defined" (null) on the list itself, and `|first` returns an object that is
   not `iterable`, so the first pick is read by its id, never by `is defined` / `is iterable`. #}
{% set first_pick = category is iterable ? category|first : null %}
{% set first_id = null %}
{% if first_pick is not null and first_pick is not same as(false) and first_pick is not same as(true) %}
  {# an object pick (the live shape) or a {value} row → its id; a bare scalar pick ([12]) → itself #}
  {% set first_id = first_pick is iterable or first_pick.id is defined
    ? first_pick.id|default(first_pick.value|default(null))
    : first_pick %}
{% endif %}
{# only a positive integer counts here; anything else (e.g. the first property of a single object) falls through #}
{% if first_id is not iterable and first_id and (first_id ~ '') matches '/^[1-9][0-9]*$/' %}
  {% set category = first_pick %}
  {% set category_id = first_id %}
{% else %}
  {# object {id} or picker row {value}, or a bare id; a never-saved field definition
     ({source: "categories", …}) yields a non-numeric value and is dropped below #}
  {% set category_id = category is iterable
    ? category.id|default(category.value|default(null))
    : category %}
{% endif %}
{% if category_id is iterable %}{% set category_id = category_id|first %}{% endif %}
{# a bare id may come as a string, also JSON-ish ("[12]", "\"12\"") #}
{% if category_id is same as(true) or category_id is same as(false) %}{% set category_id = null %}{% endif %}
{% if category_id is not iterable %}
  {% set category_id = (category_id|default('') ~ '')|replace({'[': '', ']': '', '"': ''})|trim %}
{% endif %}
{% set category_id = category_id is not iterable and category_id matches '/^[1-9][0-9]*$/' ? category_id : null %}

{# the category image is only known when Salla sends the category as an object; Salla's pick object is
   not `iterable`, so test `.image is defined` too (a scalar id has none) #}
{% set category_image = category and category is not same as(true) and (category is iterable or category.image is defined)
  ? category.image|default(null) : null %}
{% set image = component.image ?: (category_image is iterable ? null : category_image) %}
{% set image_mobile = component.image_mobile %}

{% set overlay = component.overlay is null ? 30 : component.overlay %}
{% set overlay = overlay < 20 ? 20 : (overlay > 60 ? 60 : overlay) %}
{% set limit = component.limit ?: 8 %}
{% set heading_id = 'unix-collection-overlay-' ~ position %}

<section class="unix-collection-overlay"
         component-id="{{ componentId }}"
         data-testid="unix-collection-overlay"
         aria-labelledby="{{ heading_id }}">
  <div class="unix-collection-overlay__frame">
    <div class="unix-collection-overlay__inner">
      {% if image %}
        <picture class="unix-collection-overlay__media">
          {% if image_mobile %}
            <source media="(max-width: 575px)" srcset="{{ image_mobile }}" width="800" height="1000">
          {% endif %}
          <img src="{{ image }}" alt="" width="1200" height="1500" loading="lazy" decoding="async">
        </picture>
      {% endif %}
      <span class="unix-collection-overlay__overlay" style="--overlay-opacity: {{ overlay / 100 }}" aria-hidden="true"></span>

      <div class="unix-collection-overlay__content">
        {# unix.sa grid "info info buttons": heading block, arrows at the end of the same row #}
        <div class="unix-collection-overlay__head">
          {# subtitle and title are never empty (empty → translated default, DS §9) #}
          <header class="unix-collection-overlay__header">
            <p class="unix-collection-overlay__eyebrow">{{ subtitle }}</p>
            <h2 id="{{ heading_id }}" class="unix-collection-overlay__title">{{ title }}</h2>
          </header>
          {% if category_id %}
            {# shown from lg once the slider is ready (partials/unix-collection-overlay.js) #}
            <div class="unix-collection-overlay__arrows">
              <button type="button" class="unix-collection-overlay__arrow" data-unix-arrow="prev" hidden
                      aria-label="{{ trans('blocks.unix.collection_overlay.prev') }}">
                <svg class="icon-dir" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 6l-6 6 6 6"/>
                </svg>
              </button>
              <button type="button" class="unix-collection-overlay__arrow" data-unix-arrow="next" hidden
                      aria-label="{{ trans('blocks.unix.collection_overlay.next') }}">
                <svg class="icon-dir" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 6l6 6-6 6"/>
                </svg>
              </button>
            </div>
          {% endif %}
        </div>

        {% if category_id %}
          {# .unix-products opts into the shared card styles (unix-product-card.scss, DS §8.3) #}
          <div class="unix-collection-overlay__products unix-products">
            <salla-products-slider
              source="categories"
              source-value="[{{ category_id }}]"
              limit="{{ limit }}"
              slider-id="unix-collection-overlay-slider-{{ position }}"
            ></salla-products-slider>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
