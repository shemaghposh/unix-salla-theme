{#
| Variable        | Type    | Description                                                      |
|-----------------|---------|------------------------------------------------------------------|
| url             | string  |                                                                  |
| image.url       | string  |                                                                  |
| image.alt       | ?string |                                                                  |
| image.small_url | ?string |                                                                  |
| position        | Int     | Sorting number start from zero                                   |

#}
<section component-id="{{ componentId }}" data-testid="store-home-fixed-banner" class="s-block s-block--fixed-banner wide-placeholder">
    <div class="container">
        {% set alt_text = image.alt|trim ? image.alt : 'fixed banner' %}
        <a href="{{ url }}" class="banner banner--fixed overflow-hidden" aria-label="Banner {{ alt_text }}">
            <picture>
                {% if image.small_url %}
                    <source
                        media="(max-width: 767px)"
                        srcset="{{ image.small_url }}"
                    />
                {% endif %}
                <img
                    width="1200"
                    height="300"
                    src="{{ image.url }}"
                    loading="lazy"
                    alt="{{ alt_text }}"
                    style="height:auto;max-width:100%;object-fit: contain;"
                />
                {# ROADMAP 6.2: no fetchpriority="high" on a lazy banner; high is for the LCP image only (DS §6) #}
            </picture>
        </a>
    </div>
</section>
