{#
  UNIX cart drawer (ROADMAP 4.3 · DS §8.33, §8.9 · SPEC §7.1)
  Port of unix.sa snippets/cart-drawer.liquid + assets/cart-drawer.js.

  Included once from components/header/header.twig when `unix_cart_drawer_enabled` is on and the
  page is not the cart page (D85). The shell is server-rendered; the lines come from Salla
  (`salla.cart.api.details(null, ['options'])`) because cart items are not in Twig outside /cart.
  Behaviour: src/assets/js/partials/unix-cart-drawer.js on top of the 1.3 Drawer (focus trap, Esc,
  backdrop, focus return). Cart logic stays Salla's: updateItem / deleteItem / submit.

  Settings: unix_cart_empty_heading, unix_cart_empty_text (multilanguage; null/empty → unix.sa copy).
  UI strings JS needs are passed as data-* (blocks.unix.cart_drawer.*), placeholders as __TOKEN__.
#}
{% set cd_lang = language.code|default('ar') %}

{% set cd_empty_heading = theme.settings.get('unix_cart_empty_heading') %}
{% if cd_empty_heading is iterable %}{% set cd_empty_heading = cd_empty_heading[cd_lang] is defined ? cd_empty_heading[cd_lang] : null %}{% endif %}
{% if cd_empty_heading is null or not cd_empty_heading|trim %}{% set cd_empty_heading = trans('blocks.unix.cart_drawer.empty_heading') %}{% endif %}

{% set cd_empty_text = theme.settings.get('unix_cart_empty_text') %}
{% if cd_empty_text is iterable %}{% set cd_empty_text = cd_empty_text[cd_lang] is defined ? cd_empty_text[cd_lang] : null %}{% endif %}
{% if cd_empty_text is null or not cd_empty_text|trim %}{% set cd_empty_text = trans('blocks.unix.cart_drawer.empty_text') %}{% endif %}

{% set cd_title = trans('blocks.unix.cart_drawer.title', {'count': '__COUNT__'})|split('__COUNT__') %}

<div id="cart-drawer" class="unix-drawer unix-drawer--end unix-cd" role="dialog" aria-modal="true"
     aria-labelledby="cart-drawer-title" data-unix-drawer data-unix-cart-drawer hidden
     data-i18n-remove="{{ trans('blocks.unix.cart_drawer.remove', {'name': '__NAME__'})|e('html_attr') }}"
     data-i18n-quantity="{{ trans('blocks.unix.cart_drawer.quantity', {'name': '__NAME__'})|e('html_attr') }}"
     data-i18n-sold-out="{{ trans('blocks.unix.cart_drawer.out_of_stock')|e('html_attr') }}"
     data-i18n-sale-price="{{ trans('blocks.unix.cart_drawer.sale_price')|e('html_attr') }}"
     data-i18n-regular-price="{{ trans('blocks.unix.cart_drawer.regular_price')|e('html_attr') }}"
     data-i18n-live="{{ trans('blocks.unix.cart_drawer.live', {'count': '__COUNT__', 'total': '__TOTAL__'})|e('html_attr') }}">
  <div class="unix-drawer__backdrop" data-drawer-close></div>
  <div class="unix-drawer__panel unix-cd__panel">

    <div class="unix-cd__header">
      <div class="unix-cd__header-top">
        <h2 id="cart-drawer-title" class="unix-drawer__title unix-cd__title">
          {{- cd_title[0] -}}<span data-cd-count>{{ cart.items_count|default(0) }}</span>{{- cd_title[1]|default('') -}}
        </h2>
        <button type="button" class="unix-icon-btn unix-drawer__close" data-drawer-close
                aria-label="{{ trans('blocks.unix.cart_drawer.close') }}">
          <i class="sicon-cancel" aria-hidden="true"></i>
        </button>
      </div>
      {% include 'components.cart.unix-free-shipping' with { fs_live: false } %}
    </div>

    {# First open: skeleton until Salla answers #}
    <div class="unix-cd__loading" data-cd-loading aria-hidden="true">
      {% for n in 1..2 %}
        <span class="unix-cd__skel">
          <span class="unix-cd__skel-media"></span>
          <span class="unix-cd__skel-lines"><span></span><span></span><span></span></span>
        </span>
      {% endfor %}
    </div>
    <p class="sr-only" data-cd-loading-label>{{ trans('blocks.unix.cart_drawer.loading') }}</p>

    <p class="unix-cd__error" data-cd-error role="alert" hidden>
      {{ trans('blocks.unix.cart_drawer.error') }}
      <a class="unix-cd__error-link" href="{{ link('cart') }}">{{ trans('blocks.unix.cart_drawer.view_cart') }}</a>
    </p>

    {# Empty state (unix.sa drawer__empty) #}
    <div class="unix-cd__empty" data-cd-empty hidden>
      <p class="unix-cd__empty-heading">{{ cd_empty_heading|trim }}</p>
      {% if cd_empty_text|trim %}
        <p class="unix-cd__empty-text">{{ cd_empty_text|trim }}</p>
      {% endif %}
      <a class="unix-btn unix-cd__empty-btn" href="{{ link('products') }}">{{ trans('blocks.unix.cart_drawer.shop_now') }}</a>
    </div>

    {# Lines + cashback, scrolling between the fixed header and footer #}
    <div class="unix-cd__body" data-cd-body hidden>
      <ul class="unix-cd__items" role="list" aria-label="{{ trans('blocks.unix.cart_drawer.items_label') }}" data-cd-items></ul>
      <div class="unix-cd__cbk">
        {% include 'components.cart.unix-cashback-note' with { cbk_base: 0 } %}
      </div>
    </div>

    <div class="unix-cd__footer" data-cd-footer hidden>
      <div class="unix-cd__totals">
        <p class="unix-cd__subtotal-label">{{ trans('blocks.unix.cart_drawer.subtotal') }}</p>
        <p class="unix-cd__subtotal" data-cd-subtotal></p>
      </div>
      <div class="unix-cd__ctas">
        <button type="button" class="unix-btn unix-btn--block" data-cd-checkout>{{ trans('blocks.unix.cart_drawer.checkout') }}</button>
        <a class="unix-btn unix-btn--block" href="{{ link('cart') }}">{{ trans('blocks.unix.cart_drawer.view_cart') }}</a>
      </div>
      <p class="unix-cd__tax">
        {{- store.settings.tax.taxable_prices_enabled ? trans('blocks.unix.cart_drawer.tax_included') : trans('blocks.unix.cart_drawer.tax_at_checkout') -}}
      </p>
    </div>

    <p class="sr-only" role="status" data-cd-live></p>
  </div>

  {# One line; unix-cart-drawer.js clones it per cart item #}
  <template data-cd-item-tpl>
    <li class="unix-cd-item" data-cd-item>
      <a class="unix-cd-item__media" data-cd-link tabindex="-1" aria-hidden="true">
        <img class="unix-cd-item__img" data-cd-img src="" alt="" width="84" height="112" loading="lazy" decoding="async">
      </a>
      <div class="unix-cd-item__details">
        <a class="unix-cd-item__name" data-cd-link data-cd-name></a>
        <dl class="unix-cd-item__options" data-cd-options hidden></dl>
        <p class="unix-cd-item__offer" data-cd-offer hidden></p>
        <div class="unix-cd-item__bottom">
          <div class="unix-cd-item__qty" data-cd-qty></div>
          <div class="unix-cd-item__end">
            <p class="unix-cd-item__price" data-cd-price></p>
            <button type="button" class="unix-cd-item__remove" data-cd-remove>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 7h16M10 11v6M14 11v6M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-12M9 7V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </div>
    </li>
  </template>
</div>
