UNIX header (ROADMAP 1.2 · DS §8.7 · SPEC §2).
RTL order: menu on the start side, logo centred (120px), then search, account, AR/EN and cart on the end side.
Sticky behaviour (hide on scroll down, show on scroll up, --e-1) lives in src/assets/js/partials/unix-header.js.
Transparent variant: enabled by the `unix_header_transparent_home` setting on the home page, and only
switched on by JS when the page contains a hero marked [data-header-overlay] (Phase 2).
#}
{% set header_overlay = is_page('index') and theme.settings.get('unix_header_transparent_home', true) %}
{% set inverse_logo = theme.settings.get('unix_header_logo_inverse') %}
<header data-testid="store-header" class="store-header unix-header" data-unix-header{{ header_overlay ? ' data-overlay-capable' }}>
  {% include 'components.header.announcement-bar' %}

  {# Bullet Delivery tag — mobile: own full-width row above the nav. Self-gates on the backend flag. #}
  <div class="lg:hidden">
    <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
  </div>

  {# Main Nav: #mainnav reserves the bar height while the bar itself is fixed (sticky state). #}
  <div id="mainnav" class="main-nav-container unix-header__nav">
    <div class="inner unix-header__bar">
      <div class="unix-container unix-header__inner">

        {# Start side: drawer trigger (< lg) + inline menu with mega menu (≥ lg) #}
        <div class="unix-header__start">
          <button type="button" data-testid="store-header-mobile-toggle" class="unix-icon-btn unix-header__menu-toggle"
                  aria-controls="mobile-menu" aria-expanded="false" aria-haspopup="dialog"
                  aria-label="{{ trans('blocks.unix.header.open_menu') }}">
            <i class="sicon-menu" aria-hidden="true"></i>
          </button>
          <custom-main-menu
            data-display-all="{{ trans('blocks.unix.menu.display_all') }}"
            data-more="{{ trans('blocks.unix.menu.more') }}"
            data-label="{{ trans('blocks.unix.menu.main') }}"></custom-main-menu>
        </div>

        {# Centre: logo #}
        <a data-testid="store-header-logo" class="navbar-brand unix-header__logo" href="{{ store.url }}">
          <img class="unix-header__logo-img" fetchpriority="high" loading="eager" width="120" height="48"
               src="{{ store.logo|cdn(240) }}" alt="{{ store.name }}">
          {% if inverse_logo %}
            <img class="unix-header__logo-img unix-header__logo-img--inverse" loading="eager" width="120" height="48"
                 src="{{ inverse_logo }}" alt="" aria-hidden="true">
          {% endif %}
          {% if is_page('index') %}
            <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
            <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>

        {# End side: search, account, AR/EN, cart #}
        <div class="unix-header__end">
          {# Scopes | Branches #}
          {% if store.scope %}
            <button type="button" class="unix-icon-btn unix-header__desktop-only"
                    aria-label="{{ store.scope.name }}"
                    onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
              <i class="sicon-location" aria-hidden="true"></i>
            </button>
          {% endif %}

          {# Bullet Delivery tag — desktop only; mobile instance is above the nav #}
          <div class="hidden lg:block">
            <salla-bullet-delivery-tag></salla-bullet-delivery-tag>
          </div>

          <button type="button" class="unix-icon-btn" data-unix-search-open data-testid="store-header-search"
                  aria-label="{{ trans('blocks.unix.header.search') }}" aria-haspopup="dialog">
            <i class="sicon-search" aria-hidden="true"></i>
          </button>

          <div class="unix-header__account unix-header__wide-only">
            <salla-user-menu data-testid="store-header-user-menu" avatar-only show-header show-trigger></salla-user-menu>
          </div>

          {% if store.settings.is_multilingual %}
            <div class="unix-header__wide-only">
              {% include 'components.header.lang-toggle' %}
            </div>
          {% endif %}

          {# Currency picker (and the fallback language picker used by unix-header.js) #}
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <div class="unix-header__desktop-only header-buttons">
              <salla-localization-modal data-testid="store-header-localization"{{ store.settings.currencies_enabled ? ' show-trigger' }}></salla-localization-modal>
            </div>
          {% endif %}

          <salla-cart-summary data-testid="store-header-cart" class="unix-header__cart">
            <i slot="icon" class="header-btn__icon icon sicon-shopping-bag" aria-hidden="true"></i>
          </salla-cart-summary>
        </div>

      </div>
    </div>
  </div>

  {#
    Mobile menu drawer (ROADMAP 1.3 · DS §8.9). Opens from the inline-start side.
    src/assets/js/partials/unix-drawer.js moves it under <body>, traps focus, closes on Esc / backdrop
    and restores focus to the trigger. main-menu.js renders the accordion into [data-drawer-menu].
  #}
  <div id="mobile-menu" class="unix-drawer unix-drawer--start" role="dialog" aria-modal="true"
       aria-labelledby="mobile-menu-title" data-unix-drawer hidden>
    <div class="unix-drawer__backdrop" data-drawer-close></div>
    <div class="unix-drawer__panel">
      <div class="unix-drawer__header">
        <h2 id="mobile-menu-title" class="unix-drawer__title">{{ trans('blocks.unix.menu.title') }}</h2>
        <button type="button" class="unix-icon-btn unix-drawer__close" data-drawer-close
                aria-label="{{ trans('blocks.unix.menu.close') }}">
          <i class="sicon-cancel" aria-hidden="true"></i>
        </button>
      </div>

      <nav class="unix-drawer__body" aria-label="{{ trans('blocks.unix.menu.main') }}">
        <ul class="unix-mmenu" data-drawer-menu>
          <li class="unix-mmenu__loading" aria-hidden="true">
            <span class="header-skel-item"></span>
            <span class="header-skel-item"></span>
            <span class="header-skel-item"></span>
          </li>
        </ul>
      </nav>

      <div class="unix-drawer__footer">
        {% if user.type == 'user' %}
          <a class="unix-drawer__account" href="{{ link('profile') }}">
            <i class="sicon-user" aria-hidden="true"></i>
            <span>{{ trans('blocks.unix.menu.my_account') }}</span>
          </a>
        {% else %}
          <button type="button" class="unix-drawer__account" data-drawer-close
                  onclick="salla.event.dispatch('login::open')">
            <i class="sicon-user" aria-hidden="true"></i>
            <span>{{ trans('blocks.unix.menu.login') }}</span>
          </button>
        {% endif %}
        {% if store.settings.is_multilingual %}
          {% include 'components.header.lang-toggle' %}
        {% endif %}
      </div>
    </div>
  </div>
</header>
