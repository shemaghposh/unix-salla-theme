{#
  UNIX announcement bar (ROADMAP 1.1 · DS §8.6 · SPEC §2).
  Two messages that cross-fade every 5s (src/assets/js/partials/unix-announcement.js),
  paused on hover and focus. Texts and links come from twilight.json settings:
    unix_announcement_enabled, unix_announcement_{1,2}_text (multilanguage), unix_announcement_{1,2}_link,
    unix_free_shipping_threshold (used by the default second message; D1 = 500).
  Message 1 defaults to the setting's own value; an empty message 1 is hidden. An empty message 2 falls
  back to the translated shipping template (fed by the threshold). With no message left, the bar is not rendered.
#}
{% set announcement_items = [] %}
{% if theme.settings.get('unix_announcement_enabled', true) %}
  {% set threshold = theme.settings.get('unix_free_shipping_threshold', 500)|default(500) %}
  {% set announcement_defaults = ['', trans('blocks.unix.announcement.default_2', {'amount': threshold|money})] %}
  {% for i in 1..2 %}
    {% set text = theme.settings.get('unix_announcement_' ~ i ~ '_text') %}
    {% if text is iterable %}
      {% set text = text[language.code]|default('') %}
    {% endif %}
    {% set text = text|default('')|trim ?: announcement_defaults[i - 1] %}
    {% if text %}
      {% set announcement_items = announcement_items|merge([{
        'text': text,
        'url': theme.settings.get('unix_announcement_' ~ i ~ '_link')|default('')|trim
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if announcement_items|length %}
  <div class="unix-announcement" data-unix-announcement role="region"
       aria-label="{{ trans('blocks.unix.announcement.label') }}">
    <div class="unix-container unix-announcement__track">
      {% for item in announcement_items %}
        <p class="unix-announcement__item{{ loop.first ? ' is-active' }}" aria-hidden="{{ loop.first ? 'false' : 'true' }}">
          {% if item.url %}
            <a class="unix-announcement__link" href="{{ item.url }}"{{ loop.first ? '' : ' tabindex="-1"' }}>{{ item.text }}</a>
          {% else %}
            <span>{{ item.text }}</span>
          {% endif %}
        </p>
      {% endfor %}
    </div>
  </div>
{% endif %}
