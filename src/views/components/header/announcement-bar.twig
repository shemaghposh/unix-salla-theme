{#
  UNIX announcement bar (ROADMAP 1.1 · DS §8.6 · SPEC §2). Included once, at the top of header.twig.
  Matches unix.sa (reference/shopify-theme/sections/announcement-bar.liquid + header-group.json):
  fixed 40px, messages slide vertically (next enters from below, current exits upward),
  4s dwell (--d-announce), 0.8s slide (--d-announce-slide), loop. Driven by
  src/assets/js/partials/unix-announcement.js; a visible pause/play button (WCAG 2.2.2) stops it
  until pressed again, and it also pauses on hover, focus and hidden tab (DS §8.6, §12).
  Settings (twilight.json):
    unix_announcement_enabled          boolean  show/hide the bar (true until saved)
    unix_announcement_{1,2}_text       string   multilanguage, one line
    unix_announcement_{1,2}_link       link     optional (product/category/page/custom), empty = plain text
    unix_free_shipping_threshold       number   feeds the default second message (D1 = 500), shown
                                                without decimals like unix.sa ("500 ر.س")
  Defaults: Salla applies twilight.json `value`s only after the merchant saves, so a message
  that is empty (null, '' or spaces: never saved, saved untouched, or missing for this language)
  falls back to the translated default:
    1 → blocks.unix.announcement.default_1
    2 → blocks.unix.announcement.default_2 (with the threshold as :amount)
  (6.4: message 1 used to be skipped on '', but Salla saves untouched fields as '', so it fell
  silent. To hide the bar use unix_announcement_enabled.)
#}
{% set announcement_items = [] %}
{% if theme.settings.get('unix_announcement_enabled', true) %}
  {% set threshold = theme.settings.get('unix_free_shipping_threshold', 500)|default(500) %}
  {% set announcement_defaults = [
    trans('blocks.unix.announcement.default_1'),
    trans('blocks.unix.announcement.default_2', {'amount': threshold|number_format(0, '.', ',')})
  ] %}
  {% for i in 1..2 %}
    {% set text = theme.settings.get('unix_announcement_' ~ i ~ '_text') %}
    {# multilanguage values may arrive as {ar, en}; resolve to the current language #}
    {% if text is iterable %}
      {% set text = text[language.code] is defined ? text[language.code] : null %}
    {% endif %}
    {% if not text|default('')|trim %}
      {% set text = announcement_defaults[i - 1] %}
    {% endif %}
    {# link picker (variable-list) returns an object with .url; tolerate a plain string too #}
    {% set url = theme.settings.get('unix_announcement_' ~ i ~ '_link') %}
    {% if url is iterable %}
      {% set url = url.url|default('') %}
    {% endif %}
    {% if text|trim %}
      {% set announcement_items = announcement_items|merge([{
        'text': text|trim,
        'url': url|default('')|trim
      }]) %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if announcement_items|length %}
  {% set rotates = announcement_items|length > 1 %}
  <div class="unix-announcement" role="region"
       aria-label="{{ trans('blocks.unix.announcement.label') }}"
       {% if rotates %}data-unix-announcement{% endif %}>
    <div class="unix-container unix-announcement__inner">
      <ul class="unix-announcement__track" role="list">
        {% for item in announcement_items %}
          <li class="unix-announcement__item{{ loop.first ? ' is-active' }}">
            {% if item.url %}
              <a class="unix-announcement__link" href="{{ item.url }}">{{ item.text }}</a>
            {% else %}
              <span>{{ item.text }}</span>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
      {# WCAG 2.2.2 (A11Y R18.1): a visible pause control, fixed name + aria-pressed (R15.2).
         Hidden until unix-announcement.js wires it, so no dead button without JS. #}
      {% if rotates %}
        <button type="button" class="unix-announcement__toggle" data-unix-announcement-toggle hidden
                aria-label="{{ trans('blocks.unix.announcement.pause') }}" aria-pressed="false">
          <svg class="unix-announcement__toggle-pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
               fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
            <path d="M9 6v12M15 6v12"/>
          </svg>
          <svg class="unix-announcement__toggle-play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"
               fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
            <path d="M8 5.5v13l10.5-6.5z"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
{% endif %}
