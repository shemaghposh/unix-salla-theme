{{ 'section-popular-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="popular-products color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="container">
    <div
      class="
        {% if section.settings.enable_carousel %} section-grid-slider {% if section.settings.button_show == false %} section-grid-slider_nav {% endif %} {% endif %}
        section-grid
        {% if section.settings.subheading == blank and section.settings.heading == blank and section.settings.text == blank %}
          section-grid_no-text
        {% endif %}
      "
    >
      {%- if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      -%}
        <div class="section-top">
          {% render 'section-text', section: section, class: 'popular-products' %}
        </div>
      {% endif %}

      {%- if section.settings.enable_carousel -%}
        <div class="popular-products__navigation swiper-navigation no-js-hidden">
          <div class="popular-products__button-prev swiper-button-prev">
            {% render 'icon-caret-left' %}
          </div>
          <div class="popular-products__button-next swiper-button-next">
            {% render 'icon-caret-right' %}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.button_show -%}
        {% render 'button',
          link: section.settings.button_link,
          label: section.settings.button_label,
          style: section.settings.button_style,
          class: 'popular-products'
        %}
      {%- endif -%}

      <div
        class="
          content
          products--{{ section.settings.columns_mobile }}-mobile
          {% if section.settings.enable_carousel %}
            popular-products__slider swiper
          {% else %}
            popular-products__wrapper popular-products__wrapper--{{ section.settings.products_to_show }}
            popular-products--{{ section.settings.columns_mobile }}-mobile
            {% if section.settings.layout_columns and section.settings.enable_carousel == false and section.settings.products_to_show > 1 %} popular-products_col {% endif %}
            {% if section.settings.show_collection %} popular-products__wrapper_small-gap {% endif %}
          {% endif %}
        "
        data-columns="{{ section.settings.products_to_show }}"
      >
        {% if section.settings.enable_carousel %}
          <div class="swiper-wrapper">
        {% endif %}

        {% if section.settings.show_collection %}
          {% liquid
            assign aspect_ratio = section.settings.image_ratio | split: '/'
            assign temp = aspect_ratio[0] | append: '.0'
            assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
          %}
          <div
            class="
              popular-products__collection color-{{ section.settings.color_scheme_collection }} {% if section.settings.enable_carousel %} swiper-slide {% endif %}
              {% if section.settings.layout_columns and section.settings.enable_carousel == false and section.settings.products_to_show > 1 %} popular-products__collection--2-columns {% endif %}
            "
            style="--padding-bottom: {{ padding_bottom }}%"
          >
            {% liquid
              assign collection_image = section.settings.collection.featured_image

              if section.settings.image_collection
                assign collection_image = section.settings.image_collection
              endif
            %}
            <div
              class="popular-products__collection-image {% if section.settings.collection != blank -%} popular-products__collection-image_hover {% endif %}"
              style="--overlay-opacity: {{ section.settings.opacity_overlay }}"
            >
              {%- if collection_image != blank -%}
                {% assign columns = section.settings.products_to_show %}
                {% if section.settings.layout_columns
                  and section.settings.enable_carousel == false
                  and section.settings.products_to_show > 1
                %}
                  {%- capture sizes -%}
                      {% if columns >= 5 %}
                        (min-width: 1360px) calc(((100vw - 40px) / 5)*2),
                      {% endif %}
                      {% if columns >= 4 %}
                        (min-width: 1200px) calc(((100vw - 40px) / 4)*2),
                      {% endif %}
                      {% if columns >= 3 %}
                        (min-width: 990px) calc(((100vw - 40px) / 3)*2),
                      {% endif %}
                      {% if columns >= 2 %}
                        (min-width: 750px) calc(((100vw - 40px) / 2)*2),
                      {% endif %}
                      calc((100vw - 40px))
                    {%- endcapture -%}
                {% else %}
                  {%- capture sizes -%}
                      {% if columns >= 5 %}
                        (min-width: 1360px) calc((100vw - 40px) / 5),
                      {% endif %}
                      {% if columns >= 4 %}
                        (min-width: 1200px) calc((100vw - 40px) / 4),
                      {% endif %}
                      {% if columns >= 3 %}
                        (min-width: 990px) calc((100vw - 40px) / 3),
                      {% endif %}
                      {% if columns >= 2 %}
                        (min-width: 750px) calc((100vw - 40px) / 2),
                      {% endif %}
                      {% if section.settings.columns_mobile == "2" %}
                        calc((100vw - 40px) / 2)
                      {% else %}
                        calc((100vw - 40px))
                      {% endif %}
                    {%- endcapture -%}
                {% endif %}
                {{
                  collection_image
                  | image_url: width: 1100
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '180, 375, 425, 550, 750, 900, 1100',
                    class: 'popular-products__collection-image-image'
                }}
              {%- endif -%}
            </div>
            <div class="popular-products__collection-info">
              {% if section.settings.subheading_collection != blank %}
                <div class="popular-products__collection-subtitle subtitle">
                  {{ section.settings.subheading_collection }}
                </div>
              {% endif %}
              <div class="popular-products__collection-group">
                {% assign scheme = section.settings.color_scheme_collection %}
                {% if scheme.settings.color_accent != 'rgba(0,0,0,0)' %}
                  {% capture accent %} 
                      {{ scheme.settings.color_accent.red }},{{ scheme.settings.color_accent.green }},{{ scheme.settings.color_accent.blue }}
                    {% endcapture %}
                {% else %}
                  {% capture accent %} 
                      {{ scheme.settings.colors_text_title.red }},{{ scheme.settings.colors_text_title.green }},{{ scheme.settings.colors_text_title.blue }}
                    {% endcapture %}
                {% endif %}

                <{{ section.settings.collection_heading_tag | default: 'h3' }}
                  class="popular-products__collection-title h2 color-{{ section.settings.heading_color }}"
                  style="--accent: {{ accent }}"
                >
                  {% if section.settings.collection != blank %}
                    {{ section.settings.collection.title }}
                  {% else %}
                    {{- 'general.card.collection_name' | t -}}
                  {% endif %}
                </{{ section.settings.collection_heading_tag | default: 'h3' }}>
                {% if section.settings.show_desc_collection and section.settings.collection.description %}
                  <p class="popular-products__collection-desc">
                    {{ section.settings.collection.description | strip_html | truncatewords: 50, '...' }}
                  </p>
                {% endif %}
              </div>
            </div>
            {% if section.settings.collection != blank %}
              <a
                href="{{ section.settings.collection.url }}"
                class="popular-products__collection-link overlay-link"
                aria-label="{{ section.settings.collection.title }}"
              ></a>
            {% endif %}
          </div>
        {% endif %}

        {%- for product in section.settings.product_list -%}
          <div
            class="
              popular-products__item collection-product-card
              quickview{%- if settings.quickview_hover -%}--hover{% endif %}
              {% if section.settings.enable_carousel %} swiper-slide {% endif %}
            "
          >
            {% render 'product-card',
              product_card_product: product,
              media_ratio: section.settings.image_ratio,
              media_fit: section.settings.image_fit,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              show_desc: section.settings.show_desc,
              heading_tag: section.settings.card_heading_tag,
              section_id: section.id,
              add_id: forloop.index
            %}
          </div>
        {%- else -%}
          {% if section.settings.show_collection %}
            {% assign count = 3 %}
          {% elsif section.settings.enable_carousel %}
            {% assign count = 6 %}
          {% else %}
            {% assign count = 4 %}
          {% endif %}
          {%- for i in (1..count) -%}
            <div
              class="
                popular-products__item_placeholder collection-popular-card collection-popular-card--placeholder
                {% if section.settings.enable_carousel %} swiper-slide {% endif %}
              "
            >
              {% render 'product-card-placeholder',
                media_ratio: section.settings.image_ratio,
                show_vendor: section.settings.show_vendor,
                heading_tag: section.settings.card_heading_tag,
                product_number: forloop.index
              %}
            </div>
          {%- endfor -%}
        {%- endfor -%}
        {% if section.settings.enable_carousel %}
          </div>
          <div class="popular-products__pagination no-js-hidden swiper-pagination"></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% if section.settings.enable_carousel %}
  <script src="{{ 'popular-products.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "t:sections.popular-products.name",
  "tag": "section",
  "class": "popular-products-section spaced-section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
