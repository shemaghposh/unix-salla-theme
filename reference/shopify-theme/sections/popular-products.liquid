      "label": "t:sections.popular-products.settings.layout_columns.label",
      "info": "t:sections.popular-products.settings.layout_columns.info",
      "default": false
    },
    {
      "type": "text",
      "id": "subheading_collection",
      "label": "t:sections.all.subheading.label",
      "default": "t:sections.popular-products.settings.subheading_collection.default"
    },
    {
      "type": "select",
      "id": "heading_color",
      "options": [
