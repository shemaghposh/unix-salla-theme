    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.popular-products.settings.collection.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_collection",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
