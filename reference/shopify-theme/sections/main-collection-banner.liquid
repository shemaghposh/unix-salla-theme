{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="collection-hero color-{{ section.settings.color_scheme }} background">
  <div class="container">
    <div class="collection-hero__wrapper">
      <div class="collection-hero__text-wrapper">
        <div class="page-header">
          <div class="page-header__inner">
            <{{ section.settings.heading_tag | default: 'h1' }} class="collection-hero__title title--page h2">
              {% assign title = 'sections.collection_template.title' | t %}
                {% if title != blank %}
                  <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
                {% endif %}
              {{- collection.title | escape -}}
            </{{ section.settings.heading_tag | default: 'h1' }}>
          </div>
        </div>
        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="collection-hero__description body-large rte {% if settings.rte_type == 'custom' %} rte__container{% endif %}">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>

      {%- liquid
        assign collection_image = collection.image

        if section.settings.image != blank and collection.id != blank
          assign collection_image = section.settings.image
        endif

        if collection_image == blank and collection.id == blank
          assign collection_image = section.settings.image_products
        endif
      -%}
      {%- if section.settings.show_collection_image and collection_image -%}
        {% if section.settings.image_ratio == 'adapt' %}
          {% assign padding_bottom = 1 | divided_by: collection_image.aspect_ratio | times: 100 | round: 2 %}
        {% endif %}

        {% capture sizes %}
          100vw
        {% endcapture %}
        <div class="collection-hero__image-wrapper collection-hero__image-wrapper--{{ section.settings.image_ratio }} ">
          <div
            class="media"
            {% if section.settings.image_ratio == 'adapt' %}
              style="padding-bottom: {{ padding_bottom }}%"
            {% endif %}
          >
            {{
              collection_image
              | image_url: width: collection_image.width
              | image_tag: loading: 'lazy', widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920', sizes: sizes
            }}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "collection-banner-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.main-collection-banner.settings.color_scheme.label"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.main-collection-banner.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "small",
          "label": "t:sections.main-collection-banner.settings.image_ratio.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.main-collection-banner.settings.image_ratio.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.main-collection-banner.settings.image_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.main-collection-banner.settings.image_ratio.options__4.label"
        }
      ],
      "default": "small",
      "label": "t:sections.main-collection-banner.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label",
      "info": "t:sections.main-collection-banner.settings.show_collection_image.info"
    },
    {
      "type": "image_picker",
      "id": "image_products",
      "label": "t:sections.main-collection-banner.settings.image_products.label",
      "info": "t:sections.main-collection-banner.settings.image_products.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "xs",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "s",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ]
}
{% endschema %}
