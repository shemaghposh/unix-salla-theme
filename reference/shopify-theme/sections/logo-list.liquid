{{ 'section-logo-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div
  class="
    logo-list color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding
    {% if section.settings.enable_border %} section-border section-border-full {% endif %}
  "
  data-desktop-animation="{{ section.settings.enable_desktop_animate }}"
  data-repeat-desktop-animation="{{ section.settings.enable_repeat_desktop_animate }}"
>
  <div class="container">
    <div class="logo-list__top">
      {% render 'section-text', section: section, class: 'logo-list' %}

      {% if section.settings.enable_navigation %}
        <div class="logo-list__buttons no-js-hidden">
          <div class="swiper-button swiper-button-prev">
            {% render 'icon-caret-left' %}
          </div>
          <div class="swiper-button swiper-button-next">
            {% render 'icon-caret-right' %}
          </div>
        </div>
      {% endif %}
    </div>

    <div class="logo-list__content{% if section.blocks.size > 1 %} swiper js-slider-logos{% endif %}">
      <div class="logo-list__wrapper swiper-wrapper">
        {% for block in section.blocks %}
          {% liquid
            assign mobile_width = block.settings.mobile_image_width
            assign desktop_width = block.settings.desktop_image_width
            assign height = desktop_width | divided_by: block.settings.image_1.aspect_ratio | round: 2
            assign sizes = '(min-width: 1100px) 750, (min-width: 750px) 550, 275'
          %}

          <div
            class="logo-list__item swiper-slide"
            data-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {% style %}
              [data-id="{{ block.id }}"] .logo-list__image {
                width: {{ mobile_width }}px;
              }
              [data-id="{{ block.id }}"] .logo-list__placeholder {
                width: {{ mobile_width }}px;
              }
              /*{% if forloop.first %}
                [data-id="{{ block.id }}"] .logo-list__placeholder {
                  width: calc({{ mobile_width }}px + 32px);
                }
              {% endif %}*/

              @media screen and (min-width: 576px) {
                [data-id="{{ block.id }}"] .logo-list__image {
                  width: {{ desktop_width }}px;
                }
                [data-id="{{ block.id }}"] .logo-list__placeholder {
                  width: {{ desktop_width }}px;
                }
                /*{% if forloop.first %}
                  [data-id="{{ block.id }}"] .logo-list__placeholder {
                    width: calc({{ desktop_width }}px + 50px);
                  }
                {% endif %}*/
              }
            {% endstyle %}

            {%- if block.settings.logo_link != blank -%}
              <a
                href="{{ block.settings.logo_link }}"
                class="logo-list__item-link"
                {% if block.settings.new_tab_link %}
                  rel="nofollow"
                  target="_blank"
                {% endif %}
              >
            {%- endif -%}

            {% if block.settings.image_2 != blank or block.settings.image_1 != blank %}
              {% if block.settings.image_2 != blank %}
                {{
                  block.settings.image_2
                  | image_url: width: 710
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '275, 550, 750',
                    height: height,
                    width: desktop_width,
                    class: 'logo-list__image logo-list__image--dark'
                }}
              {% endif %}
              {% if block.settings.image_1 != blank %}
                {{
                  block.settings.image_1
                  | image_url: width: 710
                  | image_tag:
                    loading: 'lazy',
                    sizes: sizes,
                    widths: '275, 550, 750',
                    height: height,
                    width: desktop_width,
                    class: 'logo-list__image logo-list__image--light'
                }}
              {% endif %}
            {% else %}
              <div class="logo-list__placeholder">
                {{- 'sections.logo_list.placeholder' | t -}}
              </div>
            {% endif %}

            {%- if block.settings.logo_link != blank -%}
              </a>
            {%- endif -%}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'logo-list.js' | asset_url }}" defer="defer"></script>

{% schema %}
