          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.all.enable_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_navigation",
      "default": false,
      "label": "t:sections.all.slider.enable_navigation.label",
      "info": "t:sections.logo-list.settings.enable_navigation.info"
    },
    {
      "type": "header",
      "content": "t:sections.logo-list.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_desktop_animate",
      "default": true,
      "label": "t:sections.logo-list.settings.enable_desktop_animate.label"
    },
    {
      "type": "checkbox",
      "id": "enable_repeat_desktop_animate",
      "default": false,
      "label": "t:sections.logo-list.settings.enable_repeat_desktop_animate.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
