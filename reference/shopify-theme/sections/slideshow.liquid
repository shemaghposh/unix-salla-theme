{% if section.settings.layout == 'simple' %}
  {{ 'section-slideshow-simple.css' | asset_url | stylesheet_tag: preload: true }}
{% endif %}
{% if section.settings.layout == 'overlay' or section.settings.layout == 'grid' %}
  {{ 'section-slideshow-overlay-grid.css' | asset_url | stylesheet_tag: preload: true }}
{% endif %}
{% if section.settings.enable_content_animation %}
  {{ 'component-content-animation.css' | asset_url | stylesheet_tag: preload: true }}
{% endif %}

{% liquid
  assign is_header_overlay = false
  if section.index == 1 or section.index == null
    if section.settings.layout == 'overlay' or section.settings.layout == 'grid'
      if section.settings.header_overlay == true and section.settings.full_width
        assign is_header_overlay = true
      endif
    endif
  endif
%}

{% if is_header_overlay %}
  <script src="{{ 'header-overlay.js' | asset_url }}" async></script>
{% endif %}

{% style %}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{% endstyle %}

<div
  class="slideshow slideshow--{{ section.settings.layout }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
  data-layout="{{ section.settings.layout }}"
  data-autoplay="{{ section.settings.enable_autoplay }}"
  data-navigation="{{ section.settings.enable_navigation }}"
  data-pagination="{{ section.settings.enable_pagination }}"
  data-parallax="{{ section.settings.enable_parallax }}"
  data-enable-loop="{{ section.settings.enable_loop }}"
  data-slide-count="{{ section.blocks.size }}"
  {% if is_header_overlay %}
    data-header-overlay="true"
    data-color-scheme="{{ section.settings.color_scheme }}"
  {% endif %}
>
  <div class="slideshow__container{% if section.settings.full_width == false %} container{% endif %}">
    {%- if section.settings.layout == 'simple' -%}
      {% liquid
        assign no_media_all = true
        for block in section.blocks
          if block.settings.show_video and block.settings.desktop_video != blank
            assign no_media_all = false
            break
          elsif block.settings.show_video and block.settings.mobile_video != blank
            assign no_media_all = false
            break
          elsif block.settings.desktop_image != blank or block.settings.mobile_image != blank
            assign no_media_all = false
            break
          endif
        endfor
      %}

      <div class="slideshow__swiper--simple{% if section.settings.full_width == true %} slideshow__swiper--full-width{% endif %} slideshow__swiper--{{ section.settings.text_align_content }}{% if no_media_all %} slideshow__swiper--no-image{% endif %} slideshow__slide--{{ section.settings.mobile_height }}-mobile slideshow__slide--{{ section.settings.desktop_height }}-desktop">
        <div class="slideshow__swiper--text swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              <div
                class="swiper-slide slideshow__content-wrapper slideshow__content-wrapper--{{ section.settings.text_align_content }} color-{{ block.settings.color_scheme }}"
                data-swiper-autoplay="{{ section.settings.slide_duration | times: 1000 }}"
                data-color-scheme="color-{{ block.settings.color_scheme }}"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.subheading != blank
                  or block.settings.heading != blank
                  or block.settings.description != blank
                  or block.settings.show_button
                %}
                  <div class="slideshow__content-group">
                    {% if block.settings.subheading != blank %}
                      <div
                        class="slideshow__subheading-content"
                        {% if section.settings.enable_parallax %}
                          data-swiper-parallax="-100"
                        {% endif %}
                        {% if section.settings.enable_content_animation %}
                          data-content-animation="secondary"
                        {% endif %}
                      >
                        {{ block.settings.subheading }}
                      </div>
                    {% endif %}
                    {% if block.settings.heading != blank %}
                      <{{ block.settings.heading_tag | default: 'h2' }}
                        class="slideshow__title-content {{ block.settings.heading_size }}"
                        {% if section.settings.enable_parallax %}
                          data-swiper-parallax="-10"
                        {% endif %}
                        {% if section.settings.enable_content_animation %}
                          data-content-animation="primary"
                        {% endif %}
                      >
                        {{ block.settings.heading | newline_to_br }}
                      </{{ block.settings.heading_tag | default: 'h2' }}>
                    {% endif %}
                    {% if block.settings.description != blank %}
                      <div
                        class="slideshow__description-content body-large"
                        {% if section.settings.enable_parallax %}
                          data-swiper-parallax="-10"
                        {% endif %}
                        {% if section.settings.enable_content_animation %}
                          data-content-animation="primary"
                        {% endif %}
                      >
                        {{ block.settings.description | newline_to_br }}
                      </div>
                    {% endif %}
                    {%- if block.settings.show_button -%}
                      <div
                        class="slideshow__button-wrapper"
                        {% if section.settings.enable_parallax %}
                          data-swiper-parallax="-100"
                        {% endif %}
                        {% if section.settings.enable_content_animation %}
                          data-content-animation="secondary"
                        {% endif %}
                      >
                        {% render 'button',
                          link: block.settings.button_link,
                          label: block.settings.button_label,
                          style: block.settings.button_style,
                          class: 'slideshow'
                        %}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          {%- if section.blocks.size > 1 -%}
            <div class="slideshow__bottom no-js-hidden">
              {%- if section.settings.enable_navigation -%}
                <div class="slideshow__button-wrapper swiper-navigation_move">
                  <div class="slideshow__button-prev swiper-button-prev">
                    {% render 'icon-caret-left' %}
                  </div>
                </div>
              {%- endif -%}

              {%- if section.settings.enable_pagination -%}
                <div class="slideshow__pagination no-js-hidden swiper-pagination"></div>
              {%- endif -%}

              {%- if section.settings.enable_navigation -%}
                <div class="slideshow__button-wrapper swiper-navigation_move">
                  <div class="slideshow__button-next swiper-button-next">
                    {% render 'icon-caret-right' %}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <div class="slideshow__swiper--media swiper">
          <div class="swiper-wrapper">
            {% for block in section.blocks %}
              {% liquid
                if section.settings.desktop_height != 'adapt' and section.settings.desktop_height != 'full_height'
                  assign aspect_ratio = section.settings.desktop_height | split: '/'
                  assign temp = aspect_ratio[0] | append: '.0'
                  assign padding_bottom_desktop = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                elsif section.settings.desktop_height == 'adapt'
                  if block.settings.desktop_video != blank and block.settings.show_video
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_image != blank
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_video != blank and block.settings.show_video
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_image != blank
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                  else
                    assign padding_bottom_desktop = 0
                  endif
                else
                  assign padding_bottom_desktop = 0
                endif

                if section.settings.mobile_height != 'adapt' and section.settings.mobile_height != 'full_height'
                  assign aspect_ratio_mobile = section.settings.mobile_height | split: '/'
                  assign temp_mobile = aspect_ratio_mobile[0] | append: '.0'
                  assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp_mobile | times: 100 | round: 2
                elsif section.settings.mobile_height == 'adapt'
                  if block.settings.mobile_video != blank and block.settings.show_video
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_image != blank
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_video != blank and block.settings.show_video
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_image != blank
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                  else
                    assign padding_bottom_mobile = 0
                  endif
                else
                  assign padding_bottom_mobile = 0
                endif
              %}

              {% style %}
                #shopify-section-{{ section.id }} .media-{{ block.id }}.media::before {
                  content: "";
                  display: block;
                  padding-bottom: {{ padding_bottom_mobile }}%;
                }

                @media screen and (min-width: 576px) {
                  #shopify-section-{{ section.id }} .media-{{ block.id }}.media::before {
                    content: "";
                    display: block;
                    padding-bottom: {{ padding_bottom_desktop }}%;
                  }
                }
              {% endstyle %}

              <div
                class="swiper-slide media media-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {% liquid
                  if block.settings.desktop_image != blank and block.settings.mobile_image == blank
                    assign image = block.settings.desktop_image
                  elsif block.settings.desktop_image == blank and block.settings.mobile_image != blank
                    assign image = block.settings.mobile_image
                  elsif block.settings.desktop_image == blank and block.settings.mobile_image == blank
                    assign image = blank
                  elsif block.settings.desktop_image != blank and block.settings.mobile_image != blank
                    assign image = 1
                  endif

                  if block.settings.show_video
                    if block.settings.mobile_video == blank and block.settings.desktop_video != blank
                      assign video = block.settings.desktop_video
                    elsif block.settings.mobile_video != blank and block.settings.desktop_video == blank
                      assign video = block.settings.mobile_video
                    elsif block.settings.mobile_video == blank and block.settings.desktop_video == blank
                      assign video = blank
                    elsif block.settings.mobile_video != blank and block.settings.desktop_video != blank
                      assign video = 1
                    endif
                  endif
                %}
                {% capture sizes %}
                  (min-width: 1200px) 50vw, 100vw
                {% endcapture %}

                {% liquid
                  assign fetch_priority = 'auto'
                  if section.index == 1
                    assign fetch_priority = 'high'
                  endif
                %}

                {% if block.settings.show_video and video != blank %}
                  {% if video != 1 %}
                    <div class="slideshow__video">
                      {{
                        video
                        | video_tag: image_size: '1920x', autoplay: false, loop: true, muted: true, controls: false
                      }}
                    </div>
                  {% elsif video == 1 %}
                    {% liquid
                      assign desktop_video = block.settings.desktop_video
                      assign mobile_video = block.settings.mobile_video

                      if block.settings.show_video == true
                        assign desktop_source = desktop_video.sources[1].url
                        if desktop_source == blank
                          assign desktop_source = desktop_video.sources[0].url
                        endif

                        assign mobile_source = mobile_video.sources[1].url
                        if mobile_source == blank
                          assign mobile_source = mobile_video.sources[0].url
                        endif
                      endif
                    %}
                    <div class="slideshow__video">
                      <video
                        playsinline="playsinline"
                        loop="loop"
                        muted="muted"
                        preload="metadata"
                        class="js-dynamic-video"
                        data-url-mobile="{{mobile_source}}"
                        data-url-desktop="{{desktop_source}}"
                      ></video>
                    </div>
                  {% endif %}
                {% elsif image != blank and image != 1 %}
                  {%- if forloop.first %}
                    {{
                      image
                      | image_url: width: 1920
                      | image_tag:
                        widths: '375, 425, 576, 768, 1024, 1200, 1600, 1920',
                        sizes: sizes,
                        preload: true,
                        fetchpriority: fetch_priority
                    }}
                  {%- else -%}
                    {{
                      image
                      | image_url: width: 1920
                      | image_tag: loading: 'lazy', widths: '375, 425, 576, 768, 1024, 1200, 1600, 1920', sizes: sizes
                    }}
                  {%- endif -%}
                {% elsif image == 1 %}
                  {% assign desktop_image = block.settings.desktop_image %}
                  {% assign mobile_image = block.settings.mobile_image %}
                  <picture>
                    <source
                      srcset="{{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x, {{ mobile_image | image_url: width: 1125 }} 3x"
                      media="(max-width: 375px)"
                    >
                    <source
                      srcset="{{ mobile_image | image_url: width: 425 }} 1x, {{ mobile_image | image_url: width: 850 }} 2x, {{ mobile_image | image_url: width: 1125 }} 3x"
                      media="(max-width: 425px)"
                    >
                    <source
                      srcset="{{ mobile_image | image_url: width: 576 }} 1x, {{ mobile_image | image_url: width: 1152 }} 2x, {{ mobile_image | image_url: width: 1536 }} 3x"
                      media="(max-width: 576px)"
                    >
                    {%- if forloop.first %}
                      {{
                        desktop_image
                        | image_url: width: 1024
                        | image_tag:
                          class: 'slideshow__image',
                          widths: '375, 425, 576, 768, 1024',
                          sizes: '100vw',
                          fetch_priority: fetch_priority
                      }}
                    {%- else -%}
                      {{
                        desktop_image
                        | image_url: width: 1024
                        | image_tag:
                          class: 'slideshow__image',
                          widths: '375, 425, 576, 768, 1024',
                          sizes: '100vw',
                          loading: 'lazy',
                          fetch_priority: 'low'
                      }}
                    {%- endif -%}
                  </picture>
                {% else %}
                  {% assign placeholder_index = forloop.index0 | modulo: 3 | plus: 1 %}
                  {{ 'hero-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
    {%- elsif section.settings.layout == 'grid' or section.settings.layout == 'overlay' -%}
      <div class="slideshow__swiper slideshow__swiper--{{section.settings.layout}}{% if section.settings.full_width == true %} slideshow__swiper--full-width{% endif %} swiper slideshow__swiper--{{ section.settings.text_align_content }}">
        <div class="slideshow__wrapper swiper-wrapper">
          {% for block in section.blocks %}
            <div
              class="slideshow__slide slideshow__slide--{{section.settings.layout}} swiper-slide slideshow__slide--{{ section.settings.mobile_height }}-mobile slideshow__slide--{{ section.settings.desktop_height }}-desktop slideshow__slide-{{ block.id }} color-{{ block.settings.color_scheme }}"
              data-swiper-autoplay="{{ section.settings.slide_duration | times: 1000 }}"
              data-color-scheme="color-{{ block.settings.color_scheme }}"
              {{ block.shopify_attributes }}
            >
              {% liquid
                if section.settings.desktop_height != 'adapt' and section.settings.desktop_height != 'full_height'
                  assign aspect_ratio = section.settings.desktop_height | split: '/'
                  assign temp = aspect_ratio[0] | append: '.0'
                  assign padding_bottom_desktop = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
                elsif section.settings.desktop_height == 'adapt'
                  if block.settings.desktop_video != blank and block.settings.show_video
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_image != blank
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_video != blank and block.settings.show_video
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_image != blank
                    assign padding_bottom_desktop = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                  else
                    assign padding_bottom_desktop = 0
                  endif
                else
                  assign padding_bottom_desktop = 0
                endif

                if section.settings.mobile_height != 'adapt' and section.settings.mobile_height != 'full_height'
                  assign aspect_ratio_mobile = section.settings.mobile_height | split: '/'
                  assign temp_mobile = aspect_ratio_mobile[0] | append: '.0'
                  assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp_mobile | times: 100 | round: 2
                elsif section.settings.mobile_height == 'adapt'
                  if block.settings.mobile_video != blank and block.settings.show_video
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.mobile_image != blank
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_video != blank and block.settings.show_video
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                  elsif block.settings.desktop_image != blank
                    assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                  else
                    assign padding_bottom_mobile = 0
                  endif
                else
                  assign padding_bottom_mobile = 0
                endif
              %}

              {% style %}
                #shopify-section-{{ section.id }} .slideshow__slide-{{ block.id }}::before {
                  content: "";
                  display: block;
                  padding-bottom: {{ padding_bottom_mobile }}%;
                }

                @media screen and (min-width: 576px) {
                  #shopify-section-{{ section.id }} .slideshow__slide-{{ block.id }}::before {
                    content: "";
                    display: block;
                    padding-bottom: {{ padding_bottom_desktop }}%;
                  }
                }
              {% endstyle %}

              {% if block.settings.subheading != blank
                or block.settings.heading != blank
                or block.settings.description != blank
                or block.settings.show_button
              %}
                <div class="slideshow__content-container{% if section.settings.full_width %} container{% endif %}">
                  <div class="slideshow__content-wrapper slideshow__content-wrapper--{{ section.settings.text_align_content }}">
                    <div class="slideshow__content-group">
                      {% if block.settings.subheading != blank %}
                        <div
                          class="slideshow__subheading-content"
                          {% if section.settings.enable_parallax and section.settings.layout == 'overlay' %}
                            data-swiper-parallax="-1200"
                          {% endif %}
                          {% if section.settings.enable_content_animation %}
                            data-content-animation="secondary"
                          {% endif %}
                        >
                          {{ block.settings.subheading }}
                        </div>
                      {% endif %}
                      {% if block.settings.heading != blank %}
                        <h2
                          class="slideshow__title-content {{ block.settings.heading_size }}"
                          {% if section.settings.enable_parallax and section.settings.layout == 'overlay' %}
                            data-swiper-parallax="-800"
                          {% endif %}
                          {% if section.settings.enable_content_animation %}
                            data-content-animation="primary"
                          {% endif %}
                        >
                          {{ block.settings.heading | newline_to_br }}
                        </h2>
                      {% endif %}
                      {% if block.settings.description != blank %}
                        <div
                          class="slideshow__description-content body-large"
                          {% if section.settings.enable_parallax and section.settings.layout == 'overlay' %}
                            data-swiper-parallax="-800"
                          {% endif %}
                          {% if section.settings.enable_content_animation %}
                            data-content-animation="primary"
                          {% endif %}
                        >
                          {{ block.settings.description | newline_to_br }}
                        </div>
                      {% endif %}
                      {%- if block.settings.show_button -%}
                        <div
                          class="slideshow__button-wrapper"
                          {% if section.settings.enable_parallax and section.settings.layout == 'overlay' %}
                            data-swiper-parallax="-1200"
                          {% endif %}
                          {% if section.settings.enable_content_animation %}
                            data-content-animation="secondary"
                          {% endif %}
                        >
                          {% render 'button',
                            link: block.settings.button_link,
                            label: block.settings.button_label,
                            style: block.settings.button_style,
                            class: 'slideshow'
                          %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}

              <div class="media">
                <div
                  class="slideshow__overlay"
                  style="opacity: {{ block.settings.overlay_opacity }}"
                ></div>
                {% liquid
                  if block.settings.desktop_image != blank and block.settings.mobile_image == blank
                    assign image = block.settings.desktop_image
                  elsif block.settings.desktop_image == blank and block.settings.mobile_image != blank
                    assign image = block.settings.mobile_image
                  elsif block.settings.desktop_image == blank and block.settings.mobile_image == blank
                    assign image = blank
                  elsif block.settings.desktop_image != blank and block.settings.mobile_image != blank
                    assign image = 1
                  endif

                  if block.settings.show_video
                    if block.settings.mobile_video == blank and block.settings.desktop_video != blank
                      assign video = block.settings.desktop_video
                    elsif block.settings.mobile_video != blank and block.settings.desktop_video == blank
                      assign video = block.settings.mobile_video
                    elsif block.settings.mobile_video == blank and block.settings.desktop_video == blank
                      assign video = block.settings.mobile_video
                    elsif block.settings.mobile_video != blank and block.settings.desktop_video != blank
                      assign video = 1
                    endif
                  endif
                %}

                {% liquid
                  assign fetch_priority = 'auto'
                  if section.index == 1
                    assign fetch_priority = 'high'
                  endif
                %}
                {% if section.settings.layout == 'overlay' %}
                  {% capture sizes %}
                    calc(100vw - 40px)
                  {% endcapture %}

                  {% if block.settings.show_video and video != blank %}
                    {% if video != 1 %}
                      <div class="slideshow__video">
                        {{
                          video
                          | video_tag: image_size: '1920x', autoplay: false, loop: true, muted: true, controls: false
                        }}
                      </div>
                    {% elsif video == 1 %}
                      {% liquid
                        assign desktop_video = block.settings.desktop_video
                        assign mobile_video = block.settings.mobile_video

                        if block.settings.show_video == true
                          assign desktop_source = desktop_video.sources[1].url
                          if desktop_source == blank
                            assign desktop_source = desktop_video.sources[0].url
                          endif

                          assign mobile_source = mobile_video.sources[1].url
                          if mobile_source == blank
                            assign mobile_source = mobile_video.sources[0].url
                          endif
                        endif
                      %}
                      <div class="slideshow__video">
                        <video
                          playsinline="playsinline"
                          loop="loop"
                          muted="muted"
                          preload="metadata"
                          class="js-dynamic-video"
                          data-url-mobile="{{mobile_source}}"
                          data-url-desktop="{{desktop_source}}"
                        ></video>
                      </div>
                    {% endif %}
                  {% elsif image != blank and image != 1 %}
                    {% if forloop.first %}
                      {{
                        image
                        | image_url: width: 2500
                        | image_tag:
                          widths: '375, 412, 425, 576, 768, 1024, 1200, 1600, 1920, 2500',
                          sizes: sizes,
                          preload: true
                      }}
                    {% else %}
                      {{
                        image
                        | image_url: width: 2500
                        | image_tag:
                          loading: 'lazy',
                          widths: '375, 412, 425, 576, 768, 1024, 1200, 1600, 1920, 2500',
                          sizes: sizes
                      }}
                    {% endif %}
                  {% elsif image == 1 %}
                    {% assign desktop_image = block.settings.desktop_image %}
                    {% assign mobile_image = block.settings.mobile_image %}
                    <picture>
                      <source
                        srcset=" {{ desktop_image | image_url: width: 2000 }} 1x, {{ desktop_image | image_url: width: 4000 }} 2x, {{ desktop_image | image_url: width: 6000 }} 3x"
                        media="(min-width: 2000px)"
                        sizes="100vw - 40px"
                      >
                      <source
                        srcset=" {{ desktop_image | image_url: width: 1780 }} 1x, {{ desktop_image | image_url: width: 3560 }} 2x, {{ desktop_image | image_url: width: 5340 }} 3x"
                        media="(min-width: 1780px)"
                        sizes="100vw - 40px"
                      >
                      <source
                        srcset=" {{ desktop_image | image_url: width: 1500 }} 1x, {{ desktop_image | image_url: width: 3000 }} 2x, 	{{ desktop_image | image_url: width: 4500 }} 3x"
                        media="(min-width: 1500px)"
                        sizes="100vw - 40px"
                      >
                      <source
                        srcset=" {{ desktop_image | image_url: width: 1100 }} 1x, {{ desktop_image | image_url: width: 2200 }} 2x, {{ desktop_image | image_url: width: 3300 }} 3x"
                        media="(min-width: 1100px)"
                        sizes="100vw - 40px"
                      >
                      <source
                        srcset=" {{ desktop_image | image_url: width: 750 }} 1x, {{ desktop_image | image_url: width: 1500 }} 2x, {{ desktop_image | image_url: width: 2250 }} 3x"
                        media="(min-width: 750px)"
                        sizes="100vw - 40px"
                      >
                      <source
                        srcset=" {{ mobile_image | image_url: width: 575 }} 1x, {{ mobile_image | image_url: width: 1150 }} 2x, {{ mobile_image | image_url: width: 1725 }} 3x"
                        media="(min-width: 575px)"
                        sizes="100vw"
                      >
                      <source
                        srcset=" {{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x, {{ mobile_image | image_url: width: 1125 }} 3x"
                        media="(min-width: 375px)"
                        sizes="100vw"
                      >
                      {% if forloop.first %}
                        {{
                          mobile_image
                          | image_url: width: 768
                          | image_tag:
                            class: 'slideshow__image',
                            sizes: '100vw',
                            preload: true,
                            fetch_priority: fetch_priority
                        }}
                      {% else %}
                        {{
                          mobile_image
                          | image_url: width: 768
                          | image_tag: class: 'slideshow__image', sizes: '100vw', loading: 'lazy'
                        }}
                      {% endif %}
                    </picture>
                  {% endif %}
                {% else %}
                  {% capture sizes %}
                    40w
										(min-width: 1920px) 50vw, 100vw
                  {% endcapture %}

                  {% if block.settings.show_video and video != blank %}
                    {% if video != 1 %}
                      <div class="slideshow__video">
                        {{
                          video
                          | video_tag: image_size: '1920x', autoplay: false, loop: true, muted: true, controls: false
                        }}
                      </div>
                    {% elsif video == 1 %}
                      {% liquid
                        assign desktop_video = block.settings.desktop_video
                        assign mobile_video = block.settings.mobile_video

                        if block.settings.show_video == true
                          assign desktop_source = desktop_video.sources[1].url
                          if desktop_source == blank
                            assign desktop_source = desktop_video.sources[0].url
                          endif

                          assign mobile_source = mobile_video.sources[1].url
                          if mobile_source == blank
                            assign mobile_source = mobile_video.sources[0].url
                          endif
                        endif
                      %}
                      <div class="slideshow__video">
                        <video
                          playsinline="playsinline"
                          loop="loop"
                          muted="muted"
                          preload="metadata"
                          class="js-dynamic-video"
                          data-url-mobile="{{mobile_source}}"
                          data-url-desktop="{{desktop_source}}"
                        ></video>
                      </div>
                    {% endif %}
                  {% elsif image != blank and image != 1 %}
                    {% if forloop.first %}
                      {{
                        image
                        | image_url: width: 1000
                        | image_tag:
                          widths: '375, 425, 576, 768, 990, 1000',
                          sizes: '100vw',
                          preload: true,
                          fetch_priority: fetch_priority
                      }}
                    {% else %}
                      {{
                        image
                        | image_url: width: 1000
                        | image_tag: loading: 'lazy', widths: '375, 425, 576, 768, 990, 1000', sizes: '100vw'
                      }}
                    {% endif %}
                  {% elsif image == 1 %}
                    {% assign desktop_image = block.settings.desktop_image %}
                    {% assign mobile_image = block.settings.mobile_image %}
                    <picture>
                      <source
                        srcset=" {{ desktop_image | image_url: width: 1500 }} 1x, {{ desktop_image | image_url: width: 3000 }} 2x, {{ desktop_image | image_url: width: 4500 }} 3x"
                        media="(min-width: 2000px)"
                        sizes="40vw"
                      >
                      <source
                        srcset=" {{ desktop_image | image_url: width: 1100 }} 1x, {{ desktop_image | image_url: width: 2200 }} 2x, {{ desktop_image | image_url: width: 3300 }} 3x"
                        media="(min-width: 1100px)"
                        sizes="40vw"
                      >
                      <source
                        srcset=" {{ desktop_image | image_url: width: 750 }} 1x, {{ desktop_image | image_url: width: 1500 }} 2x, {{ desktop_image | image_url: width: 2250 }} 3x"
                        media="(min-width: 750px)"
                        sizes="100vw"
                      >
                      <source
                        srcset=" {{ mobile_image | image_url: width: 575 }} 1x, {{ mobile_image | image_url: width: 1150 }} 2x, {{ mobile_image | image_url: width: 1725 }} 3x"
                        media="(min-width: 575px)"
                        sizes="100vw"
                      >
                      <source
                        srcset=" {{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x, {{ mobile_image | image_url: width: 1125 }} 3x"
                        media="(min-width: 375px)"
                        sizes="100vw"
                      >

                      {% if forloop.first %}
                        {{
                          mobile_image
                          | image_url: width: 990
                          | image_tag: class: 'slideshow__image', sizes: '100vw', preload: true
                        }}
                      {% else %}
                        {{
                          mobile_image
                          | image_url: width: 990
                          | image_tag: class: 'slideshow__image', sizes: '100vw', loading: 'lazy'
                        }}
                      {% endif %}
                    </picture>
                  {% endif %}
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        {%- if section.settings.layout == 'overlay' and section.blocks.size > 1 -%}
          <div class="slideshow__bottom no-js-hidden">
            {%- if section.settings.enable_navigation -%}
              <div class="slideshow__button-wrapper swiper-navigation_move">
                <div class="slideshow__button-prev swiper-button-prev">
                  {% render 'icon-caret-left' %}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.enable_pagination -%}
              <div class="slideshow__pagination no-js-hidden swiper-pagination"></div>
            {%- endif -%}

            {%- if section.settings.enable_navigation -%}
              <div class="slideshow__button-wrapper swiper-navigation_move">
                <div class="slideshow__button-next swiper-button-next">
                  {% render 'icon-caret-right' %}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.layout == 'grid' and section.blocks.size > 1 -%}
          <div class="slideshow__navigation container no-js-hidden">
            {%- if section.settings.enable_navigation -%}
              <div class="slideshow__button-wrapper swiper-navigation_move">
                <div class="slideshow__button-prev swiper-button-prev">
                  {% render 'icon-caret-left' %}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.enable_navigation -%}
              <div class="slideshow__button-wrapper swiper-navigation_move">
                <div class="slideshow__button-next swiper-button-next">
                  {% render 'icon-caret-right' %}
                </div>
              </div>
            {%- endif -%}
          </div>

          <div class="slideshow__bottom no-js-hidden">
            {%- if section.settings.enable_pagination -%}
              <div class="slideshow__pagination no-js-hidden swiper-pagination"></div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script src="{{ 'slideshow.js' | asset_url }}" defer="defer"></script>

{% schema %}
