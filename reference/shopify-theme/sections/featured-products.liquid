{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

{% liquid
  assign aspect_ratio = section.settings.bg_image_ratio_desktop | split: '/'
  assign temp_desktop = aspect_ratio[0] | append: '.0'
  assign padding_bottom = aspect_ratio[1] | divided_by: temp_desktop | times: 100 | round: 2

  assign aspect_ratio_mobile = section.settings.bg_image_ratio_mobile | split: '/'
  assign temp_mobile = aspect_ratio_mobile[0] | append: '.0'
  assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp_mobile | times: 100 | round: 2
%}

<div class="featured-products color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="container">
    <div
      class="
        {% if section.settings.enable_carousel %} section-grid-slider section-grid-slider_nav {% endif %}
        section-grid
        {% if section.settings.subheading == blank and section.settings.heading == blank and section.settings.text == blank %}
          section-grid_no-text
        {% endif %}
      "
    >
      {%- if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      -%}
        <div class="section-top">
          {% render 'section-text', section: section, class: 'featured-products' %}
        </div>
      {% endif %}

      {%- if section.settings.enable_carousel -%}
        <div class="featured-products__navigation swiper-navigation no-js-hidden">
          <div class="featured-products__button-prev swiper-button-prev">
            {% render 'icon-caret-left' %}
          </div>
          <div class="featured-products__button-next swiper-button-next">
            {% render 'icon-caret-right' %}
          </div>
        </div>
      {%- endif -%}

      <div
        class="
          content
          {% if section.settings.enable_carousel or section.settings.swipe_on_mobile  %}
            featured-products__slider swiper
          {% endif %}
          {% if section.settings.swipe_on_mobile %}
            featured-products__slider_mobile
          {% endif %}
          featured-products__wrapper featured-products__wrapper--{{ section.settings.products_to_show }}
        "
        data-columns="{{ section.settings.products_to_show }}"
        data-slider-desktop="{{ section.settings.enable_carousel }}"
        data-slider-mobile="{{ section.settings.swipe_on_mobile }}"
      >
        {% if section.settings.enable_carousel or section.settings.swipe_on_mobile %}
          <div
            class="
              swiper-wrapper
              {% if section.settings.swipe_on_mobile == false %} featured-products__wrapper_mobile featured-products__wrapper_mobile--{{ section.settings.products_to_show }} {% else %} featured-products__wrapper_mobile-slider {% endif %}
              {% if section.settings.enable_carousel == false %} featured-products__wrapper_desktop featured-products__wrapper_desktop--{{ section.settings.products_to_show }} {% else %} featured-products__wrapper_desktop-slider {% endif %}
            "
          >
        {% endif %}

        {%- for block in section.blocks -%}
          {% assign product = block.settings.product %}
          <div
            class="
              featured-products__item collection-product-card
              quickview{%- if settings.quickview_hover -%}--hover{% endif %}
              {% if section.settings.enable_carousel or section.settings.swipe_on_mobile %} swiper-slide {% endif %}
              {% if section.settings.bg_image != 'none' %} featured-products__item_bg {% endif %}
              featured-products__item-{{ block.id }}
            "
            {{ block.shopify_attributes }}
          >
            <div class="featured-products__item-wrapper">
              {% liquid
                if block.settings.show_video
                  if block.settings.show_video_product
                    for media in product.media
                      if media.media_type == 'video'
                        assign video = media
                        break
                      endif
                    endfor
                  else
                    if block.settings.mobile_video == blank and block.settings.desktop_video != blank
                      assign video = block.settings.desktop_video
                    elsif block.settings.mobile_video != blank and block.settings.desktop_video == blank
                      assign video = block.settings.mobile_video
                    elsif block.settings.mobile_video == blank and block.settings.desktop_video == blank
                      assign video = blank
                    elsif block.settings.mobile_video != blank and block.settings.desktop_video != blank
                      assign video = 1
                    endif
                  endif
                endif
              %}

              {% if block.settings.show_video and video != blank %}
                {% liquid
                  if block.settings.show_video_product
                    if section.settings.bg_image_ratio_desktop == 'adapt'
                      assign padding_bottom = 1 | divided_by: video.aspect_ratio | times: 100 | round: 2
                    endif

                    if section.settings.bg_image_ratio_mobile == 'adapt'
                      assign padding_bottom_mobile = 1 | divided_by: video.aspect_ratio | times: 100 | round: 2
                    endif
                  else
                    if section.settings.bg_image_ratio_desktop == 'adapt' and block.settings.desktop_video != blank
                      assign padding_bottom = 1 | divided_by: block.settings.desktop_video.aspect_ratio | times: 100 | round: 2
                    elsif section.settings.bg_image_ratio_desktop == 'adapt' and block.settings.mobile_video != blank
                      assign padding_bottom = 1 | divided_by: video.aspect_ratio | times: 100 | round: 2
                    elsif section.settings.bg_image_ratio_desktop == 'adapt'
                      assign padding_bottom = 44
                    endif

                    if section.settings.bg_image_ratio_mobile == 'adapt' and block.settings.mobile_video != blank
                      assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_video.aspect_ratio | times: 100 | round: 2
                    elsif section.settings.bg_image_ratio_mobile == 'adapt' and block.settings.desktop_video != blank
                      assign padding_bottom_mobile = 1 | divided_by: video.aspect_ratio | times: 100 | round: 2
                    elsif section.settings.bg_image_ratio_mobile == 'adapt'
                      assign padding_bottom_mobile = 44
                    endif
                  endif
                %}

                {% if video != 1 %}
                  <div class="featured-products__item-video">
                    {{
                      video
                      | video_tag: image_size: '1920x', autoplay: false, loop: true, muted: true, controls: false
                    }}
                  </div>
                {% elsif video == 1 %}
                  {% liquid
                    assign desktop_video = block.settings.desktop_video
                    assign mobile_video = block.settings.mobile_video

                    if block.settings.show_video == true
                      assign desktop_source = desktop_video.sources[1].url
                      if desktop_source == blank
                        assign desktop_source = desktop_video.sources[0].url
                      endif

                      assign mobile_source = mobile_video.sources[1].url
                      if mobile_source == blank
                        assign mobile_source = mobile_video.sources[0].url
                      endif
                    endif
                  %}
                  <div class="featured-products__item-video">
                    <video
                      playsinline="playsinline"
                      loop="loop"
                      muted="muted"
                      preload="metadata"
                      class="js-dynamic-video"
                      data-url-mobile="{{mobile_source}}"
                      data-url-desktop="{{desktop_source}}"
                    ></video>
                  </div>
                {% endif %}
              {% elsif section.settings.bg_image != 'none' %}
                {% liquid
                  assign image = blank
                  case section.settings.bg_image
                    when 'image_first'
                      assign image = product.images[0]

                      if section.settings.bg_image_ratio_desktop == 'adapt' and image != blank
                        assign padding_bottom = 1 | divided_by: product.images[0].aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_desktop == 'adapt'
                        assign padding_bottom = 44
                      endif

                      if section.settings.bg_image_ratio_mobile == 'adapt' and image != blank
                        assign padding_bottom_mobile = 1 | divided_by: product.images[0].aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_mobile == 'adapt'
                        assign padding_bottom_mobile = 44
                      endif

                    when 'image_second'
                      if product.images[1] != blank
                        assign image = product.images[1]
                      else
                        assign image = product.images[0]
                      endif

                      if section.settings.bg_image_ratio_desktop == 'adapt' and image != blank
                        assign padding_bottom = 1 | divided_by: image.aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_desktop == 'adapt'
                        assign padding_bottom = 44
                      endif

                      if section.settings.bg_image_ratio_mobile == 'adapt' and image != blank
                        assign padding_bottom_mobile = 1 | divided_by: image.aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_mobile == 'adapt'
                        assign padding_bottom_mobile = 44
                      endif

                    when 'cover'
                      if section.settings.bg_image_ratio_desktop == 'adapt' and block.settings.desktop_image != blank
                        assign padding_bottom = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_desktop == 'adapt' and block.settings.mobile_image != blank
                        assign padding_bottom = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_desktop == 'adapt'
                        assign padding_bottom = 44
                      endif

                      if section.settings.bg_image_ratio_mobile == 'adapt' and block.settings.mobile_image != blank
                        assign padding_bottom_mobile = 1 | divided_by: block.settings.mobile_image.aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_mobile == 'adapt' and block.settings.desktop_image != blank
                        assign padding_bottom_mobile = 1 | divided_by: block.settings.desktop_image.aspect_ratio | times: 100 | round: 2
                      elsif section.settings.bg_image_ratio_mobile == 'adapt'
                        assign padding_bottom_mobile = 44
                      endif

                      if block.settings.desktop_image != blank and block.settings.mobile_image == blank
                        assign image = block.settings.desktop_image
                      elsif block.settings.desktop_image == blank and block.settings.mobile_image != blank
                        assign image = block.settings.mobile_image
                      elsif block.settings.desktop_image != blank and block.settings.mobile_image != blank
                        assign image = 1
                      endif
                  endcase
                %}

                {% if image != blank and image != 1 %}
                  <div class="featured-products__item-image">
                    {% liquid
                      assign calc_ratio_mobile = 1.1
                      if section.settings.bg_image_ratio_mobile != 'adapt'
                        assign settings_aspect_ratio_mobile = temp_mobile | divided_by: aspect_ratio_mobile[1]

                        if image.aspect_ratio > settings_aspect_ratio_mobile
                          assign calc_ratio_mobile = image.aspect_ratio | divided_by: settings_aspect_ratio_mobile | round: 2
                        endif
                      endif
                      assign calc_ratio_desktop = 1.1
                      if section.settings.bg_image_ratio_desktop != 'adapt'
                        assign settings_aspect_ratio_desktop = temp_desktop | divided_by: aspect_ratio[1]

                        if image.aspect_ratio > settings_aspect_ratio_desktop
                          assign calc_ratio_desktop = image.aspect_ratio | divided_by: settings_aspect_ratio_desktop | round: 2
                        endif
                      endif
                    %}
                    {% assign columns = section.settings.products_to_show %}
                    {%- capture sizes -%}
                      {%- if columns >= 5 -%}
                        (min-width: 1600px) calc((100vw / 5) * {{ calc_ratio_desktop }}),
                      {%- endif -%}
                      {%- if columns >= 4 -%}
                        (min-width: 1360px) calc((100vw / 4) * {{ calc_ratio_desktop }}),
                      {%- endif -%}
                      {%- if columns >= 3 -%}
                        (min-width: 1200px) calc((100vw / 3) * {{ calc_ratio_desktop }}),
                      {%- endif -%}
                      {%- if columns >= 2 -%}
                        (min-width: 750px) calc((100vw / 2) * {{ calc_ratio_desktop }}), (min-width: 576px) calc(100vw * {{ calc_ratio_desktop }}),
                      {%- endif -%}
                      {%- if columns == 1 -%}
                        (min-width: 576px) calc(100vw * {{ calc_ratio_desktop }})
                      {%- endif -%}
                      calc(100vw * {{ calc_ratio_mobile }})
                    {%- endcapture -%}
                    {{
                      image
                      | image_url: width: image.width
                      | image_tag:
                        loading: 'lazy',
                        widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920',
                        sizes: sizes
                    }}
                  </div>
                {% elsif image == 1 %}
                  {% assign desktop_image = block.settings.desktop_image %}
                  {% assign mobile_image = block.settings.mobile_image %}
                  {% liquid
                    assign calc_ratio_mobile = 1.1
                    if section.settings.bg_image_ratio_mobile != 'adapt'
                      assign settings_aspect_ratio_mobile = temp_mobile | divided_by: aspect_ratio_mobile[1]

                      if mobile_image.aspect_ratio > settings_aspect_ratio_mobile
                        assign calc_ratio_mobile = mobile_image.aspect_ratio | divided_by: settings_aspect_ratio_mobile | round: 2
                      endif
                    endif
                    assign calc_ratio_desktop = 1.1
                    if section.settings.bg_image_ratio_desktop != 'adapt'
                      assign settings_aspect_ratio_desktop = temp_desktop | divided_by: aspect_ratio[1]

                      if desktop_image.aspect_ratio > settings_aspect_ratio_desktop
                        assign calc_ratio_desktop = desktop_image.aspect_ratio | divided_by: settings_aspect_ratio_desktop | round: 2
                      endif
                    endif
                  %}
                  {% assign columns = section.settings.products_to_show %}
                  {%- capture sizes -%}
                    {%- if columns >= 5 -%}
                      (min-width: 1600px) calc((100vw / 5) * {{ calc_ratio_desktop }}),
                    {%- endif -%}
                    {%- if columns >= 4 -%}
                      (min-width: 1360px) calc((100vw / 4) * {{ calc_ratio_desktop }}),
                    {%- endif -%}
                    {%- if columns >= 3 -%}
                      (min-width: 1200px) calc((100vw / 3) * {{ calc_ratio_desktop }}),
                    {%- endif -%}
                    {%- if columns >= 2 -%}
                      (min-width: 750px) calc((100vw / 2) * {{ calc_ratio_desktop }}), (min-width: 576px) calc(100vw * {{ calc_ratio_desktop }}),
                    {%- endif -%}
                    {%- if columns == 1 -%}
                      (min-width: 576px) calc(100vw * {{ calc_ratio_desktop }})
                    {%- endif -%}
                    calc(100vw * {{ calc_ratio_mobile }})
                  {%- endcapture -%}

                  <picture class="featured-products__item-image">
                    <source
                      srcset="
                        {{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 425 }} 425w,
                        {{ mobile_image | image_url: width: 575 }} 575w,
                        {{ mobile_image | image_url: width: 750 }} 750w,
                        {{ mobile_image | image_url: width: 1125 }} 1125w,
                        {{ mobile_image | image_url: width: 1500 }} 1500w,
                        {{ mobile_image | image_url: width: 1875 }} 1875w
                      "
                      media="(max-width: 750px) and (-webkit-min-device-pixel-ratio: 1), (max-width: 750px) and (min-resolution: 1.5dppx), (max-width: 750px) and (min-resolution: 2dppx), (max-width: 750px) and (min-resolution: 3dppx) "
                    >
                    {{
                      desktop_image
                      | image_url: width: 1024
                      | image_tag:
                        widths: '375, 425, 576, 768, 1024, 1100, 1360, 1600, 1920',
                        loading: 'lazy',
                        sizes: sizes
                    }}
                  </picture>
                {% else %}
                  {% assign placeholder_index = forloop.index | modulo: 4 | plus: 1 %}
                  <div class="featured-products__item-image">
                    {{ 'product-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              {% endif %}

              {% style %}
                #shopify-section-{{ section.id }} .featured-products__item-{{ block.id }} {
                  --padding_bottom_bg: {{ padding_bottom_mobile }}%;
                }

                @media screen and (min-width: 576px) {
                  #shopify-section-{{ section.id }} .featured-products__item-{{ block.id }} {
                    --padding_bottom_bg: {{ padding_bottom }}%;
                  }
                }
              {% endstyle %}

              {% render 'product-card-horizontal',
                product_card_product: product,
                color_scheme: section.settings.card_color_scheme,
                media_ratio: section.settings.image_ratio,
                media_fit: section.settings.image_fit,
                show_vendor: section.settings.show_vendor,
                heading_tag: section.settings.card_heading_tag,
                section_id: section.id,
                forloop_index: forloop.index
              %}
            </div>
          </div>
        {%- endfor -%}
        {% if section.settings.enable_carousel or section.settings.swipe_on_mobile %}
          </div>
          <div class="featured-products__pagination no-js-hidden swiper-pagination"></div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'featured-products.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.featured-products.name",
  "tag": "section",
  "class": "featured-products-section spaced-section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.featured-products.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.featured-products.blocks.product.settings.product.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.featured-products.blocks.product.settings.mobile_image.label"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "t:sections.featured-products.blocks.product.settings.desktop_image.label"
        },
        {
          "type": "header",
          "content": "t:sections.all.video.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "show_video",
          "label": "t:sections.all.video.show_video.label",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_video_product",
          "label": "t:sections.featured-products.blocks.product.settings.show_video_product.label",
          "info": "t:sections.featured-products.blocks.product.settings.show_video_product.info",
          "default": false
        },
        {
          "type": "video",
          "id": "mobile_video",
          "label": "t:sections.all.mobile_video.label"
        },
        {
          "type": "video",
          "id": "desktop_video",
          "label": "t:sections.all.desktop_video.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.featured-products.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured-products.settings.products_to_show.label",
      "info": "t:sections.featured-products.settings.products_to_show.info"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "t:sections.featured-products.settings.swipe_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "t:sections.featured-products.settings.enable_carousel.label",
      "default": false
    },
    {
      "type": "select",
      "id": "bg_image",
      "options": [
        {
          "value": "none",
          "label": "t:sections.featured-products.settings.bg_image.options__1.label"
        },
        {
          "value": "image_first",
          "label": "t:sections.featured-products.settings.bg_image.options__2.label"
        },
        {
          "value": "image_second",
          "label": "t:sections.featured-products.settings.bg_image.options__3.label"
        },
        {
          "value": "cover",
          "label": "t:sections.featured-products.settings.bg_image.options__4.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.featured-products.settings.bg_image.label"
    },
    {
      "type": "select",
      "id": "bg_image_ratio_mobile",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.card.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.card.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.card.image_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.card.image_ratio.options__4.label"
        }
      ],
      "default": "3/4",
      "label": "t:sections.featured-products.settings.bg_image_ratio_mobile.label"
    },
    {
      "type": "select",
      "id": "bg_image_ratio_desktop",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.card.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.card.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.all.card.image_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.all.card.image_ratio.options__4.label"
        }
      ],
      "default": "1/1",
      "label": "t:sections.featured-products.settings.bg_image_ratio_desktop.label"
    },
    {
      "type": "header",
      "content": "t:sections.product-recommendations.settings.header__2.content"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "default": "background-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "3/4",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.all.card.show_vendor.label"
    },
    {
      "type": "select",
      "id": "card_heading_tag",
