{{ 'section-featured-collection.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

{% liquid
  assign image = blank
  if section.settings.desktop_image != blank and section.settings.mobile_image == blank
    assign desktop_image = section.settings.desktop_image
    if section.settings.collection.featured_image != blank
      assign mobile_image = section.settings.collection.featured_image
    else
      assign image = section.settings.desktop_image
    endif
  elsif section.settings.desktop_image == blank and section.settings.mobile_image != blank
    assign mobile_image = section.settings.mobile_image
    if section.settings.collection.featured_image != blank
      assign desktop_image = section.settings.collection.featured_image
    else
      assign image = section.settings.mobile_image
    endif
  elsif section.settings.desktop_image == blank and section.settings.mobile_image == blank
    if section.settings.collection.featured_image != blank
      assign image = section.settings.collection.featured_image
    endif
  elsif section.settings.desktop_image != blank and section.settings.mobile_image != blank
    assign desktop_image = section.settings.desktop_image
    assign mobile_image = section.settings.mobile_image
  endif

  if section.settings.mobile_aspect_ratio != 'adapt'
    assign aspect_ratio = section.settings.mobile_aspect_ratio | split: '/'
    assign temp = aspect_ratio[0] | append: '.0'
    assign mobile_padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
  elsif section.settings.mobile_aspect_ratio == 'adapt'
    if mobile_image != blank
      assign mobile_padding_bottom = 100 | divided_by: mobile_image.aspect_ratio | round: 2
    elsif image != blank
      assign mobile_padding_bottom = 100 | divided_by: image.aspect_ratio | round: 2
    else
      assign mobile_padding_bottom = 0
    endif
  endif

  if section.settings.desktop_aspect_ratio != 'adapt'
    assign aspect_ratio = section.settings.desktop_aspect_ratio | split: '/'
    assign temp = aspect_ratio[0] | append: '.0'
    assign desktop_padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
  elsif section.settings.desktop_aspect_ratio == 'adapt'
    if desktop_image != blank
      assign desktop_padding_bottom = 100 | divided_by: desktop_image.aspect_ratio | round: 2
    elsif image != blank
      assign desktop_padding_bottom = 100 | divided_by: image.aspect_ratio | round: 2
    else
      assign desktop_padding_bottom = 0
    endif
  endif
%}

<div class="featured-collection featured-collection--{{ section.settings.layout }} section-{{ section.id }}-padding">
  <div class="featured-collection__container container">
    <div
      class="featured-collection__wrapper color-{{ section.settings.color_scheme }}"
      style="--mobile-padding-bottom: {{ mobile_padding_bottom }}%; --desktop-padding-bottom: {{ desktop_padding_bottom }}%;"
    >
      <div class="featured-collection__media">
        {% if section.settings.layout == 'overlay' %}
          <div
            class="featured-collection__overlay"
            style="opacity: {{ section.settings.overlay_opacity }}"
          ></div>
        {% endif %}

        {%- capture sizes -%}
          {%- if section.settings.layout == "simple" -%}
            (min-width: 990px) calc(50vw - 20px), calc(100vw - 40px)
          {%- elsif section.settings.layout == "overlay" -%}
            calc(100vw - 40px)
          {%- endif -%}
        {%- endcapture -%}

        {% if image != blank %}
          {{
            image
            | image_url: width: image.width
            | image_tag: loading: 'lazy', widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920', sizes: sizes
          }}
        {% elsif mobile_image != blank and desktop_image != blank %}
          <picture>
            <source
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 425 }} 425w, {{ mobile_image | image_url: width: 575 }} 575w,
                {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 990 }} 990w
              "
              media="(max-width: 750px) "
            >
            {{
              desktop_image
              | image_url: width: desktop_image.width
              | image_tag: widths: '425, 576, 768, 1024, 1360, 1600, 1920', loading: 'lazy', sizes: sizes
            }}
          </picture>
        {% else %}
          {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
        {% endif %}
      </div>

      <div class="featured-collection__content">
        <div class="featured-collection__collection">
          {% if section.settings.subheading != blank or section.settings.heading != blank %}
            <div class="featured-collection__collection-info">
              {% if section.settings.subheading != blank %}
                <div class="featured-collection__subheading subtitle">
                  {{ section.settings.subheading }}
                </div>
              {% endif %}
              {% if section.settings.heading != blank %}
                {% if section.settings.heading_color == 'accent' %}
                  {% assign scheme = section.settings.color_scheme %}
                  {% if scheme.settings.color_accent != 'rgba(0,0,0,0)' %}
                    {% capture accent %}
                      {{ scheme.settings.color_accent.red }},{{ scheme.settings.color_accent.green }},{{ scheme.settings.color_accent.blue }}
                    {% endcapture %}
                  {% else %}
                    {% capture accent %}
                      {{ scheme.settings.colors_text_title.red }},{{ scheme.settings.colors_text_title.green }},{{ scheme.settings.colors_text_title.blue }}
                    {% endcapture %}
                  {% endif %}
                {% endif %}
                <{{ section.settings.heading_tag | default: 'h2' }}
                  class="featured-collection__heading {{ section.settings.heading_size }} color-{{ section.settings.heading_color }} {{scheme.settings.colors_text_title.red}}"
                  {% if section.settings.heading_color == 'accent' %}
                    style="--color-heading-accent: {{ accent }};"
                  {% endif %}
                >
                  {{ section.settings.heading | newline_to_br }}
                </{{ section.settings.heading_tag | default: 'h2' }}>
              {% endif %}
            </div>
          {% endif %}

          <div class="featured-collection__buttons no-js-hidden">
            <div class="swiper-button swiper-button-prev">
              {% render 'icon-caret-left' %}
            </div>
            <div class="swiper-button swiper-button-next">
              {% render 'icon-caret-right' %}
            </div>
          </div>

          <div class="featured-collection__collection-bottom">
            <div class="featured-collection__collection-slider swiper swiper--featured-collection">
              <div class="featured-collection__collection-wrapper swiper-wrapper">
                {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
                  {% for product in section.settings.collection.products %}
                    <div class="featured-collection__collection-item collection-product-card quickview{%- if settings.quickview_hover -%}--hover{% endif %} swiper-slide">
                      {% render 'product-card',
                        product_card_product: product,
                        media_ratio: section.settings.image_ratio,
                        media_fit: section.settings.image_fit,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_desc: section.settings.show_desc,
                        section_id: section.id,
                        add_id: forloop.index,
                        small: true,
                        heading_tag: section.settings.card_heading_tag
                      %}
                    </div>
                  {% endfor %}
                {% else %}
                  {%- for i in (1..6) -%}
                    <div class="featured-collection__collection-item swiper-slide">
                      {% render 'product-card-placeholder',
                        media_ratio: section.settings.image_ratio,
                        show_vendor: section.settings.show_vendor,
                        product_number: forloop.index,
                        heading_tag: section.settings.card_heading_tag
                      %}
                    </div>
                  {%- endfor -%}
                {% endif %}
              </div>

              <div class="featured-collection__pagination swiper-pagination"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'featured-collection.js' | asset_url }}" defer></script>

