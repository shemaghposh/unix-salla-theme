{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}
{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{%- if settings.pagination_type == 'load_more' or settings.pagination_type == 'infinite_scroll' -%}
  <script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.enable_featured_posts %}
  <script src="{{ 'main-blog.js' | asset_url }}" defer="defer"></script>
{% endif %}

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

{% liquid
  assign post_limit = section.settings.count_posts

  if post_limit <= blog.articles_count
    assign posts_exceed_limit = true
  endif

  assign limit_post = section.settings.count_posts
%}

{%- paginate blog.articles by section.settings.posts_per_page -%}
  <div class="main-blog section-{{ section.id }}-padding">
    <div class="container">
      <div class="page-header">
        <div class="page-header__inner">
          <{{ section.settings.heading_tag | default: 'h1' }} class="main-page-title page-title title--page h2">
            {{ blog.title | escape }}
          </{{ section.settings.heading_tag | default: 'h1' }}>
        </div>
        {% if section.settings.desc %}
          <p class="main-blog__desc body-large">{{ section.settings.desc }}</p>
        {% endif %}
      </div>

      {% if blog.articles_count > 0 %}
        <div class="main-blog__wrapper">
          {% if section.settings.enable_featured_posts %}
            <div class="main-blog__featured-articles">
              {% if section.settings.count_posts > 1
                and section.settings.post_layout == 'columns'
                or section.settings.featured_heading
              %}
                <div class="main-blog__featured-top">
                  {% if section.settings.featured_heading %}
                    <{{ section.settings.featured_heading_tag | default: 'h2' }} class="main-blog__featured-title h3">
                      {{ section.settings.featured_heading }}
                    </{{ section.settings.featured_heading_tag | default: 'h2' }}>
                  {% endif %}
                  {% if section.settings.count_posts > 1 and section.settings.post_layout == 'columns' %}
                    <div class="main-blog__navigation swiper-navigation no-js-hidden">
                      <div class="main-blog__button-prev swiper-button-prev">
                        {% render 'icon-caret-left' %}
                      </div>
                      <div class="main-blog__button-next swiper-button-next">
                        {% render 'icon-caret-right' %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
              {% if section.settings.post_layout == 'grid' %}
                <ul
                  class="
                    blog__posts blog__posts--{{ section.settings.post_layout }} articles-wrapper
                    {% if posts_exceed_limit %} blog__posts--{{ post_limit }}-items
                    {% else %} blog__posts--{{ blog.articles_count }}-items{% endif %}
                  "
                  style="
                    {% if posts_exceed_limit %} --posts: {{ post_limit | minus: 1 }}; --posts-xxl: {{ post_limit | minus: 1 | divided_by: 2.0 | ceil }};
                    {% else %} --posts: {{ blog.articles_count | minus: 1 }}; --posts-xxl: {{ blog.articles_count | minus: 1 | divided_by: 2.0 | ceil }}; {% endif %}
                  "
                  role="list"
                >
                  {%- for article in blog.articles limit: limit_post -%}
                    <li class="blog__post article">
                      {% if forloop.first %}
                        {% render 'article-card-overlay',
                          blog: blog,
                          article: article,
                          image_ratio: section.settings.featured_image_ratio,
                          show_image: section.settings.show_image_first,
                          show_tags: section.settings.show_tags_first,
                          show_date: section.settings.show_date_first,
                          show_author: section.settings.show_author_first,
                          show_excerpt: section.settings.show_excerpt_first,
                          heading_tag: section.settings.heading_tag_first,
                          section_author_image: section.settings.author_image,
                          color_scheme: section.settings.color_scheme_card
                        %}
                      {% else %}
                        {% render 'article-card-small',
                          blog: blog,
                          article: article,
                          image_ratio: section.settings.featured_image_ratio,
                          show_image: section.settings.featured_show_image,
                          show_tags: section.settings.featured_show_tags,
                          show_date: section.settings.featured_show_date,
                          show_author: section.settings.featured_show_author,
                          show_excerpt: section.settings.featured_show_excerpt,
                          heading_tag: section.settings.featured_blog_tag,
                          section_author_image: section.settings.author_image
                        %}
                      {% endif %}
                    </li>
                  {%- endfor -%}
                </ul>
              {% else %}
                <div
                  class="
                    blog__posts blog__posts--4 articles-wrapper
                    {% if posts_exceed_limit %} blog__posts--{{ post_limit }}-items
                    {% else %} blog__posts--{{ blog.articles_count }}-items{% endif %}
                    main-blog__slider swiper
                  "
                >
                  <div class="swiper-wrapper">
                    {%- for article in blog.articles limit: limit_post -%}
                      {% liquid
                        assign aspect_ratio_img = 100 | divided_by: article.image.aspect_ratio | round: 2
                        assign width_ratio = 1
                        if section.settings.featured_image_ratio == 'landscape'
                          if aspect_ratio_img < 75
                            assign width_ratio = 75.0 | divided_by: aspect_ratio_img | round: 2
                          endif
                        endif
                        if section.settings.featured_image_ratio == 'square'
                          if aspect_ratio_img < 100
                            assign width_ratio = 100.0 | divided_by: aspect_ratio_img | round: 2
                          endif
                        endif
                        if section.settings.featured_image_ratio == 'portrait'
                          if aspect_ratio_img < 133
                            assign width_ratio = 133.0 | divided_by: aspect_ratio_img | round: 2
                          endif
                        endif
                      %}
                      {% capture sizes %}
                          (min-width: 1200px) calc(((100vw - 40px) / 4) * {{ width_ratio }}), (min-width: 750px) calc(((100vw - 40px) / 3) * {{ width_ratio }}), (min-width: 576px) calc(((100vw - 40px) / 2) * {{ width_ratio }}), calc(((100vw - 40px)) * {{ width_ratio }})
                        {% endcapture %}
                      <div class="blog__post article swiper-slide">
                        {% render 'article-card',
                          blog: blog,
                          article: article,
                          image_ratio: section.settings.featured_image_ratio,
                          show_image: section.settings.featured_show_image,
                          show_tags: section.settings.featured_show_tags,
                          show_date: section.settings.featured_show_date,
                          show_author: section.settings.featured_show_author,
                          show_excerpt: section.settings.featured_show_excerpt,
                          heading_tag: section.settings.featured_blog_tag,
                          section_author_image: section.settings.author_image,
                          sizes: sizes
                        %}
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if section.settings.enable_featured_posts
            and section.settings.count_posts >= blog.articles.size
            and settings.pagination_type == 'pagination'
          %}
            {% assign count = section.settings.count_posts %}
          {% elsif section.settings.enable_featured_posts
            and section.settings.count_posts >= blog.articles.size
            and paginate.current_page == 1
          %}
            {% assign count = section.settings.count_posts %}
          {% endif %}

          {% unless count >= blog.articles.size %}
            <div class="main-blog__articles">
              {% if section.settings.archive_heading %}
                <h2 class="main-blog__title h3">
                  {{ section.settings.archive_heading }}
                </h2>
              {% endif %}
              <ul class=" blog-articles load-more-grid">
                {%- for article in blog.articles -%}
                  {% assign index = 0 %}
                  {% if section.settings.enable_featured_posts and settings.pagination_type == 'pagination' %}
                    {% assign index = section.settings.count_posts %}
                  {% elsif section.settings.enable_featured_posts and paginate.current_page == 1 %}
                    {% assign index = section.settings.count_posts %}
                  {% endif %}

                  {% if forloop.index > index %}
                    {% liquid
                      assign aspect_ratio_img = 100 | divided_by: article.image.aspect_ratio | round: 2
                      assign width_ratio = 1
                      if section.settings.image_ratio == 'landscape'
                        if aspect_ratio_img < 75
                          assign width_ratio = 75.0 | divided_by: aspect_ratio_img | round: 2
                        endif
                      endif
                      if section.settings.image_ratio == 'square'
                        if aspect_ratio_img < 100
                          assign width_ratio = 100.0 | divided_by: aspect_ratio_img | round: 2
                        endif
                      endif
                      if section.settings.image_ratio == 'portrait'
                        if aspect_ratio_img < 133
                          assign width_ratio = 133.0 | divided_by: aspect_ratio_img | round: 2
                        endif
                      endif
                    %}
                    {% capture sizes %}
                      (min-width: 1200px) calc(((100vw - 40px) / 4) * {{ width_ratio }}), (min-width: 750px) calc(((100vw - 40px) / 3) * {{ width_ratio }}), (min-width: 576px) calc(((100vw - 40px) / 2) * {{ width_ratio }}), calc(((100vw - 40px)) * {{ width_ratio }})
                    {% endcapture %}
                    <li class="blog-articles__article article">
                      {% render 'article-card',
                        blog: blog,
                        article: article,
                        image_ratio: section.settings.image_ratio,
                        show_image: section.settings.show_image,
                        show_tags: section.settings.show_tags,
                        show_date: section.settings.show_date,
                        show_author: section.settings.show_author,
                        show_excerpt: section.settings.show_excerpt,
                        heading_tag: section.settings.blog_heading_tag,
                        section_author_image: section.settings.author_image,
                        sizes: sizes
                      %}
                    </li>
                  {% endif %}
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                {%- if settings.pagination_type == 'load_more' -%}
                  {% render 'load-more',
                    next_url: paginate.next.url,
                    count_pages: paginate.pages,
                    current_page: paginate.current_page
                  %}
                  <div class="js-hidden">
                    {% render 'pagination', paginate: paginate %}
                  </div>
                {%- elsif settings.pagination_type == 'infinite_scroll' -%}
                  {% render 'infinite-scroll',
                    next_url: paginate.next.url,
                    count_pages: paginate.pages,
                    current_page: paginate.current_page
                  %}
                  <div class="js-hidden">
                    {% render 'pagination', paginate: paginate %}
                  </div>
                {% else %}
                  {% render 'pagination', paginate: paginate %}
                {%- endif -%}
              {%- endif -%}
            </div>
          {% endunless %}
        </div>
      {% endif %}
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
