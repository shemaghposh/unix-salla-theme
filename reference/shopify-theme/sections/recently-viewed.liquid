{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-products-grid.css' | asset_url | stylesheet_tag }}

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}

		.popular-products__wrapper {
			position: relative;
		}
		.recently-viewed__empty {
			display: none;
			width: 100%;
			align-items: center;
			justify-content: center;
		}
		.recently-viewed__empty span {
			max-width: 550px;
			text-align: center;
		}
		.recently-viewed--empty .recently-viewed__empty {
			display: flex;
		}
		.recently-viewed .loading-overlay {
			position: relative;
			inset: 0;
			z-index: 6;
			display: none;
			width: 100%;
			padding: 0 5rem;
		}
		.recently-viewed.recently-viewed--loading .loading-overlay {
			display: block;
		}
		.recently-viewed.recently-viewed--loading .loading-overlay .loading-overlay__spinner {
			top: 50%;
			transform: translateY(-50%);
		}
    .recently-viewed-loading .loading-overlay__spinner {
      width: 4rem;
      height: 4rem;
    }
    .recently-viewed-loading .loading-overlay__spinner svg {
      width: 4rem;
      height: 4rem;
    }

{%- endstyle -%}

<div class="products-grid section-{{ section.id }}-padding
 recently-viewed recently-viewed--loading {% if search.performed %} recently-viewed--search-perfomed{% endif %}"
 data-products-limit="{{ section.settings.products_limit }}"
 data-base-url="{{ routes.search_url }}?section_id={{ section.id }}&type=product"
{% if request.page_type == 'product' and product != blank %}
	data-current-page-product-id="{{ product.id }}"
{% endif %}
 >
  <div class="container">
    <div class="section-grid">
      {%- if section.settings.heading != blank
      -%}
        <div class="section-top">
          {% render 'section-text', section: section, class: 'products-grid' %}
        </div>
      {% endif %}
      <div class="products-grid full-width content">
				<div class="loading-overlay recently-viewed-loading">
					<div class="loading-overlay__spinner">
						{% render 'icon-loading' %}
					</div>
				</div>
				<div class="recently-viewed__empty body-large">
					<span class="body-large">{{- 'sections.recently_viewed.empty_message' | t -}}</span>
				</div>
        <ul
          id="products-grid"
          data-id="{{ section.id }}"
          class="
            collection-product-list
            collection-product-list--{{ section.settings.columns }}-items
            collection-product-list--{{ section.settings.columns_mobile }}-mobile
            products--{{ section.settings.columns_mobile }}-mobile
          "
        >
          {% liquid 
						paginate search.results by 50 
							assign product_list = search.results | where: 'object_type', 'product' 
						endpaginate
					%}

          {%- for product in product_list -%}
            <li class="collection-product-card {% if settings.quickview_hover %}quickview--hover{% endif %}">
              {% render 'product-card',
                product_card_product: product,
                media_ratio: section.settings.image_ratio,
                media_fit: section.settings.image_fit,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_desc: section.settings.show_desc,
                heading_tag: section.settings.card_heading_tag,
                columns: section.settings.columns,
                section_id: section.id,
                add_id: forloop.index
              %}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.recently-viewed.name",
  "tag": "section",
  "class": "recently-viewed-section products-grid-section",
	"limit": 1,
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
		{
			"type": "range",
			"id": "products_limit",
			"min": 1,
			"max": 50,
			"step": 1,
			"default": 6,
			"label": "t:sections.recently-viewed.settings.products_limit.label"
		},
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.products-grid.settings.columns.label"
    },
    {
      "type": "header",
      "content": "t:sections.products-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.products-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.products-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.products-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "3/4",
      "label": "t:sections.products-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "t:sections.products-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.products-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "default": false,
      "label": "t:sections.products-grid.settings.show_desc.label",
      "info": "t:sections.products-grid.settings.show_desc.info"
    },
    {
      "type": "select",
      "id": "card_heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.card.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "header",
      "content": "t:sections.products-grid.settings.header__4.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.recently-viewed.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "header",
      "content": "t:sections.products-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.products-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.products-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.products-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "s",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.recently-viewed.presets.name"
    }
  ]
}
{% endschema %}
