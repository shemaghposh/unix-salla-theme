{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{%- endstyle -%}

<div class="customer account section-{{ section.id }}-padding">
  <div class="container">
    <div class="account__inner">
      <div class="page-header">
        <div class="page-header__inner">
          <h1 class="main-page-title title--page h2">
            {{ 'customer.account.title_greeting' | t }}
          </h1>
        </div>
      </div>
      <a class="title-link button button--secondary" href="{{ routes.account_logout_url }}">
        <span>{{ 'customer.log_out' | t }}</span>
      </a>
      <div class="account__wrapper{% if customer.orders.size == 0 %} account__wrapper--empty{% endif %}">
        <div class="account__left">
          <h2 class="account__subtitle body-large">{{ 'customer.orders.title' | t }}</h2>
        </div>
        <div class="account__right">
          <h2 class="account__subtitle body-large">{{ 'customer.account.details' | t }}</h2>
        </div>
        <div class="account__left{% if customer.orders.size == 0 %} account__left--empty{% endif %}">
          {% paginate customer.orders by 20 %}
            {%- if customer.orders.size > 0 -%}
              <div class="order-table order-table--main">
                <div class="visually-hidden">{{ 'customer.orders.title' | t }}</div>
                <div class="row thead body-small">
                  <div id="ColumnOrder">{{ 'customer.orders.order_number' | t }}</div>
                  <div id="ColumnDate">{{ 'customer.orders.date' | t }}</div>
                  <div id="ColumnPayment">{{ 'customer.orders.payment_status' | t }}</div>
                  <div id="ColumnFulfillment">{{ 'customer.orders.fulfillment_status' | t }}</div>
                  <div id="ColumnTotal">{{ 'customer.orders.total' | t }}</div>
                </div>
                {%- for order in customer.orders -%}
                  <a
                    class="row tbody body-small"
                    href="{{ order.customer_url }}"
                    aria-label="{{ 'customer.orders.order_number_link' | t: number: order.name }}"
                  >
                    <span id="RowOrder" data-label="{{ 'customer.orders.order_number' | t }}">
                      {{ order.name }}
                    </span>
                    <span data-label="{{ 'customer.orders.date' | t }}">
                      {{ order.created_at | time_tag: format: 'date' }}
                    </span>
                    <span data-label="{{ 'customer.orders.payment_status' | t }}">
                      <span>
                        {{ order.financial_status_label }}
                      </span>
                    </span>
                    <span data-label="{{ 'customer.orders.fulfillment_status' | t }}">
                      {{ order.fulfillment_status_label }}
                    </span>
                    <span data-label="{{ 'customer.orders.total' | t }}">
                      {% if settings.currency_code_enabled %}
                        {{- order.total_price | money_with_currency -}}
                      {% else %}
                        {{- order.total_price | money -}}
                      {% endif %}
                    </span>
                  </a>
                {%- endfor -%}
              </div>
            {%- else -%}
              <div class="account-none">
                <div class="account-none__wrapper">
                  <div class="account-none__content">
                    {%- if section.settings.heading_orders != blank -%}
                      <h3>{{ section.settings.heading_orders | newline_to_br }}</h3>
                    {%- endif -%}
                    {%- if section.settings.text_orders != blank -%}
                      <div class="account-none__text body-small">
                        {{ section.settings.text_orders | newline_to_br }}
                      </div>
                    {%- endif -%}
                  </div>
                  <a
                    href="{{ routes.collections_url | sort_by: 'best-selling' }}"
                    class="button button--primary account-none__button"
                  >
                    <span>
                      {{ 'customer.account.account_button_shop' | t }}
                    </span>
                  </a>
                </div>
              </div>
            {%- endif -%}

            {%- if paginate.pages > 1 -%}
              {%- if paginate.parts.size > 0 -%}
                <nav
                  class="pagination customer__pagination"
                  role="navigation"
                  aria-label="{{ 'general.pagination.label' | t }}"
                >
                  <ul class="pagination__list list-unstyled" role="list">
                    {%- if paginate.previous -%}
                      <li>
                        <a
                          href="{{ paginate.previous.url }}"
                          class="pagination__item--prev pagination__item-arrow link motion-reduce"
                          aria-label="{{ 'general.pagination.previous' | t }}"
                        >
                          {% render 'icon-caret-left' %}
                        </a>
                      </li>
                    {%- endif -%}

                    {%- for part in paginate.parts -%}
                      <li>
                        {%- if part.is_link -%}
                          <a
                            href="{{ part.url }}"
                            class="pagination__item link"
                            aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                          >
                            {{- part.title -}}
                          </a>
                        {%- else -%}
                          {%- if part.title == paginate.current_page -%}
                            <span
                              aria-current="page"
                              class="pagination__item pagination__item--current"
                              aria-label="{{ 'general.pagination.page' | t: number: part.title }}"
                            >
                              {{- part.title -}}
                            </span>
                          {%- else -%}
                            <span class="pagination__item">{{ part.title }}</span>
                          {%- endif -%}
                        {%- endif -%}
                      </li>
                    {%- endfor -%}

                    {%- if paginate.next -%}
                      <li>
                        <a
                          href="{{ paginate.next.url }}"
                          class="pagination__item--next pagination__item-arrow link motion-reduce"
                          aria-label="{{ 'general.pagination.next' | t }}"
                        >
                          {% render 'icon-caret-right' %}
                        </a>
                      </li>
                    {%- endif -%}
                  </ul>
                </nav>
              {%- endif -%}
            {%- endif -%}
          {% endpaginate %}
        </div>
        <div class="account__right">
          {%- if customer.addresses_count > 0 -%}
            <div class="account-address">
              <ul class="account-address__list account-address__default list-unstyled">
                {%- if customer.default_address.name != blank -%}
                  <li class="account-address__item account-address__item-name body-normal">
                    {{ customer.default_address.name }}
                  </li>
                {%- endif -%}

                {%- if customer.default_address != blank -%}
                  <li class="body-small">
                    {%- if customer.default_address.street != blank -%}
                      <span class="account-address__item">
                        {{- customer.default_address.street -}}
                      </span>
                    {%- endif -%}

                    {%- if customer.default_address.company != blank -%}
                      <span class="account-address__item">
                        {{- customer.default_address.company -}}
                      </span>
                    {%- endif -%}

                    {%- if customer.default_address.city != blank -%}
                      <span class="account-address__item">{{ customer.default_address.city }}</span>
                    {%- endif -%}

                    {%- if customer.default_address.zip != blank -%}
                      <span class="account-address__item">{{ customer.default_address.zip }}</span>
                    {%- endif -%}

                    {%- if customer.default_address.phone != blank -%}
                      <span class="account-address__item">
                        {{- customer.default_address.phone -}}
                      </span>
                    {%- endif -%}

                    {%- if customer.default_address.country != blank -%}
                      <span class="account-address__item account-address__item-address">
                        {{- customer.default_address.country -}}
                      </span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              </ul>
              <a
                class="button button--primary account-address__link"
                href="{{ routes.account_addresses_url }}"
              >
                <span>
                  {{ 'customer.account.view_addresses' | t }}
                  ({{ customer.addresses_count }})
                </span>
              </a>
            </div>
          {%- else -%}
            <div class="account-none">
              <div class="account-none__wrapper">
                <div class="account-none__content">
                  {%- if section.settings.heading_addresses != blank -%}
                    <h3>{{ section.settings.heading_addresses | newline_to_br }}</h3>
                  {%- endif -%}
                  {%- if section.settings.text_addresses != blank -%}
                    <div class="account-none__text body-small">
                      {{ section.settings.text_addresses | newline_to_br }}
                    </div>
                  {%- endif -%}
                </div>
                <a
                  href="{{ routes.account_addresses_url }}"
                  class="button button--primary account-none__button account-none__button--address"
                >
                  <span>
                    {{ 'customer.addresses.add_new' | t }}
                  </span>
                </a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-account.settings.header_1.content"
    },
    {
      "type": "textarea",
      "id": "heading_orders",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.main-account.settings.heading_orders.default"
    },
    {
      "type": "textarea",
      "id": "text_orders",
      "label": "t:sections.all.text.label",
      "default": "t:sections.main-account.settings.text_orders.default"
    },
    {
      "type": "header",
      "content": "t:sections.main-account.settings.header_2.content"
    },
    {
      "type": "textarea",
      "id": "heading_addresses",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.main-account.settings.heading_addresses.default"
    },
    {
      "type": "textarea",
      "id": "text_addresses",
      "label": "t:sections.all.text.label",
      "default": "t:sections.main-account.settings.text_addresses.default"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "xs",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ]
}
{% endschema %}
