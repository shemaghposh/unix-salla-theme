{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-products-grid.css' | asset_url | stylesheet_tag }}

<script src="{{ 'products-grid.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

{% liquid
  assign grid_products = collections.all.products
  assign collection_handle = 'all'
	assign base_url = routes.all_products_collection_url
	assign total_shop_products = shop.products_count | default: 0
	
  if section.settings.collection != blank
		assign grid_products = section.settings.collection.products
		assign collection_handle = section.settings.collection.handle
		assign base_url = routes.collections_url | append: '/' | append: collection_handle
		assign total_shop_products = section.settings.collection.all_products_count
	endif

	if section.settings.product_list != blank
		assign grid_products = section.settings.product_list
		assign collection_handle = 'all'
		assign base_url = 'none'
		assign total_shop_products = section.settings.product_list.size
	endif

  assign sort = section.settings.sort
 
  case section.settings.sort
    when 'alphabetical'
      assign sort ='title-ascending'
    when 'alphabetical_reversed'
      assign sort ='title-descending'
    when 'products_high'
      assign sort ='price-descending'
    when 'products_low'
      assign sort ='price-ascending'
    when 'date'
      assign sort ='created-ascending'
    when 'date_reversed'
      assign sort ='created-descending'
    else
      assign sort = 'manual'
	endcase

	case sort
		when 'title-ascending', 'title-descending'
			assign grid_products = grid_products | sort: 'title'
		when 'price-descending', 'price-ascending'
			assign grid_products = grid_products | sort: 'price_min'
		when 'created-ascending', 'created-descending'
			assign grid_products = grid_products | sort: 'published_at'
    when 'manual'
      assign grid_products = grid_products | sort: 'manual'
    when 'best-selling'
      assign grid_products = grid_products | sort: 'manual'
  endcase

	if sort == 'price-descending' or sort == 'created-descending' or sort == 'title-descending'
		assign grid_products = grid_products | reverse
	endif

	assign is_dynamic_loading = false
  if total_shop_products > 50
    assign is_dynamic_loading = true
  elsif sort == 'manual' or sort == 'best-selling'
    if base_url != 'none'
      assign is_dynamic_loading = true
    endif
  endif.

	if is_dynamic_loading and base_url != 'none'
    assign sort_params = '?sort_by=' | append: sort
    # Using Section Rendering API https://shopify.dev/docs/api/ajax/section-rendering
    assign collection_url = base_url | append: sort_params | append: '&section_id=' | append: section.id
    assign grid_products = collection.products
  else
    assign collection_url = 'none'
  endif
%}

<div class="products-grid {% if is_dynamic_loading %} products-grid--loading{% if collection.products.size > 0 %} products-grid--search-perfomed{% endif %}{% endif %} section-{{ section.id }}-padding"
  data-collection-url="{{ collection_url }}"
	data-is-dynamic-load="{{ is_dynamic_loading }}"
>
  <div class="container">
    <div class="section-grid">
      {%- if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      -%}
        <div class="section-top">
          {% render 'section-text', section: section, class: 'products-grid' %}
        </div>
      {% endif %}
      {%- if section.settings.button_show -%}
        {% render 'button',
          link: btn_link,
          label: section.settings.button_label,
          style: section.settings.button_style,
          class: 'products-grid'
        %}
      {%- endif -%}
      <div class="products-grid full-width content">
        <ul
          id="products-grid"
          data-id="{{ section.id }}"
          class="
            collection-product-list
            collection-product-list--{{ section.settings.columns }}-items
            collection-product-list--{{ section.settings.columns_mobile }}-mobile
            products--{{ section.settings.columns_mobile }}-mobile
          "
        >
          {% if is_dynamic_loading == false or grid_products.size > 0 %}
            {%- for product in grid_products limit: section.settings.products_per_page -%}
              <li class="collection-product-card {% if settings.quickview_hover %}quickview--hover{% endif %}">
                {% render 'product-card',
                  product_card_product: product,
                  media_ratio: section.settings.image_ratio,
                  media_fit: section.settings.image_fit,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_desc: section.settings.show_desc,
                  heading_tag: section.settings.card_heading_tag,
                  columns: section.settings.columns,
                  section_id: section.id,
                  add_id: forloop.index
                %}
              </li>
            {%- endfor -%}
          {% else %}
            {%- for i in (1..4) -%}
              <div class="popular-products__item_placeholder collection-popular-card collection-popular-card--placeholder">
                {% render 'product-card-placeholder',
                  media_ratio: section.settings.image_ratio,
                  show_vendor: section.settings.show_vendor,
                  heading_tag: section.settings.card_heading_tag,
                  product_number: forloop.index
                %}
              </div>
            {%- endfor -%}
          {% endif %}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.products-grid.name",
  "tag": "section",
  "class": "products-grid-section",
  "disabled_on": {
    "templates": ["password"],
    "groups": ["*"]
  },
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.products-grid.settings.collection.label"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "t:sections.products-grid.settings.product_list.label",
      "info": "t:sections.products-grid.settings.product_list.info",
      "limit": 50
    },
    {
      "type": "paragraph",
      "content": "t:sections.products-grid.settings.text_about_products.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.products-grid.settings.text_about_dynamic.content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 12,
      "label": "t:sections.products-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.products-grid.settings.columns.label"
    },
		{
			"type": "select",
			"id": "sort",
			"options": [
				{
					"value": "alphabetical",
					"label": "t:sections.products-grid.settings.sort.options__1.label"
				},
				{
					"value": "alphabetical_reversed",
					"label": "t:sections.products-grid.settings.sort.options__2.label"
				},
				{
					"value": "date_reversed",
					"label": "t:sections.products-grid.settings.sort.options__3.label"
				},
				{
					"value": "date",
					"label": "t:sections.products-grid.settings.sort.options__4.label"
				},
				{
					"value": "products_high",
					"label": "t:sections.products-grid.settings.sort.options__5.label"
				},
				{
					"value": "products_low",
					"label": "t:sections.products-grid.settings.sort.options__6.label"
				},
        {
          "value": "manual",
          "label": "t:sections.products-grid.settings.sort.options__7.label"
        },
        {
          "value": "best-selling",
          "label": "t:sections.products-grid.settings.sort.options__8.label"
        }
			],
			"default": "alphabetical",
			"label": "t:sections.products-grid.settings.sort.label",
			"info": "t:sections.products-grid.settings.sort.info"
		},
    {
      "type": "header",
      "content": "t:sections.products-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.products-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.products-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.products-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "3/4",
      "label": "t:sections.products-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "t:sections.products-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.products-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "default": false,
      "label": "t:sections.products-grid.settings.show_desc.label",
      "info": "t:sections.products-grid.settings.show_desc.info"
    },
    {
      "type": "select",
      "id": "card_heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.card.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "header",
      "content": "t:sections.products-grid.settings.header__4.content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.products-grid.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "checkbox",
      "id": "button_show",
      "default": true,
      "label": "t:sections.all.button.button_show.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button.button_label.label",
      "default": "t:sections.products-grid.settings.button_label.default"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "secondary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.button_link.label",
      "info": "t:sections.products-grid.settings.button_link.info"
    },
    {
      "type": "header",
      "content": "t:sections.products-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.products-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.products-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.products-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
