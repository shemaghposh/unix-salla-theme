{{ 'section-video-banner.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-margin' %}
{% endstyle %}

{% liquid
  assign aspect_ratio = section.settings.desktop_media_ratio | split: '/'
  assign temp = aspect_ratio[0] | append: '.0'
  assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2

  assign aspect_ratio_mobile = section.settings.mobile_media_ratio | split: '/'
  assign temp = aspect_ratio_mobile[0] | append: '.0'
  assign padding_bottom_mobile = aspect_ratio_mobile[1] | divided_by: temp | times: 100 | round: 2
%}

<div class="video-banner {% if section.settings.full_width %}{% else %}container{% endif %}">
  <div
    id="Banner-{{ section.id }}"
    class="
      banner video--overlay
      {% if section.settings.full_width %}banner--container{% endif %}
      {%- if section.settings.video == blank -%} banner--no-video {% endif %}
      color-{{ section.settings.color_scheme }}
    "
  >
    <div class="video-banner__content video-banner__content--mobile-{{ section.settings.mobile_layout }}">
      {% liquid
        if section.settings.mobile_video == blank and section.settings.desktop_video != blank
          assign video = section.settings.desktop_video
        elsif section.settings.mobile_video != blank and section.settings.desktop_video == blank
          assign video = section.settings.mobile_video
        elsif section.settings.mobile_video == blank and section.settings.desktop_video == blank
          assign video = blank
        elsif section.settings.mobile_video != blank and section.settings.desktop_video != blank
          assign video = 1
        endif
      %}

      {% if video != blank %}
        <div class="banner__media media banner__media--{{- section.settings.video_fit -}}">
          {% liquid
            if section.settings.desktop_media_ratio == 'adapt' and section.settings.desktop_video != blank
              assign padding_bottom = 1 | divided_by: section.settings.desktop_video.aspect_ratio | times: 100 | round: 2
            elsif section.settings.desktop_media_ratio == 'adapt' and section.settings.mobile_video != blank
              assign padding_bottom = 1 | divided_by: video.aspect_ratio | times: 100 | round: 2
            elsif section.settings.desktop_media_ratio == 'adapt'
              assign padding_bottom = 44
            endif

            if section.settings.mobile_media_ratio == 'adapt' and section.settings.mobile_video != blank
              assign padding_bottom_mobile = 1 | divided_by: section.settings.mobile_video.aspect_ratio | times: 100 | round: 2
            elsif section.settings.mobile_media_ratio == 'adapt' and section.settings.desktop_video != blank
              assign padding_bottom_mobile = 1 | divided_by: video.aspect_ratio | times: 100 | round: 2
            elsif section.settings.mobile_media_ratio == 'adapt'
              assign padding_bottom_mobile = 44
            endif
          %}

          {% if video != 1 %}
            {{
              video
              | video_tag:
                class: 'banner__media__video',
                image_size: '1920x',
                autoplay: true,
                loop: true,
                controls: false,
                muted: true
            }}
          {% elsif video == 1 %}
            {% liquid
              assign desktop_video = section.settings.desktop_video
              assign mobile_video = section.settings.mobile_video

              assign desktop_source = desktop_video.sources[1].url
              if desktop_source == blank
                assign desktop_source = desktop_video.sources[0].url
              endif

              assign mobile_source = mobile_video.sources[1].url
              if mobile_source == blank
                assign mobile_source = mobile_video.sources[0].url
              endif
            %}
            <video
              playsinline="playsinline"
              loop="loop"
              muted="muted"
              preload="metadata"
              class="js-dynamic-video"
              data-url-mobile="{{mobile_source}}"
              data-url-desktop="{{desktop_source}}"
            ></video>
          {% endif %}
          <span
            class="banner__overlay"
            style="background-color: rgba(var(--color-overlay), {{ section.settings.opacity_overlay }});"
          ></span>
        </div>

        {% style %}
          {% if section.settings.mobile_layout == 'column' %}
            #shopify-section-{{ section.id }} .video-banner .banner__media {
              padding-bottom: {{ padding_bottom_mobile }}%;
            }

            @media screen and (min-width: 576px) {
              #shopify-section-{{ section.id }} .video-banner .banner__media {
                padding-bottom: {{ padding_bottom }}%;
              }
            }

            @media screen and (min-width: 750px) {
              #shopify-section-{{ section.id }} .video-banner__content::before {
                padding-bottom: {{ padding_bottom }}%;
              }
            }
          {% else %}
            #shopify-section-{{ section.id }} .video-banner__content::before {
              padding-bottom: {{ padding_bottom_mobile }}%;
            }

            @media screen and (min-width: 576px) {
              #shopify-section-{{ section.id }} .video-banner__content::before {
                padding-bottom: {{ padding_bottom }}%;
              }
            }
          {% endif %}
        {% endstyle %}
      {% endif %}

      <div class="video-banner__wrapper {% if section.settings.text_align != 'left' %}video-banner__column--center{% endif %}">
        {% if section.settings.full_width %}
          <div class="container">
        {% endif %}
        <div class="video-banner__column">
          {% render 'section-text', section: section, class: 'video-banner', text_align: section.settings.text_align %}
          {%- if section.settings.show_button -%}
            {% render 'button',
              link: section.settings.button_link,
              label: section.settings.button_label,
              style: section.settings.button_style,
              class: 'video-banner'
            %}
          {% endif %}
        </div>
        {% if section.settings.full_width %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.video-banner.name",
  "tag": "section",
  "class": "video-banner-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "t:sections.video-banner.settings.mobile_layout.label",
      "options": [
        {
          "value": "overlay",
          "label": "t:sections.video-banner.settings.mobile_layout.options__1.label"
        },
        {
          "value": "column",
          "label": "t:sections.video-banner.settings.mobile_layout.options__2.label"
        }
      ],
      "default": "overlay"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": false,
      "label": "t:sections.video-banner.settings.full_width.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.video-banner.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "t:sections.video-banner.settings.text.default"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.video-banner.settings.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.video-banner.settings.text_align.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.video-banner.settings.text_align.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "default": true,
      "label": "t:sections.all.button.button_show.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.all.button.button_label.label",
      "default": "t:sections.video-banner.settings.button_label.default"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "secondary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.all.button.button_link.label"
    },
    {
