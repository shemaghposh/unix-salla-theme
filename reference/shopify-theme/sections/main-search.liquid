{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}
{{ 'template-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  {% if section.settings.filter_type == 'vertical' %}
    <script src="{{ 'product-grid.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
-%}

<div class="section-{{ section.id }}-padding template-search {% if search.performed == true and search.results_count == 0 and terms != blank %} template-search--empty {% endif %}">
  <div class="template-search__header {% if search.performed != true %}template-search__header--empty{% endif %}">
    <div class="container">
      <div class="page-header">
        <div class="page-header__inner">
          {%- if search.performed -%}
            <h1 class="main-page-title page-title title--page h2">{{ 'templates.search.title' | t }}: {{ terms }}</h1>
          {%- else -%}
            <h1 class="main-page-title page-title title--page h2">
              {{ 'general.search.search' | t }}
            </h1>
          {%- endif -%}
        </div>
      </div>
      <div class="template-search__search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- endif -%}
        {%- if search.performed and search.results_count == 0 and search.filters == empty -%}
          <div class="search-wrapper">
        {% endif %}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search">
          {% if search.results_count > 0 %}
            <p class="search__form-text body-large">
              {{- 'templates.search.results_count' | t: count: search.results_count -}}
            </p>
          {% endif %}
          {%- if search.performed and search.results_count == 0 and search.filters == empty -%}
            <p class="search__form-text body-large" role="status">
              {{ 'templates.search.no_results' | t: terms: search.terms }}
            </p>
          {%- endif -%}
          <div class="search__form-inner">
            <div class="field color-background-1">
              <div class="search__icon">
                {% render 'icon-search' %}
              </div>
              <input
                dir="ltr"
                class="search__input field__input"
                id="Search-In-Template"
                type="search"
                name="q"
                value="{{ search.terms | escape }}"
                placeholder="{{ 'general.search.placeholder' | t }}"
                {%- if settings.predictive_search_enabled -%}
                  role="combobox"
                  aria-expanded="false"
                  aria-owns="predictive-search-results-list"
                  aria-controls="predictive-search-results-list"
                  aria-haspopup="listbox"
                  aria-autocomplete="list"
                  autocorrect="off"
                  autocomplete="off"
                  autocapitalize="off"
                  spellcheck="false"
                {%- endif -%}
              >
              <label class="visually-hidden" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
              <input name="options[prefix]" type="hidden" value="last">

              <button class="button button--primary focus-inset" aria-label="{{ 'general.search.search' | t }}">
                <span>
                  {{ 'general.search.search' | t }}
                </span>
              </button>
            </div>
          </div>
          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
              <div class="predictive-search__loading-state">
                <div class="spinner"></div>
              </div>
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if search.performed and search.results_count == 0 and search.filters == empty -%}
          </div>
        {% endif %}
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if search.performed and search.results_count > 0 -%}
    {% liquid
      assign filter_show = false
      for filter in search.filters
        if filter.range_max != 0
          assign filter_show = true
        endif
      endfor
    %}
    <div class="container">
      <div
        class="
          collection-wrapper collection-wrapper--4
          collection-wrapper--{{ section.settings.filter_type }}
          {%- if section.settings.enable_filtering == false and section.settings.enable_sorting == false -%} collection-wrapper_no-facets {% endif %}
          {%- if filter_show == false and section.settings.enable_sorting == false -%} collection-wrapper_no-facets {% endif %}
        "
      >
        <div class="products-grid__overlay"></div>
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            {% assign filter = section.settings.hor_filter | strip %}
            {% render 'facets',
              results: search,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: section.settings.filter_type,
              hor_filter: filter,
              image_filter_ratio: section.settings.image_filter_ratio,
              image_filter_fit: section.settings.image_filter_fit,
              image_filter_columns: section.settings.image_filter_columns
            %}
          {%- endif -%}
        {%- endif -%}

        <div
          id="ProductGridContainer"
          class="
            products-grid
            {% if section.settings.filter_type != 'vertical' %} full-width {% endif %}
            {% if section.settings.enable_filtering == false or filter_show == false %} products-grid_no-filter {%- endif -%}
          "
        >
          {% paginate search.results by 24 %}
            {%- if search.results.size == 0 and search.filters != empty -%}
              <div
                class="template-search__results collection collection-product"
                id="product-grid"
                data-id="{{ section.id }}"
              >
                <div class="loading-overlay">
                  <div class="loading-overlay__spinner">
                    <div class="spinner"></div>
                  </div>
                </div>
                <div class="title-wrapper center title-wrapper-empty">
                  <h2 class="title title--primary">
                    {{ 'sections.collection_template.empty_results' | t }}
                    <br>
                    {{
                      'sections.collection_template.results_use_fewer_filters_html'
                      | t: link: search_url, class: 'underlined-link link'
                    }}
                  </h2>
                </div>
              </div>
            {%- else -%}
              <div
                class="template-search__results collection collection-product"
                id="product-grid"
                data-id="{{ section.id }}"
              >
                <div class="loading-overlay">
                  <div class="loading-overlay__spinner">
                    <div class="spinner"></div>
                  </div>
                </div>

                {% liquid
                  assign search_products = search.results | where: 'object_type', 'product'
                  assign search_products_size = search_products | size
                  assign search_articles = search.results | where: 'object_type', 'article'
                  assign search_articles_size = search_articles | size
                  assign search_pages = search.results | where: 'object_type', 'page'
                  assign search_pages_size = search_pages | size
                %}

                {% if search_products_size != 0 %}
                  <div class="search-results__top first">
                    <h3 class="search-results__title">
                      {{ 'templates.search.item_count.other' | t: count: '' }}
                    </h3>
                  </div>
                  <ul
                    class="
                      collection-product-list collection-product-list--4-items
                      collection-product-list--{{ section.settings.columns_mobile }}-mobile
                      {% if section.settings.enable_filtering %} collection-results_filters {% endif %}
                    "
                    role="list"
                  >
                    {%- for item in search_products -%}
                      <li class="collection-product-card collection-product-card--small template-search__item {% if settings.quickview_hover %}quickview--hover{% endif %}">
                        {% render 'product-card',
                          product_card_product: item,
                          media_ratio: section.settings.image_ratio,
                          media_fit: section.settings.image_fit,
                          show_secondary_image: section.settings.show_secondary_image,
                          show_vendor: section.settings.show_vendor,
                          show_desc: section.settings.show_desc,
                          columns: 4,
                          section_id: section.id
                        %}
                      </li>
                    {%- endfor -%}
                  </ul>
                {% endif %}

                {% if search_articles_size != 0 %}
                  <div class="search-results__top {% if search_products_size == 0 %} first {% endif %}">
                    <h3 class="search-results__title">
                      {{ 'templates.search.article_count.other' | t: count: '' }}
                    </h3>
                  </div>
                  <ul
                    class="
                      collection-results collection-results--articles
                      collection-results--{{ section.settings.columns_mobile }}-mobile
                      {% if section.settings.enable_filtering == false or filter_show == false %} collection-results_no-filter {%- endif -%}
                    "
                    role="list"
                  >
                    {%- for item in search_articles -%}
                      {%- case item.object_type -%}
                        {%- when 'article' -%}
                          <li class="template-search__item article">
                            {% liquid
                              assign aspect_ratio_img = 100 | divided_by: item.image.aspect_ratio | round: 2
                              assign width_ratio = 1
                              if section.settings.article_image_ratio == 'landscape'
                                if aspect_ratio_img < 75
                                  assign width_ratio = 75.0 | divided_by: aspect_ratio_img | round: 2
                                endif
                              endif
                              if section.settings.article_image_ratio == 'square'
                                if aspect_ratio_img < 100
                                  assign width_ratio = 100.0 | divided_by: aspect_ratio_img | round: 2
                                endif
                              endif
                              if section.settings.article_image_ratio == 'portrait'
                                if aspect_ratio_img < 133
                                  assign width_ratio = 133.0 | divided_by: aspect_ratio_img | round: 2
                                endif
                              endif
                            %}
                            {% capture sizes %}
                              (min-width: 1200px) calc(((100vw - 40px) / 4) * {{ width_ratio }}), 
                              (min-width: 750px) calc(((100vw - 40px) / 3) * {{ width_ratio }}), 
                              (min-width: 576px) calc(((100vw - 40px) / 2) * {{ width_ratio }}), 
                              calc((100vw - 40px) * {{ width_ratio }})
                            {% endcapture %}

                            {% render 'article-card',
                              article: item,
                              image_ratio: section.settings.article_image_ratio,
                              post_heading_size: 'h6',
                              show_image: true,
                              show_tags: section.settings.article_show_tags,
                              show_date: section.settings.article_show_date,
                              show_author: section.settings.article_show_author,
                              show_excerpt: section.settings.article_show_desc,
                              background: false,
                              color_scheme: 'background-1',
                              section_author_image: section.settings.author_image,
                              overlay: false,
                              sizes: sizes
                            %}
                          </li>
                      {%- endcase -%}
                    {%- endfor -%}
                  </ul>
                {% endif %}

                {% if search_pages_size != 0 %}
                  <div class="search-results__top {% if search_products_size == 0 and search_articles_size == 0 %} first {% endif %}">
                    <h3 class="search-results__title">
                      {{ 'templates.search.page_count.other' | t: count: '' }}
                    </h3>
                  </div>
                  <ul
                    class="
                      collection-results
                      collection-results--{{ section.settings.columns_mobile }}-mobile
                      {% if section.settings.enable_filtering == false or filter_show == false %} collection-results_no-filter {%- endif -%}
                    "
                    role="list"
                  >
                    {%- for item in search_pages -%}
                      {%- case item.object_type -%}
                        {%- when 'page' -%}
                          <li class="template-search__item template-search__page">
                            <a href="{{ item.url }}" class="card-wrapper">
                              <div class="card-page">
                                <div class="card-page__content">
                                  <h3 class="card-page__text h3">
                                    {{ item.title | truncate: 50 | escape }}
                                  </h3>
                                </div>
                                <span class="cart-page__icon">
                                  {% render 'icon-caret-right' %}
                                </span>
                              </div>
                            </a>
                          </li>
                      {%- endcase -%}
                    {%- endfor -%}
                  </ul>
                {% endif %}
                {%- if paginate.pages > 1 -%}
                  {% render 'pagination', paginate: paginate %}
                {%- endif -%}
              </div>
            {%- endif -%}
          {% endpaginate %}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section-search",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "3/4",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": true,
      "label": "t:sections.all.card.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.all.card.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "default": false,
      "label": "t:sections.all.card.show_desc.label",
      "info": "t:sections.all.card.show_desc.info"
    },

    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
    {
      "type": "select",
      "id": "article_image_ratio",
      "options": [
        {
          "value": "landscape",
          "label": "t:sections.all.card.image_ratio_2.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.all.card.image_ratio_2.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.all.card.image_ratio_2.options__3.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.featured-blog.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_tags",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_tags.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_author.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_desc",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_desc.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "horizontal_united",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "horizontal_united",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label"
    },
    {
      "type": "text",
      "id": "hor_filter",
      "label": "t:sections.main-collection-product-grid.settings.hor_filter.label",
      "info": "t:sections.main-collection-product-grid.settings.hor_filter.info",
      "default": "t:sections.main-collection-product-grid.settings.hor_filter.default"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.image_filter.content"
    },
    {
      "type": "select",
      "id": "image_filter_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.all.card.image_ratio.options__1.label"
        },
        {
          "value": "3/2",
          "label": "t:sections.all.card.image_ratio.options__2.label"
        },
        {
          "value": "4/5",
          "label": "t:sections.all.card.image_ratio.options__3.label"
        }
      ],
      "default": "4/5",
      "label": "t:sections.all.aspect_ratio.label"
    },
    {
      "type": "select",
      "id": "image_filter_fit",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover",
      "label": "t:sections.all.card.image_fit.label"
    },
    {
      "type": "range",
      "id": "image_filter_columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2,
      "label": "t:sections.main-collection-product-grid.settings.image_filter_columns.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "xs",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ]
}
{% endschema %}
