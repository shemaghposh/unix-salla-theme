{{ 'section-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonials.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<section
  class="
    testimonials-section color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding
    {% if section.settings.enable_border %} section-border {% if section.settings.border_full %} section-border-full {% endif %} {% endif %}
  "
>
  <div class="container">
    <div class="testimonials-header-block">
      {%- if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      -%}
        <div class="section-top">
          {% render 'section-text', section: section, class: 'testimonials-header--block' %}
        </div>
      {% endif %}
      {% if section.settings.enable_navigation and section.blocks.size > 1 %}
        <div class="testimonials-buttons no-js-hidden">
          <div class="swiper-button swiper-button-prev">
            {% render 'icon-caret-left' %}
          </div>
          <div class="swiper-button swiper-button-next">
            {% render 'icon-caret-right' %}
          </div>
        </div>
      {% endif %}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div
        class="testimonials-slider-block{% if section.blocks.size > 1 %} swiper js-slider-testimonials{% endif %}"
        data-columns="{{ section.settings.testimonials_to_show }}"
      >
        <div
          class="testimonials-slider-list-wrapper swiper-wrapper"
        >
          {%- for block in section.blocks -%}
            <div class="testimonial-slider-item swiper-slide columns--{{- section.settings.testimonials_to_show -}}">
              {%- if block.settings.heading != blank or block.settings.text != blank -%}
                <div class="testimonial-slider-item-content">
                  {%- if block.settings.heading != blank -%}
                    <{{ block.settings.heading_tag | default: 'h2' }} class="testimonial-heading h3">
                      {{ block.settings.heading }}
                    </{{ block.settings.heading_tag | default: 'h2' }}>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="testimonial-text body-normal">
                      {{ block.settings.text }}
                    </p>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.rating > 0 or block.settings.author != blank -%}
                <div class="testimonial-slider-item-info">
                  {% if block.settings.rating > 0 %}
                    <div class="testimonial-rating-wrapper">
                      {% for i in (1..block.settings.rating) %}
                        {% render 'icon-star' %}
                      {% endfor %}
                    </div>
                  {% endif %}
                  {%- if block.settings.author != blank -%}
                    <span class="testimonial-author body-small">
                      {{ 'author.by' | t }}
                      {{ block.settings.author -}}
                    </span>
                  {%- endif -%}
                </div>
              {% endif %}

              {%- if block.settings.show_product -%}
                {% render 'product-card-horizontal',
                  product_card_product: block.settings.testimonial_product,
                  color_scheme: section.settings.product_color_scheme,
                  media_ratio: section.settings.image_ratio,
                  media_fit: section.settings.image_fit,
                  show_vendor: section.settings.show_vendor,
                  heading_tag: section.settings.card_heading_tag,
                  section_id: section.id,
                  forloop_index: forloop.index
                %}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

