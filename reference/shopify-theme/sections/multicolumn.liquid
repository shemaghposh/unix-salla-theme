{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

{% liquid
  assign content_alignment = section.settings.content_alignment
  assign swipe_on_mobile = section.settings.swipe_on_mobile
  assign swipe_on_desktop = section.settings.swipe_on_desktop
  assign columns_per_row = section.settings.columns_per_row
  assign image_size = section.settings.image_size
  assign image_ratio = section.settings.image_ratio
  assign object_fit = section.settings.object_fit

  if swipe_on_mobile and section.blocks.size > 1
    assign has_swiper = true
  elsif swipe_on_desktop and section.blocks.size > 1 and section.settings.layout == 'default'
    assign has_swiper = true
  else
    assign has_swiper = false
  endif

  if section.settings.subheading != blank or section.settings.heading != blank or section.settings.text != blank
    if section.settings.layout == 'right'
      assign is_right = true
      assign is_left = false
    elsif section.settings.layout == 'left'
      assign is_right = false
      assign is_left = true
    else
      assign is_right = false
      assign is_left = false
    endif
  endif
%}

<div
  class="
    multicolumn color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding
    {% if section.settings.enable_border %} section-border {% if section.settings.border_full %} section-border-full {% endif %} {% endif %}
  "
>
  <div class="container">
    <div
      class="multicolumn__wrapper{% if is_right %} multicolumn__wrapper--right{% endif %}{% if is_left %} multicolumn__wrapper--left{% endif %}"
      {% if section.settings.enable_accent %}
        style="--accent-color: {{ section.settings.accent_color }}"
      {% endif %}
    >
      {%- if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
        or section.settings.button_show
      -%}
        <div class="multicolumn__top{% if section.settings.enable_accent %} multicolumn__top--has-highlighting{% endif %}">
          {%- if section.settings.subheading != blank
            or section.settings.heading != blank
            or section.settings.text != blank
          -%}
            <div class="multicolumn__text">
              {% render 'section-text', section: section, class: 'multicolumn' %}
            </div>
          {% endif %}
          {%- if section.settings.button_show -%}
            {% render 'button',
              link: section.settings.button_link,
              label: section.settings.button_label,
              style: section.settings.button_style,
              class: 'multicolumn'
            %}
          {%- endif -%}
        </div>
      {% endif %}

      <div
        class="multicolumn-list{% if has_swiper %} swiper swiper--multicolumn{% endif %}"
        data-mobile-columns="{{section.settings.mobile_columns}}"
        data-desktop-columns="{{ section.settings.columns_per_row }}"
        {% if section.settings.layout == 'default' %}
          data-slider-desktop="{{ swipe_on_desktop }}"
        {% else %}
          data-slider-desktop="false"
        {% endif %}
        data-slider-mobile="{{ swipe_on_mobile }}"
      >
        <div class="multicolumn-list__wrapper multicolumn-list__wrapper--{{ columns_per_row }} multicolumn-list__wrapper--{{ content_alignment }} multicolumn-list__wrapper--{{ section.settings.mobile_columns }}-mobile{% if has_swiper %} swiper-wrapper{% endif %}">
          {%- for block in section.blocks -%}
            <div
              class="multicolumn-card multicolumn-list__item multicolumn-card--{{ content_alignment }}{% if section.settings.enable_column_background %} multicolumn-card--background{% endif %}{% if has_swiper %} swiper-slide{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.icon != 'none' -%}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--icon multicolumn-card__image-wrapper--{{- section.settings.icon_size }}">
                  {% render 'icon-pack', icon: block.settings.icon %}
                </div>
              {%- elsif block.settings.image != blank or block.settings.image_2 != blank -%}
                {% if image_ratio != 'adapt' %}
                  {% style %}
                    #shopify-section-{{ section.id }} .multicolumn-card__image-wrapper {
                      aspect-ratio: {{ image_ratio }};
                    }
                  {% endstyle %}
                {% endif %}
                <div class="multicolumn-card__image-wrapper multicolumn-card__image-wrapper--{{ image_size }}">
                  {% if block.settings.image != blank %}
                    {%- assign height = block.settings.image.height -%}
                    {%- assign width = block.settings.image.width -%}
                    {%- if image_size == 'extra_small' -%}
                      {%- assign width_adapt_ratio = 1 -%}
                      {%- if block.settings.image.width > block.settings.image.height -%}
                        {%- assign width_adapt_ratio = 44 | times: block.settings.image.aspect_ratio | round: 2 -%}
                      {%- endif -%}

                      {%- if width_adapt_ratio != 1 -%}
                        {%- assign sizes = width_adapt_ratio | append: 'px' -%}
                      {%- else -%}
                        {%- assign sizes = '88px' -%}
                      {%- endif -%}
                      {%- assign widths = '44, 88, 150, 200, 300, 500, 800, 1000' -%}
                    {%- elsif image_size == 'small' -%}
                      {%- assign widths = '200, 300, 500, 800, 1000, 1200' -%}
                      {% case columns_per_row %}
                        {% when 4 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 200 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 1200px) calc(0.3 * (100vw - 40px) / 4), (min-width: 990px) calc(0.3 * (100vw - 40px) / 3), (min-width: 750px) calc(0.3 * (100vw - 40px) / 2), calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 3 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 250 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 990px) calc(0.3 * (100vw - 40px) / 3), (min-width: 750px) calc(0.3 * (100vw - 40px) / 2), calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 2 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 300 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 750px) calc(0.3 * (100vw - 40px) / 2), calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% else %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 600 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                      {% endcase %}
                    {%- elsif image_size == 'medium' -%}
                      {%- assign widths = '200, 300, 500, 800, 1000, 1200, 1600, 1800, 2000' -%}
                      {% case columns_per_row %}
                        {% when 4 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 300 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 1200px) calc(0.5 * (100vw - 40px) / 4), (min-width: 990px) calc(0.5 * (100vw - 40px) / 3), (min-width: 750px) calc(0.5 * (100vw - 40px) / 2), calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 3 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 350 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 990px) calc(0.5 * (100vw - 40px) / 3), (min-width: 750px) calc(0.5 * (100vw - 40px) / 2), calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 2 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 500 | times: block.settings.image.aspect_ratio | round: 2 -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 750px) calc(0.5 * (100vw - 40px) / 2), calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% else %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image.width > block.settings.image.height -%}
                            {%- assign width_adapt_ratio = 1000
                              | times: block.settings.image.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                      {% endcase %}
                    {%- else -%}
                      {%- assign widths = '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920' -%}
                      {% case columns_per_row %}
                        {% when 4 %}
                          {% capture sizes %}
                              (min-width: 1200px) calc((100vw - 40px) / 4), (min-width: 990px) calc((100vw - 40px) / 3), (min-width: 750px) calc((100vw - 40px) / 2), calc(100vw - 40px)
                            {% endcapture %}
                        {% when 3 %}
                          {% capture sizes %}
                              (min-width: 990px) calc((100vw - 40px) / 3), (min-width: 750px) calc((100vw - 40px) / 2), calc(100vw - 40px)
                            {% endcapture %}
                        {% when 2 %}
                          {% capture sizes %}
                              (min-width: 750px) calc((100vw - 40px) / 2), calc(100vw - 40px)
                            {% endcapture %}
                        {% else %}
                          {% capture sizes %}
                              calc(100vw - 40px)
                            {% endcapture %}
                      {% endcase %}
                    {%- endif -%}

                    {%- capture style -%}
                      object-fit: {{ object_fit }};
                      object-position: {{ block.settings.image.presentation.focal_point }};
                    {%- endcapture -%}

                    {{
                      block.settings.image
                      | image_url: width: block.settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        sizes: sizes,
                        widths: widths,
                        height: height,
                        width: width,
                        style: style,
                        class: 'multicolumn-card__image-wrapper-image'
                    }}
                  {% endif %}

                  {% if block.settings.image_2 != blank %}
                    {%- assign height = block.settings.image_2.height -%}
                    {%- assign width = block.settings.image_2.width -%}
                    {%- if image_size == 'extra_small' -%}
                      {%- assign width_adapt_ratio = 1 -%}
                      {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                        {%- assign width_adapt_ratio = 44 | times: block.settings.image_2.aspect_ratio | round: 2 -%}
                      {%- endif -%}

                      {%- if width_adapt_ratio != 1 -%}
                        {%- assign sizes = width_adapt_ratio | append: 'px' -%}
                      {%- else -%}
                        {%- assign sizes = '88px' -%}
                      {%- endif -%}
                      {%- assign widths = '44, 88, 150, 200, 300, 500, 800, 1000' -%}
                    {%- elsif image_size == 'small' -%}
                      {%- assign widths = '200, 300, 500, 800, 1000, 1200' -%}
                      {% case columns_per_row %}
                        {% when 4 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 200
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 1200px) calc(0.3 * (100vw - 40px) / 4), (min-width: 990px) calc(0.3 * (100vw - 40px) / 3), (min-width: 750px) calc(0.3 * (100vw - 40px) / 2), calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 3 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 250
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 990px) calc(0.3 * (100vw - 40px) / 3), (min-width: 750px) calc(0.3 * (100vw - 40px) / 2), calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 2 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 300
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 750px) calc(0.3 * (100vw - 40px) / 2), calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% else %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 600
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                calc(30vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                      {% endcase %}
                    {%- elsif image_size == 'medium' -%}
                      {%- assign widths = '200, 300, 500, 800, 1000, 1200, 1600, 1800, 2000' -%}
                      {% case columns_per_row %}
                        {% when 4 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 300
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 1200px) calc(0.5 * (100vw - 40px) / 4), (min-width: 990px) calc(0.5 * (100vw - 40px) / 3), (min-width: 750px) calc(0.5 * (100vw - 40px) / 2), calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 3 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 350
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 990px) calc(0.5 * (100vw - 40px) / 3), (min-width: 750px) calc(0.5 * (100vw - 40px) / 2), calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% when 2 %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 500
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                (min-width: 750px) calc(0.5 * (100vw - 40px) / 2), calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                        {% else %}
                          {%- assign width_adapt_ratio = 1 -%}
                          {%- if block.settings.image_2.width > block.settings.image_2.height -%}
                            {%- assign width_adapt_ratio = 1000
                              | times: block.settings.image_2.aspect_ratio
                              | round: 2
                            -%}
                          {%- endif -%}
                          {% capture sizes %}
                              {%- if width_adapt_ratio != 1 -%}
                                {{ width_adapt_ratio }}px
                              {%- else -%}
                                calc(50vw - 40px)
                              {%- endif -%}
                            {% endcapture %}
                      {% endcase %}
                    {%- else -%}
                      {%- assign widths = '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920' -%}
                      {% case columns_per_row %}
                        {% when 4 %}
                          {% capture sizes %}
                              (min-width: 1200px) calc((100vw - 40px) / 4), (min-width: 990px) calc((100vw - 40px) / 3), (min-width: 750px) calc((100vw - 40px) / 2), calc(100vw - 40px)
                            {% endcapture %}
                        {% when 3 %}
                          {% capture sizes %}
                              (min-width: 990px) calc((100vw - 40px) / 3), (min-width: 750px) calc((100vw - 40px) / 2), calc(100vw - 40px)
                            {% endcapture %}
                        {% when 2 %}
                          {% capture sizes %}
                              (min-width: 750px) calc((100vw - 40px) / 2), calc(100vw - 40px)
                            {% endcapture %}
                        {% else %}
                          {% capture sizes %}
                              calc(100vw - 40px)
                            {% endcapture %}
                      {% endcase %}
                    {%- endif -%}

                    {%- capture style -%}
                      object-fit: {{ object_fit }};
                      object-position: {{ block.settings.image_2.presentation.focal_point }};
                    {%- endcapture -%}

                    {{
                      block.settings.image_2
                      | image_url: width: block.settings.image_2.width
                      | image_tag:
                        loading: 'lazy',
                        sizes: sizes,
                        widths: widths,
                        height: height,
                        width: width,
                        style: style,
                        class: 'multicolumn-card__image-wrapper-image'
                    }}
                  {% endif %}
                </div>
              {%- endif -%}
              {%- if block.settings.subheading != blank
                or block.settings.heading != blank
                or block.settings.text != blank
              -%}
                <div class="multicolumn-card__info">
                  {%- if block.settings.subheading != blank -%}
                    <div class="multicolumn-card__subheading">
                      {{ block.settings.subheading }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <{{ block.settings.heading_tag | default: 'h3' }} class="multicolumn-card__heading {{ section.settings.card_heading_size }}">
                      {{ block.settings.heading | newline_to_br }}
                    </{{ block.settings.heading_tag | default: 'h3' }}>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="multicolumn-card__text">
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
              {%- if block.settings.show_button -%}
                {% render 'button',
                  label: block.settings.button_label,
                  link: block.settings.button_link,
                  style: block.settings.button_style,
                  class: 'multicolumn-card'
                %}
              {% endif %}
            </div>
          {%- endfor -%}
        </div>

        {%- if has_swiper -%}
          <div class="multicolumn__pagination swiper-pagination no-js-hidden"></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% if has_swiper %}
  <script src="{{ 'multicolumn.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "class": "multicolumn-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.all.enable_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_full",
      "label": "t:sections.all.border_full.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "enable_column_background",
      "default": true,
      "label": "t:sections.multicolumn.settings.enable_column_background.label",
      "info": "t:sections.multicolumn.settings.enable_column_background.info"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_desktop.content"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "default",
          "label": "t:sections.multicolumn.settings.layout.options__1.label"
        },
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.layout.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.multicolumn.settings.layout.options__3.label"
        }
      ],
      "default": "default",
      "label": "t:sections.multicolumn.settings.layout.label"
    },
    {
      "type": "range",
      "id": "columns_per_row",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.multicolumn.settings.columns.label",
      "info": "t:sections.multicolumn.settings.columns.info"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_desktop",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_desktop.label",
