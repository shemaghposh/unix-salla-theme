{%- comment -%}
  UNIX — أكملي الإطلالة / Complete the look
  Reads custom.complements (list.product_reference).
  Heading uses the theme's h3 scale so it matches sibling sections.
  Quick-add opens the theme's variant modal (sizes need choosing).
{%- endcomment -%}

{%- liquid
  assign items = product.metafields.custom.complements.value
  assign shown = 0
-%}

{%- if items != blank -%}
  {%- liquid
    assign heading = section.settings.heading
    if heading == blank
      assign heading = 'أكملي الإطلالة'
      if request.locale.iso_code == 'en'
        assign heading = 'Complete the look'
      endif
    endif

    assign add_label = 'أضيفي'
    if request.locale.iso_code == 'en'
      assign add_label = 'Add'
    endif
  -%}

  <div class="ctl color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
    <div class="container">
      <div class="ctl__head">
        <h2 class="ctl__title h3">{{ heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="ctl__sub body-small">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <ul class="ctl__grid list-unstyled" role="list">
        {%- for item in items -%}
          {%- if item.available == false and section.settings.hide_soldout -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown >= section.settings.limit -%}
            {%- break -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}

          <li class="ctl__item">
            <div class="ctl__card">
              <a href="{{ item.url }}" class="ctl__media" aria-label="{{ item.title | escape }}">
                {%- if item.featured_image -%}
                  {{
                    item.featured_image
                    | image_url: width: 700
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 300, 400, 500, 700',
                      sizes: '(min-width: 750px) 300px, 46vw',
                      class: 'ctl__img'
                  }}
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'ctl__img placeholder-svg' }}
                {%- endif -%}

                {%- if item.available == false -%}
                  <span class="ctl__badge">{{ 'products.product.sold_out' | t }}</span>
                {%- endif -%}
              </a>

              <div class="ctl__info">
                <a href="{{ item.url }}" class="ctl__name">{{ item.title | escape }}</a>
                {%- if section.settings.show_price -%}
                  <span class="ctl__price">
                    {%- if item.compare_at_price > item.price -%}
                      <span>{{ item.price | money }}</span>
                      <s class="ctl__price-was">{{ item.compare_at_price | money }}</s>
                    {%- else -%}
                      {{ item.price | money }}
                    {%- endif -%}
                  </span>
                {%- endif -%}

                {%- if section.settings.show_add_button and item.available -%}
                  {%- if item.has_only_default_variant -%}
                    {%- comment -%} single variant → straight to cart {%- endcomment -%}
                    {%- assign form_id = 'ctl-add-' | append: section.id | append: item.id -%}
                    <product-form class="ctl__form" data-source="{{ section.id }}">
                      {%- form 'product', item, id: form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                        <input
                          type="hidden"
                          name="id"
                          value="{{ item.selected_or_first_available_variant.id }}"
                        >
                        <button
                          type="submit"
                          name="add"
                          class="ctl__add"
                          aria-live="polite"
                        >
                          <span>{{ add_label }}</span>
                          <div class="loading-overlay__spinner hidden">
                            <div class="spinner"></div>
                          </div>
                        </button>
                      {%- endform -%}
                    </product-form>
                  {%- else -%}
                    {%- comment -%} has sizes → open the theme's quick-add modal {%- endcomment -%}
                    <modal-opener-quick-view data-modal="#QuickAdd-{{ item.id }}">
                      <button
                        type="button"
                        class="ctl__add"
                        aria-haspopup="dialog"
                        data-product-url="{{ item.url }}"
                        data-product-id="{{ item.id }}"
                        data-modal-id="QuickAdd-{{ item.id }}"
                        data-modal-class="quick-add-modal"
                        data-modal-aria-label="{{ 'products.product.choose_product_options' | t: product_name: item.title | escape }}"
                      >
                        <span>{{ add_label }}</span>
                        <div class="loading-overlay__spinner hidden">
                          <div class="spinner"></div>
                        </div>
                      </button>
                    </modal-opener-quick-view>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <style>
    .ctl { color: rgb(var(--color-foreground)); }

    .ctl__head { margin-bottom: 1.6rem; }
    .ctl__title { margin: 0 0 .3rem; }
    .ctl__sub { margin: 0; color: rgba(var(--color-foreground), .62); }

    .ctl__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.4rem .8rem;
      margin: 0;
      padding: 0;
    }

    .ctl__card { display: flex; flex-direction: column; height: 100%; }

    .ctl__media {
      position: relative;
      display: block;
      border-radius: 1.2rem;
      overflow: hidden;
      background: rgb(var(--color-background-2, var(--color-background)));
      aspect-ratio: 3 / 4;
    }
    .ctl__img {
      width: 100%; height: 100%;
      object-fit: cover; display: block;
      transition: transform .4s ease;
    }

    .ctl__badge {
      position: absolute;
      inset-block-start: .6rem;
      inset-inline-start: .6rem;
      background: rgba(var(--color-foreground), .82);
      color: rgb(var(--color-background));
      font-size: .66rem;
      padding: .25rem .7rem;
      border-radius: 999px;
    }

    .ctl__info {
      padding-top: .7rem;
      display: flex;
      flex-direction: column;
      gap: .25rem;
      flex: 1;
    }
    .ctl__name {
      color: rgb(var(--color-foreground));
      text-decoration: none;
      font-size: .84rem;
      line-height: 1.55;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ctl__price {
      color: rgb(var(--color-foreground));
      font-size: .88rem;
      font-weight: 500;
    }
    .ctl__price-was {
      color: rgba(var(--color-foreground), .55);
      font-weight: 400;
      margin-inline-start: .45rem;
      font-size: .78rem;
    }

    .ctl__form { margin: 0; }
    .ctl__form .form { margin: 0; }

    .ctl__add {
      margin-top: .6rem;
      width: 100%;
      min-height: 4rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      background: transparent;
      color: rgb(var(--color-foreground));
      border: 1px solid rgba(var(--color-foreground), .22);
      border-radius: 30px;
      font-family: inherit;
      font-size: .82rem;
      font-weight: 500;
      letter-spacing: .01em;
      cursor: pointer;
      transition: background .15s ease, border-color .15s ease;
    }
    .ctl__add:hover {
      background: rgba(var(--color-foreground), .06);
      border-color: rgba(var(--color-foreground), .4);
    }

    @media screen and (min-width: 750px) {
      .ctl__head { margin-bottom: 2rem; }
      .ctl__grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 1.8rem 1.4rem;
        max-width: 76rem;
      }
      .ctl__card:hover .ctl__img { transform: scale(1.04); }
      .ctl__name { font-size: .9rem; }
      .ctl__price { font-size: .95rem; }
    }
  </style>

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "أكملي الإطلالة",
  "tag": "section",
  "class": "complete-the-look-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "يقرأ القطع المكمّلة من حقل custom.complements. لو الحقل فاضي، القسم ما يظهرش."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "العنوان",
      "default": "أكملي الإطلالة"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "وصف مختصر"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 2,
      "label": "عدد القطع"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "إظهار السعر"
    },
    {
      "type": "checkbox",
      "id": "show_add_button",
      "default": true,
      "label": "إظهار زر الإضافة"
    },
    {
      "type": "checkbox",
      "id": "hide_soldout",
      "default": false,
      "label": "إخفاء القطع النافدة"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "نمط الألوان"
    },
    {
      "type": "header",
      "content": "المسافات"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "مسافة علوية",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "مسافة سفلية",
      "default": 40
    }
  ],
  "presets": [
    { "name": "أكملي الإطلالة" }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
