{{ 'img-comparison.css' | asset_url | stylesheet_tag }}
{{ 'section-compare.css' | asset_url | stylesheet_tag }}

{% style %}
  {% render 'section-margin' %}
  {% render 'section-padding' %}
{% endstyle %}

<div class="compare section-{{ section.id }}-padding">
  <div class="container">
    <div class="compare__wrapper">
      {% if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      %}
        <div class="compare__content">
          {% render 'section-text', section: section, class: 'compare', text_align: section.settings.text_align %}
        </div>
      {% endif %}
      {% if section.settings.product != blank %}
        <div class="compare__product-wrapper">
          {% if section.settings.product != blank %}
            {% if section.settings.product_title != blank %}
              <div class="compare__product-title h3">{{ section.settings.product_title }}</div>
            {% endif %}
            {% render 'product-card-horizontal',
              product_card_product: section.settings.product,
              color_scheme: section.settings.card_color_scheme,
              media_ratio: section.settings.image_ratio,
              media_fit: section.settings.image_fit,
              show_vendor: section.settings.show_vendor,
              section_id: section.id
            %}
          {% endif %}
        </div>
      {% endif %}
      <div class="compare__container">
        {%- if section.settings.image_before != blank and section.settings.image_after != blank -%}
          <img-comparison-slider>
            {% capture sizes %}
              calc(100vw - 40px)
            {% endcapture %}
            <figure class="compare__figure" slot="first">
              {{
                section.settings.image_before
                | image_url: width: section.settings.image_before.width
                | image_tag:
                  loading: 'lazy',
                  widths: '375, 425, 575, 750, 990, 1200, 1360, 1500, 1632, 1920',
                  sizes: sizes
              }}
              <figcaption class="compare__text compare__text--left body-small color-{{ section.settings.color_scheme_text }}">
                {%- if section.settings.text_left != blank -%}
                  {{ section.settings.text_left }}
                {%- endif -%}
              </figcaption>
            </figure>
            <figure class="compare__figure" slot="second">
              {{
                section.settings.image_after
                | image_url: width: section.settings.image_after.width
                | image_tag:
                  loading: 'lazy',
                  widths: '375, 425, 575, 750, 990, 1200, 1360, 1500, 1632, 1920',
                  sizes: sizes
              }}
              <figcaption class="compare__text compare__text--right body-small color-{{ section.settings.color_scheme_text }}">
                {%- if section.settings.text_right != blank -%}
                  {{ section.settings.text_right }}
                {%- endif -%}
              </figcaption>
            </figure>
            <div class="compare__handle" slot="handle">
              {% render 'icon-handle' %}
            </div>
          </img-comparison-slider>
        {%- else -%}
          <div class="compare__default">
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
            {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
          </div>
          {%- if section.settings.text_left != blank -%}
            <div class="compare__text compare__text--left subtitle color-{{ section.settings.color_scheme_text }}">
              {{ section.settings.text_left }}
            </div>
          {%- endif -%}
          {%- if section.settings.text_right != blank -%}
            <div class="compare__text compare__text--right subtitle color-{{ section.settings.color_scheme_text }}">
              {{ section.settings.text_right }}
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'img-comparison.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "t:sections.compare-block.name",
  "tag": "section",
  "class": "section-compare",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label",
      "default": "t:sections.compare-block.settings.subheading.default"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.compare-block.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "t:sections.compare-block.settings.image_before.label",
      "info": "t:sections.compare-block.settings.image_before.info"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "t:sections.compare-block.settings.image_after.label",
      "info": "t:sections.compare-block.settings.image_before.info"
    },
    {
      "type": "text",
      "id": "text_left",
      "label": "t:sections.compare-block.settings.text_left.label",
      "default": "t:sections.compare-block.settings.text_left.default"
    },
    {
      "type": "text",
      "id": "text_right",
      "label": "t:sections.compare-block.settings.text_right.label",
      "default": "t:sections.compare-block.settings.text_right.default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_text",
      "default": "background-1",
      "label": "t:sections.compare-block.settings.color_scheme_text.label"
    },
    {
      "type": "header",
      "content": "t:sections.product-recommendations.settings.header__2.content"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "t:sections.compare-block.settings.product_title.label",
      "default": "t:sections.compare-block.settings.product_title.default"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.compare-block.settings.product.label"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "default": "background-2",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "1/1",
