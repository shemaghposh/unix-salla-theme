{{ 'section-products-with-tabs.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="products-with-tabs color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="container">
    <div class="section-grid{% if section.settings.enable_carousel %} section-grid-slider {% if section.settings.button_show == false %} section-grid-slider_nav {% endif %} {% endif %}{% if section.settings.subheading == blank and section.settings.heading == blank and section.settings.text == blank %} section-grid_no-text{% endif %}">
      {%- if section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      -%}
        <div class="section-top">
          {% render 'section-text', section: section, class: 'popular-products' %}
        </div>
      {% endif %}

      {%- if section.settings.enable_carousel -%}
        <div class="products-with-tabs__navigation swiper-navigation no-js-hidden">
          <div class="products-with-tabs__button-prev swiper-button-prev">
            {% render 'icon-caret-left' %}
          </div>
          <div class="products-with-tabs__button-next swiper-button-next">
            {% render 'icon-caret-right' %}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.button_show -%}
        {%- liquid
          assign browse_prefix = 'تصفحي '
          if request.locale.iso_code == 'en'
            assign browse_prefix = 'Browse '
          endif

          assign first_block = section.blocks.first
          assign init_link = first_block.settings.tab_button_link
          if init_link == blank and first_block.settings.collection != blank
            assign init_link = first_block.settings.collection.url
          endif
          if init_link == blank
            assign init_link = section.settings.button_link
          endif

          assign init_label = first_block.settings.tab_button_label
          if init_label == blank and first_block.settings.tab_label != blank
            assign init_label = browse_prefix | append: first_block.settings.tab_label
          endif
          if init_label == blank
            assign init_label = section.settings.button_label
          endif
        -%}
        <a
          {% if init_link != blank %}href="{{ init_link }}"{% endif %}
          class="products-with-tabs__button button button--{{ section.settings.button_style }} focus-inset"
          {% if init_link == blank %}aria-disabled="true"{% endif %}
          data-pwt-button
        >
          <span>{{ init_label }}</span>
        </a>
        <script type="application/json" data-pwt-map>
          {
          {%- for block in section.blocks -%}
            {%- liquid
              assign b_link = block.settings.tab_button_link
              if b_link == blank and block.settings.collection != blank
                assign b_link = block.settings.collection.url
              endif
              if b_link == blank
                assign b_link = section.settings.button_link
              endif
              assign b_label = block.settings.tab_button_label
              if b_label == blank and block.settings.tab_label != blank
                assign b_label = browse_prefix | append: block.settings.tab_label
              endif
              if b_label == blank
                assign b_label = section.settings.button_label
              endif
            -%}
            {{ block.id | json }}: { "url": {{ b_link | json }}, "label": {{ b_label | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
          }
        </script>
      {%- endif -%}

      <div class="content products-with-tabs__content">
        <div class="products-with-tabs__tabs">
          <div class="products-with-tabs__tabs-wrapper">
            {% for block in section.blocks %}
              <div
                class="products-with-tabs__tab body-small button{% if forloop.index == 1 %} button--secondary{% else %} button--tertiary{% endif %}"
                data-product-tab="#product-tab-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                <span>{{ block.settings.tab_label }}</span>
              </div>
            {% endfor %}
          </div>
        </div>

        {% for block in section.blocks %}
          {% liquid
            assign placeholder_numbers = '1|2|3|4' | split: '|'
            assign block_index = forloop.index
            assign start_index = block_index | modulo: placeholder_numbers.size
          %}
          <div
            class="products-with-tabs__products products--{{ section.settings.columns_mobile }}-mobile{% if section.settings.enable_carousel %} products-with-tabs__slider swiper {% else %} products-with-tabs__wrapper products-with-tabs__wrapper--{{ section.settings.products_to_show }} products-with-tabs--{{ section.settings.columns_mobile }}-mobile {% endif %} {% if forloop.index == 1 %} products-with-tabs__products--active{% endif %}"
            data-columns="{{ section.settings.products_to_show }}"
            data-product-tab="#product-tab-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {% if section.settings.enable_carousel %}
              <div class="swiper-wrapper">
            {% endif %}

            {% liquid
              assign product_list = blank
              if block.settings.collection != blank
                assign product_list = block.settings.collection.products
                assign product_limit = block.settings.product_limit
              elsif block.settings.product_list != blank
                assign product_list = block.settings.product_list
                assign product_limit = block.settings.product_list.count
              endif
            %}

            {% if product_list != blank %}
              {%- for product in product_list limit: product_limit -%}
                <div
                  class="
                    products-with-tabs__item collection-product-card
                    quickview{%- if settings.quickview_hover -%}--hover{% endif %}
                    {% if section.settings.enable_carousel %} swiper-slide {% endif %}
                  "
                >
                  {% render 'product-card',
                    product_card_product: product,
                    media_ratio: section.settings.image_ratio,
                    media_fit: section.settings.image_fit,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_desc: section.settings.show_desc,
                    heading_tag: section.settings.card_heading_tag,
                    section_id: section.id,
                    add_id: forloop.index
                  %}
                </div>
              {%- endfor -%}
            {%- else -%}
              {% if section.settings.enable_carousel %}
                {% assign count = 6 %}
              {% else %}
                {% assign count = 4 %}
              {% endif %}
              {%- for i in (1..count) -%}
                {% liquid
                  assign index = start_index | plus: i | modulo: placeholder_numbers.size
                  assign random_number = placeholder_numbers[index]
                %}
                <div
                  class="
                    products-with-tabs__item_placeholder collection-popular-card collection-popular-card--placeholder
                    {% if section.settings.enable_carousel %} swiper-slide {% endif %}
                  "
                >
                  {% render 'product-card-placeholder',
                    media_ratio: section.settings.image_ratio,
                    show_vendor: section.settings.show_vendor,
                    heading_tag: section.settings.card_heading_tag,
                    product_number: random_number
                  %}
                </div>
              {%- endfor -%}
            {%- endif -%}

            {% if section.settings.enable_carousel %}
              </div>
              <div class="products-with-tabs__pagination no-js-hidden swiper-pagination"></div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var sec = document.getElementById('shopify-section-{{ section.id }}');
  if (!sec) return;
  var btn = sec.querySelector('[data-pwt-button]');
  var mapEl = sec.querySelector('[data-pwt-map]');
  if (!btn || !mapEl) return;
  var map = {};
  try { map = JSON.parse(mapEl.textContent); } catch (e) { return; }
  sec.addEventListener('click', function(e){
    var tab = e.target.closest('.products-with-tabs__tab');
    if (!tab || !sec.contains(tab)) return;
    var key = (tab.getAttribute('data-product-tab') || '').replace('#product-tab-', '');
    var d = map[key];
    if (!d) return;
    if (d.url) { btn.setAttribute('href', d.url); btn.removeAttribute('aria-disabled'); }
    var sp = btn.querySelector('span');
    if (sp && d.label) sp.textContent = d.label;
  });
})();
</script>

<script src="{{ 'products-with-tabs.js' | asset_url }}" defer="defer"></script>

