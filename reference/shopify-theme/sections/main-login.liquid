{{ 'customer.css' | asset_url | stylesheet_tag }}

{% liquid
  if section.settings.desktop_image != blank and section.settings.mobile_image == blank
    assign image = section.settings.desktop_image
  elsif section.settings.desktop_image == blank and section.settings.mobile_image != blank
    assign image = section.settings.mobile_image
  elsif section.settings.desktop_image == blank and section.settings.mobile_image == blank
    assign image = blank
  elsif section.settings.desktop_image != blank and section.settings.mobile_image != blank
    assign image = 1
  endif
%}

<div
  class="color-{{ section.settings.color_scheme }} login-section-wrapper"
  {% if section.settings.header_overlay %}
    data-header-overlay="true"
  {% endif %}
>
  <div
    class="customer login container"
  >
    {% if settings.show_breadcrumbs %}
      <nav class="breadcrumb breadcrumb__desktop body-xs" role="navigation" aria-label="breadcrumbs">
        <a
          href="{{ routes.root_url }}"
          title="{{ 'general.breadcrumbs.home' | t }}"
          class="link-hover-line-secondary focus-inset"
        >
          <span>{{- 'general.breadcrumbs.home' | t -}}</span>
        </a>
        <div class="breadcrumb__delimiter">/</div>
        <span>{{ 'customer.login_page.title' | t }}</span>
      </nav>
    {% endif %}
    <div class="login__wrapper">
      <div class="login__col">
        <div class="login__overlay" style="opacity: {{ section.settings.overlay_opacity }}"></div>
        {% capture sizes %}
					(min-width: 990px) calc(50vw - 40px), 100vw
				{% endcapture %}
        {% if image != blank and image != 1 %}
          {% liquid
            assign class = 'featured-collections__image'
          %}
          {{
            image
            | image_url: width: image.width
            | image_tag:
              class: class,
              loading: 'lazy',
              widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920, 2200, 2400, 2600'
          }}
        {% elsif image == 1 %}
          {% assign desktop_image = section.settings.desktop_image %}
          {% assign mobile_image = section.settings.mobile_image %}
          <picture>
            <source
              srcset=" {{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x"
              media="(max-width: 375px)"
            >
            <source
              srcset=" {{ mobile_image | image_url: width: 575 }} 1x, {{ mobile_image | image_url: width: 1150 }} 2x"
              media="(max-width: 575px)"
            >
            <source
              srcset=" {{ desktop_image | image_url: width: 750 }} 1x, {{ desktop_image | image_url: width: 1500 }} 2x"
              media="(max-width: 750px)"
            >
            {%- if desktop_image.width > 750 -%}
              <source
                srcset=" {{ desktop_image | image_url: width: 1100 }} 1x, {%- if desktop_image.width > 1500 -%} {{ desktop_image | image_url: width: 2200 }} 2x {%- endif -%}"
                media="(max-width: 1100px)"
              >
            {%- endif -%}
            {%- if desktop_image.width > 1100 -%}
              <source
                srcset=" {{ desktop_image | image_url: width: 1500 }} 1x, {%- if desktop_image.width > 2200 -%} {{ desktop_image | image_url: width: 3000 }} 2x {%- endif -%}"
                media="(max-width: 1500px)"
              >
            {%- endif -%}
            {%- if desktop_image.width > 1500 -%}
              <source
                srcset=" {{ desktop_image | image_url: width: 1780 }} 1x, {%- if desktop_image.width > 3000 -%} {{ desktop_image | image_url: width: 3560 }} 2x {%- endif -%}"
                media="(max-width: 1780px) "
              >
            {%- endif -%}
            {%- if desktop_image.width > 1780 -%}
              <source
                srcset=" {{ desktop_image | image_url: width: 2000 }} 1x, {%- if desktop_image.width > 3560 -%} {{ desktop_image | image_url: width: 4000 }} 2x {%- endif -%}"
                media="(max-width: 2000px) "
              >
            {%- endif -%}
            <img
              sizes="{{ sizes }}"
              src="{{ desktop_image | image_url: width: desktop_image.width }}"
              loading="lazy"
              alt="{{ desktop_image.alt | escape }}"
              class="featured-collections__image"
              width="{{ desktop_image.width }}"
              height="{{ desktop_image.width | divided_by: desktop_image.aspect_ratio }}"
              style="--focal_point_desktop: {{ desktop_image.presentation.focal_point }}; --focal_point_mobile: {{ mobile_image.presentation.focal_point }};"
            >
          </picture>
        {% endif %}
      </div>
      <div class="login__col">
        <div class="login__reset" id="recover">
          <div class="page-header">
            <div class="page-header__inner">
              <h2 class="title--page login__title h2" tabindex="-1">
                {{ 'customer.recover_password.title' | t }}
              </h2>
              <p class="login__text body-large">
                {{ 'customer.recover_password.subtext' | t }}
              </p>
            </div>
          </div>
          <div>
            {%- form 'recover_customer_password' -%}
              {% assign recover_success = form.posted_successfully? %}
              <div class="field field--email color-{{ section.settings.input_color_scheme }}">
                <input
                  dir="ltr"
                  class="field__input"
                  type="email"
                  value=""
                  name="email"
                  id="RecoverEmail"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="RecoverEmail-email-error"
                    autofocus
                  {% endif %}
                  placeholder="{{ 'customer.login_page.email_placeholder' | t }}"
                >
                <label for="RecoverEmail" class="body-small">{{ 'customer.login_page.email_placeholder' | t }}</label>
              </div>

              <div class="login__buttons">
                <button class="button button--primary login__sign-in focus-inset">
                  <span>
                    {{ 'customer.login_page.submit' | t }}
                  </span>
                </button>

                <a class="anchor button button--simple_secondary login__sign-in focus-inset body-xs" href="#login">
                  <span>
                    {{ 'customer.login_page.cancel' | t }}
                  </span>
                </a>
              </div>
            {%- endform -%}
          </div>
        </div>

        <div class="login__form" id="login">
          <div class="page-header">
            <div class="page-header__inner">
              <h1 class="title--page login__title h2" tabindex="-1">
                {{ 'customer.login_page.title' | t }}
              </h1>
              <div class="login__text body-large">{{ 'customer.login_page.login_description' | t }}</div>
            </div>
          </div>
          {%- if recover_success == true -%}
            <h3 class="form__message" tabindex="-1" autofocus>
              {{ 'customer.recover_password.success' | t }}
            </h3>
          {%- endif -%}
          {%- form 'customer_login', novalidate: 'novalidate' -%}
            <div class="field field--email login__field color-{{ section.settings.input_color_scheme }}">
              <input
                dir="ltr"
                type="email"
                name="customer[email]"
                class="field__input"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                  aria-describedby="LoginForm-email-error"
                {% endif %}
                placeholder="{{ 'customer.login_page.email_placeholder' | t }}"
              >
              <label for="CustomerEmail" class="body-small">{{ 'customer.login_page.email_placeholder' | t }}</label>
              {% unless template.name == 'register' %}
                {{ form.errors | default_errors }}
              {% endunless %}
            </div>

            {%- if form.password_needed -%}
              <div class="field field--pass login__field color-{{ section.settings.input_color_scheme }}">
                <div class="button-pass-visibility">
                  {% render 'icon-eye' %}
                  {% render 'icon-eye-close' %}
                </div>
                <input
                  dir="ltr"
                  type="password"
                  value=""
                  name="customer[password]"
                  class="field__input"
                  id="CustomerPassword"
                  autocomplete="current-password"
                  placeholder="{{- 'customer.login_page.password_placeholder' | t -}}"
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                  {% endif %}
                  required
                >
                <label for="CustomerPassword" class="body-small">
                  {{- 'customer.login_page.password_placeholder' | t -}}
                </label>
                {% unless template.name == 'register' %}
                  {{ form.errors | default_errors }}
                {% endunless %}
              </div>
            {%- endif -%}

            <a href="#recover" class="anchor button button--simple_secondary login__forgot-password focus-inset">
              <span class="body-xs">{{ 'customer.login_page.forgot_password' | t }}</span>
            </a>
            <div class="login__buttons">
              <button class="button button--primary button--login login__sign-in focus-inset">
                <span>
                  {{ 'customer.login_page.title' | t }}
                </span>
              </button>

              <a href="{{ routes.account_register_url }}" class="button button--tertiary focus-inset">
                <span>{{ 'customer.login_page.create_account' | t }}</span>
              </a>
            </div>
          {%- endform -%}
        </div>

        {%- if shop.checkout.guest_login -%}
          <div class="login__guest">
            <div class="login__title h2">{{ 'customer.login_page.guest_title' | t }}</div>

            {%- form 'guest_login' -%}
              <button class="button button--primary focus-inset">
                <span>
                  {{ 'customer.login_page.guest_continue' | t }}
                </span>
              </button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script>
  window.onload = () => {
    typeof PasswordViewer !== 'undefined' && new PasswordViewer();
  };
</script>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "tag": "section",
  "class": "spaced-section login-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-3",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "color_scheme",
      "id": "input_color_scheme",
      "default": "background-2",
      "label": "t:sections.all.input_color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "header_overlay",
      "default": true,
      "label": "t:sections.all.header_overlay.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.main-login.settings.mobile_image.label"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:sections.main-login.settings.desktop_image.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.4,
      "label": "t:sections.all.overlay_opacity.label"
    }
  ]
}
{% endschema %}
