{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div class="contact-form section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="contact-form__content contact-form__content--{{ section.settings.position }}">
      {% if section.blocks.size > 0
        or section.settings.subheading != blank
        or section.settings.heading != blank
        or section.settings.text != blank
      %}
        <div class="contact-form__info">
          {% if section.settings.subheading != blank
            or section.settings.heading != blank
            or section.settings.text != blank
          %}
            <div class="contact-form__text">
              {% render 'section-text', section: section, class: 'contact-form' %}
            </div>
          {% endif %}

          {% if section.blocks.size > 0 %}
            <div class="contact-form__blocks">
              {% for block in section.blocks %}
                {% if block.settings.subheading != blank or block.settings.text != blank %}
                  <div class="contact-form__block" {{ block.shopify_attributes }}>
                    {% if block.settings.subheading != blank %}
                      <div class="contact-form__block-subtitle body-large">
                        {{ block.settings.subheading }}
                      </div>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div
                        class="contact-form__block-text"
                        {% if block.settings.text_transform != 'none' %}
                          style="text-transform: {{ block.settings.text_transform }};"
                        {% endif %}
                      >
                        {{ block.settings.text }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endif %}
      <div class="contact-form__form color-{{ section.settings.color_scheme_form }}">
        <div class="contact-form__inner">
          <div class="contact-form__wrapper">
            {%- if section.settings.heading_form != blank -%}
              <h2 class="contact-form__title-form {{ section.settings.heading_form_size }}">
                {{ section.settings.heading_form }}
              </h2>
            {%- endif -%}
            {%- if section.settings.text_form != blank -%}
              <p class="contact-form__text-form">
                {{ section.settings.text_form }}
              </p>
            {%- endif -%}
            {%- form 'contact', id: 'ContactForm' -%}
              {%- if form.posted_successfully? -%}
                <div class="form-status form-status-list form__message" tabindex="-1" autofocus>
                  {% render 'icon-success' %}
                  {{ 'templates.contact.form.post_success' | t }}
                </div>
              {%- elsif form.errors -%}
              {%- endif -%}
              <div class="contact-form__group">
                <div class="field field__name">
                  <input
                    dir="ltr"
                    class="field__input focus-inset"
                    autocomplete="name"
                    type="text"
                    id="ContactForm-name"
                    name="contact[{{ 'templates.contact.form.name' | t }}]"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    placeholder="{{ 'templates.contact.form.name' | t }}"
                  >
                  <label class="field__label" for="ContactForm-name">
                    {{- 'templates.contact.form.name' | t -}}
                  </label>
                </div>
                <div class="field field--with-error">
                  <input
                    dir="ltr"
                    autocomplete="email"
                    type="email"
                    id="ContactForm-email"
                    class="field__input focus-inset"
                    name="contact[email]"
                    spellcheck="false"
                    autocapitalize="off"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    aria-required="true"
                    {% if form.errors contains 'email' %}
                      aria-invalid="true"
                      aria-describedby="ContactForm-email-error"
                    {% endif %}
                    placeholder="{{ 'templates.contact.form.email' | t }}"
                    required
                  >
                  <label class="field__label" for="ContactForm-email">
                    {{- 'templates.contact.form.email' | t -}}
                  </label>
                  {%- if form.errors contains 'email' -%}
                    <small class="contact-form__field-error" id="ContactForm-email-error">
                      <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                      <span class="form__message">
                        {{- form.errors.translated_fields.email | capitalize }}
                        {{ form.errors.messages.email -}}
                      </span>
                    </small>
                  {%- endif -%}
                </div>
              </div>
              <div class="field">
                <input
                  dir="ltr"
                  type="tel"
                  id="ContactForm-phone"
                  class="field__input"
                  autocomplete="tel"
                  name="contact[{{ 'templates.contact.form.phone' | t }}]"
                  pattern="[0-9\-]*"
                  placeholder="{{- 'templates.contact.form.phone' | t -}}"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                >
                <label class="field__label" for="ContactForm-phone">
                  {{- 'templates.contact.form.phone' | t -}}
                </label>
              </div>
              <div class="field">
                <textarea
                  id="ContactForm-body"
                  dir="ltr"
                  class="text-area field__input"
                  name="contact[{{ 'templates.contact.form.comment' | t }}]"
                  aria-required="true"
                  placeholder="{{- 'templates.contact.form.comment' | t -}}"
                  required
                >
                  {{- form.body -}}
                </textarea>
                <label
                  class="form__label field__label"
                  for="ContactForm-body"
                >
                  {{- 'templates.contact.form.comment' | t -}}
                </label>
              </div>
              <div class="contact-form__bottom">
                <button type="submit" class="button button--{{ section.settings.button_style }} focus-inset">
                  <span>
                    {{ 'templates.contact.form.send' | t }}
                  </span>
                </button>

                {% if section.settings.additional_text != blank %}
                  <div class="contact-form__add-text body-small">
                    {{ section.settings.additional_text }}
                  </div>
                {% endif %}
              </div>
            {%- endform -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "spaced-section contact-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "settings": [
    {
      "type": "select",
      "id": "position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.contact-form.settings.position.options__1.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.contact-form.settings.position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.contact-form.settings.position.options__3.label"
        }
      ],
      "default": "right",
      "label": "t:sections.contact-form.settings.position.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.contact-form.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_form",
      "default": "background-2",
      "label": "t:sections.contact-form.settings.color_scheme_form.label"
    },
    {
      "type": "text",
      "id": "heading_form",
      "label": "t:sections.contact-form.settings.heading_form.label",
      "default": "t:sections.contact-form.settings.heading_form.default"
    },
    {
      "type": "select",
      "id": "heading_form_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h3",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "text_form",
      "label": "t:sections.contact-form.settings.text_form.label",
      "default": "t:sections.contact-form.settings.text_form.default"
    },
    {
      "type": "inline_richtext",
      "id": "additional_text",
      "label": "t:sections.contact-form.settings.additional_text.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.all.button.button_style.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "m",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "t:sections.contact-form.blocks.info.name",
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "t:sections.all.subheading.label",
          "default": "t:sections.contact-form.blocks.info.settings.subheading.default"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.all.text.label",
          "default": "t:sections.contact-form.blocks.info.settings.text.default"
        },
        {
          "type": "select",
          "id": "text_transform",
          "label": "t:sections.contact-form.blocks.info.settings.text_transform.label",
          "options": [
            {
              "value": "none",
              "label": "t:sections.contact-form.blocks.info.settings.text_transform.options__1.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.contact-form.blocks.info.settings.text_transform.options__2.label"
            },
            {
              "value": "lowercase",
              "label": "t:sections.contact-form.blocks.info.settings.text_transform.options__3.label"
            },
            {
              "value": "capitalize",
              "label": "t:sections.contact-form.blocks.info.settings.text_transform.options__4.label"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name",
      "blocks": [
        {
          "type": "info"
        },
        {
          "type": "info"
        },
        {
          "type": "info"
        }
      ]
