{{ 'section-collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  {% render 'section-padding' %}
  {% render 'section-margin' %}
{%- endstyle -%}

<div
  class="
    collapsible-content color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding
    {% if section.settings.enable_border %} section-border {% if section.settings.border_full %} section-border-full {% endif %} {% endif %}
  "
>
  <div class="container">
    <div class="collapsible-content__wrapper">
      {% render 'section-text',
        section: section,
        class: 'collapsible-content',
        text_align: section.settings.text_align
      %}

      <div class="collapsible-content__content collapsible-content__content--{{ section.settings.layout }} content">
        <div class="collapsible-content__items">
          {%- for block in section.blocks -%}
            <div
              class="collapsible-content__item{% if block.settings.opened %} active{% endif %}{% if section.settings.layout == 'background' %} color-{{ section.settings.row_color_scheme }}{% endif %}{% if forloop.index == 4 and section.settings.buttons_show %} collapsible-content__item--opacity{% endif %}{% if forloop.index > 4 and section.settings.buttons_show %} collapsible-content__item--hidden{% endif %}"
              {{ block.shopify_attributes }}
            >
              <button class="collapsible-content__toggle button--unstyled focus-inset">
                <div class="collapsible-content__toggle-group">
                  {%- if block.settings.question != blank -%}
                    <h3 class="collapsible-content__question">
                      {{ block.settings.question | escape }}
                    </h3>
                  {%- endif -%}
                </div>
                <div class="collapsible-content__icon">
                  {% render 'icon-plus' %}
                  {% render 'icon-minus' %}
                </div>
              </button>

              {%- if block.settings.answer != blank -%}
                <div
                  class="collapsible-content__answer"
                  {% if block.settings.opened %}
                    style="display: block;"
                  {% endif %}
                >
                  <div class="collapsible-content__answer-inner">
                    {{ block.settings.answer }}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        {% if section.blocks.size > 3 and section.settings.buttons_show %}
          <button class="collapsible-content__show--more button button--{{ section.settings.show_more_button_style }} focus-inset">
            <span>{{ 'sections.collapsible_content.show_more' | t }}</span>
          </button>
          <button class="collapsible-content__show--less collapsible-content__show--hidden button button--{{ section.settings.show_less_button_style }} focus-inset">
            <span>{{ 'sections.collapsible_content.show_less' | t }}</span>
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'collapsible-content.js' | asset_url }}" defer="defer"></script>

{% if section.settings.enable_data_schema %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "t:sections.collapsible-content.name",
  "tag": "section",
  "class": "collapsible-content-section spaced-section",
  "enabled_on": {
    "templates": ["*"]
  },
  "blocks": [
    {
      "type": "accordion",
      "name": "t:sections.collapsible-content.blocks.accordion.name",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.all.heading.label",
          "default": "t:sections.collapsible-content.blocks.accordion.settings.question.default"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.all.text.label",
          "default": "t:sections.collapsible-content.blocks.accordion.settings.answer.default"
        },
        {
          "type": "checkbox",
          "id": "opened",
          "label": "t:sections.collapsible-content.blocks.accordion.settings.opened.label",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.collapsible-content.settings.layout.label",
      "options": [
        {
          "value": "border",
          "label": "t:sections.collapsible-content.settings.layout.options__1.label"
        },
        {
          "value": "background",
          "label": "t:sections.collapsible-content.settings.layout.options__2.label"
        }
      ],
      "default": "border"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.all.color_scheme.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.all.enable_border.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_full",
      "label": "t:sections.all.border_full.label",
      "default": false
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.subheading.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.all.heading.label",
      "default": "t:sections.collapsible-content.settings.heading.default"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h3",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__2.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label",
       "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info",
      "visible_if": "{{ section.settings.heading != blank }}"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.all.text.label",
      "default": "t:sections.collapsible-content.settings.text.default"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "t:sections.all.text_align.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_align.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "row_color_scheme",
      "default": "background-2",
      "label": "t:sections.collapsible-content.settings.row_color_scheme.label",
      "info": "t:sections.collapsible-content.settings.row_color_scheme.info"
    },
    {
      "type": "checkbox",
      "id": "enable_data_schema",
      "label": "t:sections.collapsible-content.settings.enable_data_schema.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.button.header_button.content"
    },
    {
      "type": "checkbox",
      "id": "buttons_show",
      "default": true,
      "label": "t:sections.collapsible-content.settings.buttons_show.label",
      "info": "t:sections.collapsible-content.settings.buttons_show.info"
    },
    {
      "type": "select",
      "id": "show_more_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "secondary",
      "label": "t:sections.collapsible-content.settings.show_more.label"
    },
    {
      "type": "select",
      "id": "show_less_button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.all.button.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.all.button.button_style.options__2.label"
        },
        {
          "value": "tertiary",
          "label": "t:sections.all.button.button_style.options__3.label"
        }
      ],
      "default": "secondary",
      "label": "t:sections.collapsible-content.settings.show_less.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.section-margin.header.content"
    },
    {
      "type": "select",
      "id": "margin_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-margin.margin_top.label"
    },
    {
      "type": "select",
      "id": "margin_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-margin.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-margin.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-margin.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-margin.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-margin.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-margin.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-margin.margin_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collapsible-content.name",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "opened": true
          }
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        },
        {
          "type": "accordion"
        }
      ]
    }
  ]
}
{% endschema %}
