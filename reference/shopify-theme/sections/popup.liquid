{% liquid
  if section.settings.layout == 'bar'
    if section.settings.desktop_position != 'bottom' and section.settings.desktop_position != 'top'
      assign width = section.settings.width | append: 'px'
    else
      assign width = '100%'
    endif
  else
    assign width = section.settings.width | append: 'px'
  endif
%}

<div
  class="
    popup-main popup
    popup--{{ section.settings.desktop_position }}
    popup--{{ section.settings.mobile_position }}-mobile
    popup-main-image--{{ section.settings.image_layout }}
    {% if section.settings.mobile_image == blank or section.settings.desktop_image == blank %} popup-main--no-image {% endif %}
    {% if section.settings.mobile_position == 'bottom' %}
      js-mobile-swipe js-mobile-swipe-down
    {% elsif section.settings.mobile_position == 'top' %}
      js-mobile-swipe js-mobile-swipe-up
    {% endif %}
  "
  {% if section.settings['popup-id'] != blank %}
    id="{{ section.settings.popup-id }}"
  {% endif %}
  data-limit-display="{{ section.settings.limit-display }}"
  data-limit-lifetime="{{ section.settings.limit-cache }}"
  data-open-trigger="{{ section.settings.trigger-open }}"
  data-open-delay-number="{{ section.settings.trigger-open-delay }}"
  data-open-scroll-position="{{ section.settings.open-scroll-position }}"
  data-open-scroll-type="{{ section.settings.open-scroll-type }}"
  {% if section.settings['manual-selector'] != blank %}
    data-open-manual-selector="{{ section.settings.manual-selector }}"
  {% endif %}
  data-close-trigger="{{ section.settings.trigger-close }}"
  data-close-delay-number="{{ section.settings.trigger-close-delay }}"
  data-close-scroll-position="{{ section.settings.close-scroll-position }}"
  data-close-scroll-type="{{ section.settings.close-scroll-type }}"
  data-open-animation="popupOpen{{ section.settings.open-animation }}"
  data-exit-animation="popupExit{{ section.settings.exit-animation }}"
  data-overlay="{{ section.settings.show-overlay }}"
  data-mobile-disable="{{ section.settings.mobile }}"
  data-body-scroll-disable="{{ section.settings.scrolling }}"
  data-overlay-close="{{ section.settings.overlay-close }}"
  data-esc-close="{{ section.settings.esc-close }}"
  data-f4-close="{{ section.settings.f4-close }}"
  data-id="{{ section.id }}"
  style="width: {{ width }}"
>
  <div class="popup-mobile-control js-mobile-swipe-control">
    {% render 'icon-mobile-swipe' %}
  </div>
  <div class="popup-wrap color-{{ section.settings.color_scheme }} background">
    <div class="popup-container">
      <div
        class="popup-outer {%- if section.settings.mobile_image != blank or section.settings.desktop_image != blank %} popup-outer_image {% endif %}"
        {% if section.settings.background != blank %}
          style="--background: {{ section.settings.background }};"
        {% endif %}
      >
        {% if section.settings.mobile_image != blank or section.settings.desktop_image != blank %}
          {% liquid
            if section.settings.desktop_image != blank and section.settings.mobile_image == blank
              assign image = section.settings.desktop_image
            elsif section.settings.desktop_image == blank and section.settings.mobile_image != blank
              assign image = section.settings.mobile_image
            elsif section.settings.desktop_image == blank and section.settings.mobile_image == blank
              assign image = blank
            elsif section.settings.desktop_image != blank and section.settings.mobile_image != blank
              assign image = 1
            endif

            if section.settings.mobile_image_ratio == '1/1'
              assign mobile_padding_bottom = 100
              assign settings_aspect_ratio_mobile = 1
            elsif section.settings.mobile_image_ratio == '16/9'
              assign mobile_padding_bottom = 56.25
              assign settings_aspect_ratio_mobile = 1.77
            elsif section.settings.mobile_image_ratio == '3/4'
              assign mobile_padding_bottom = 133.33
              assign settings_aspect_ratio_mobile = 0.75
            elsif section.settings.mobile_image != blank and section.settings.mobile_image_ratio == 'adapt'
              assign mobile_padding_bottom = 1 | divided_by: section.settings.mobile_image.aspect_ratio | times: 100 | round: 2
              assign settings_aspect_ratio_mobile = section.settings.mobile_image.aspect_ratio
            else
              assign mobile_padding_bottom = 0
              assign is_mobile_adapt = true
              assign settings_aspect_ratio_mobile = 1
            endif

            if section.settings.desktop_image_ratio == '1/1'
              assign desktop_padding_bottom = 100
              assign settings_aspect_ratio_desktop = 1
            elsif section.settings.desktop_image_ratio == '16/9'
              assign desktop_padding_bottom = 56.25
              assign settings_aspect_ratio_desktop = 1.77
            elsif section.settings.desktop_image_ratio == '3/4'
              assign desktop_padding_bottom = 133.33
              assign settings_aspect_ratio_desktop = 0.75
            elsif section.settings.desktop_image != blank and section.settings.desktop_image_ratio == 'adapt'
              assign desktop_padding_bottom = 1 | divided_by: section.settings.desktop_image.aspect_ratio | times: 100 | round: 2
              assign settings_aspect_ratio_desktop = section.settings.desktop_image.aspect_ratio
            else
              assign desktop_padding_bottom = 0
              assign is_desktop_adapt = true
              assign settings_aspect_ratio_desktop = 1
            endif
          %}
          {% style %}
            #shopify-section-{{ section.id }} .popup-thumbnail::before {
              content: "";
              display: block;
              width: 0;
              padding-bottom: {{ mobile_padding_bottom }}%;
            }

            @media screen and (min-width: 576px) {
              #shopify-section-{{ section.id }} .popup-thumbnail::before {
                padding-bottom: {{ desktop_padding_bottom }}%;
              }
            }
          {% endstyle %}
          <div class="popup-thumbnail{% if is_mobile_adapt %} popup-thumbnail--mobile-adapt{% endif %}{% if is_desktop_adapt %} popup-thumbnail--desktop-adapt{% endif %}">
            {% capture style %}
              object-fit: {{ section.settings.image_fit }};
            {% endcapture %}
            {% if image != blank and image != 1 %}
              {% liquid
                assign calc_ratio_mobile = 1
                if image.aspect_ratio > settings_aspect_ratio_mobile
                  assign calc_ratio_mobile = image.aspect_ratio | divided_by: settings_aspect_ratio_mobile | round: 2
                endif

                assign calc_ratio_desktop = 1
                if image.aspect_ratio > settings_aspect_ratio_desktop
                  assign calc_ratio_desktop = image.aspect_ratio | divided_by: settings_aspect_ratio_desktop | round: 2
                endif
              %}
              {%- capture sizes -%}
                {%- if section.settings.image_layout == 'top' or section.settings.image_layout == 'bottom' -%}
                  (min-width: 750px) calc({{width}} * {{ calc_ratio_desktop }}), calc(100vw * {{ calc_ratio_mobile }})
                {%- else -%}
                  (min-width: 750px) calc({{width}} * 0.5 * {{ calc_ratio_desktop }}), (min-width: 576px) calc({{width}} * {{ calc_ratio_desktop }}), calc(100vw * {{ calc_ratio_mobile }})
                {%- endif -%}
              {%- endcapture -%}
              {{
                image
                | image_url: width: image.width
                | image_tag:
                  loading: 'lazy',
                  sizes: sizes,
                  widths: '275, 550, 750, 990, 1200, 1360, 1600, 1800',
                  style: style
              }}
            {% elsif image == 1 %}
              {% assign desktop_image = section.settings.desktop_image %}
              {% assign mobile_image = section.settings.mobile_image %}
              {% liquid
                assign calc_ratio_mobile = 1
                if mobile_image.aspect_ratio > settings_aspect_ratio_mobile
                  assign calc_ratio_mobile = mobile_image.aspect_ratio | divided_by: settings_aspect_ratio_mobile | round: 2
                endif

                assign calc_ratio_desktop = 1
                if desktop_image.aspect_ratio > settings_aspect_ratio_desktop
                  assign calc_ratio_desktop = desktop_image.aspect_ratio | divided_by: settings_aspect_ratio_desktop | round: 2
                endif
              %}
              {%- capture sizes -%}
                {%- if section.settings.image_layout == 'top' or section.settings.image_layout == 'bottom' -%}
                  (min-width: 576px) calc({{width}} * {{ calc_ratio_desktop }}), calc(100vw * {{ calc_ratio_mobile }})
                {%- else -%}
                  (min-width: 750px) calc({{width}} * 0.5 * {{ calc_ratio_desktop }}), (min-width: 576px) calc({{width}} * {{ calc_ratio_desktop }}), calc(100vw * {{ calc_ratio_mobile }})
                {%- endif -%}
              {%- endcapture -%}
              <picture>
                <source
                  srcset=" {{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x"
                  media="(max-width: 375px) "
                >
                <source
                  srcset=" {{ mobile_image | image_url: width: 575 }} 1x, {{ mobile_image | image_url: width: 1150 }} 2x"
                  media="(max-width: 575px) "
                >
                <source
                  srcset=" {{ desktop_image | image_url: width: 750 }} 1x, {{ desktop_image | image_url: width: 1500 }} 2x"
                  media="(max-width: 750px) "
                >
                {%- if desktop_image.width > 750 -%}
                  <source
                    srcset=" {{ desktop_image | image_url: width: 1100 }} 1x, {%- if desktop_image.width > 1500 -%} {{ desktop_image | image_url: width: 2200 }} 2x {%- endif -%}"
                    media="(max-width: 1100px)"
                  >
                {%- endif -%}
                {%- if desktop_image.width > 1100 -%}
                  <source
                    srcset=" {{ desktop_image | image_url: width: 1500 }} 1x, {%- if desktop_image.width > 2200 -%} {{ desktop_image | image_url: width: 3000 }} 2x {%- endif -%}"
                    media="(max-width: 1500px)"
                  >
                {%- endif -%}
                {%- if desktop_image.width > 1500 -%}
                  <source
                    srcset=" {{ desktop_image | image_url: width: 1780 }} 1x, {%- if desktop_image.width > 3000 -%} {{ desktop_image | image_url: width: 3560 }} 2x {%- endif -%}"
                    media="(max-width: 1780px)"
                  >
                {%- endif -%}
                {%- if desktop_image.width > 1780 -%}
                  <source
                    srcset=" {{ desktop_image | image_url: width: 2000 }} 1x, {%- if desktop_image.width > 3560 -%} {{ desktop_image | image_url: width: 4000 }} 2x {%- endif -%}"
                    media="(max-width: 2000px)"
                  >
                {%- endif -%}
                <img
                  sizes="{{ sizes }}"
                  src="{{ desktop_image | image_url: width: desktop_image.width }}"
                  loading="lazy"
                  alt="{{ desktop_image.alt | escape }}"
                  width="{{ desktop_image.width }}"
                  height="{{ desktop_image.width | divided_by: desktop_image.aspect_ratio }}"
                  style="--focal_point_desktop: {{ desktop_image.presentation.focal_point }}; --focal_point_mobile: {{ mobile_image.presentation.focal_point }}; {{ style }}"
                >
              </picture>
            {% endif %}
          </div>
        {% endif %}
        <div
          class="popup-content {% if section.settings.background != blank %} popup-content_bg {% endif %}"
          style="--opacity: {{ section.settings.overlay_opacity }};"
        >
          <div class="popup-wraper-text">
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'popup_heading' -%}
                  {% if block.settings.heading != blank %}
                    <h3 class="popup-heading" {{ block.shopify_attributes }}>
                      {{ block.settings.heading | newline_to_br }}
                    </h3>
                  {% endif %}
                {%- when 'popup_description' -%}
                  {% if block.settings.description != blank %}
                    <p class="popup-description" {{ block.shopify_attributes }}>
                      {{ block.settings.description | newline_to_br }}
                    </p>
                  {% endif %}
                {%- when 'subscribe_form' -%}
                  {% form 'customer', class: 'newsletter-form' %}
                    <div
                      class="newsletter-form__inner {% if section.settings.width <= 500 %} newsletter-form__inner_column {% endif %} color-{{ block.settings.color_scheme }}"
                      {{ block.shopify_attributes }}
                    >
                      <input type="hidden" name="contact[tags]" value="newsletter">
                      <div class="newsletter-form__field-wrapper">
                        <div class="field">
                          <input
                            dir="ltr"
                            id="NewsletterForm--{{ section.id }}"
                            type="email"
                            name="contact[email]"
                            class="field__input field"
                            value="{{ form.email }}"
                            aria-required="true"
                            autocorrect="off"
                            autocapitalize="off"
                            autocomplete="email"
                            pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                            {% if form.errors %}
                              autofocus
                              aria-invalid="true"
                              aria-describedby="Newsletter-error--{{ section.id }}"
                            {% elsif form.posted_successfully? %}
                              aria-describedby="Newsletter-success--{{ section.id }}"
                            {% endif %}
                            placeholder="{{ block.settings.placeholder_input }}"
                            required
                          >
                          <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                            {{ 'newsletter.label' | t }}
                          </label>
                        </div>
                        {%- if form.errors -%}
                          <small
                            class="newsletter-form__message form__message"
                            id="Newsletter-error--{{ section.id }}"
                          >
                            {%- render 'icon-error' -%}
                            {{- form.errors.translated_fields.email | capitalize }}
                            {{ form.errors.messages.email -}}
                          </small>
                        {%- endif -%}
                      </div>
                      <button
                        type="submit"
                        class="button button--{{ block.settings.button_style }} focus-inset"
                        name="commit"
                      >
                        <span>{{ block.settings.button_label }}</span>
                      </button>
                    </div>
                    {%- if form.posted_successfully? -%}
                      <h3
                        class="newsletter-form__message newsletter-form__message--success form__message"
                        id="Newsletter-success--{{ section.id }}"
                        tabindex="-1"
                        autofocus
                      >
                        {% render 'icon-success' -%}
                        {{- 'newsletter.success' | t }}
                      </h3>
                    {%- endif -%}
                    {% if block.settings.description != blank %}
                      <div class="popup-text" {{ block.shopify_attributes }}>
                        {{ block.settings.description }}
                      </div>
                    {% endif %}
                  {% endform %}
                {%- when 'social_links' -%}
                  {% if block.settings.show_twitter
                    and settings.social_twitter_link != blank
                    or block.settings.show_facebook
                    and settings.social_facebook_link != blank
                    or block.settings.show_pinterest
                    and settings.social_pinterest_link != blank
                    or block.settings.show_instagram
                    and settings.social_instagram_link != blank
                    or block.settings.show_tiktok
                    and settings.social_tiktok_link != blank
                    or block.settings.show_tumblr
                    and settings.social_tumblr_link != blank
                    or block.settings.show_snapchat
                    and settings.social_snapchat_link != blank
                    or block.settings.show_youtube
                    and settings.social_youtube_link != blank
                    or block.settings.show_vimeo
                    and settings.social_vimeo_link != blank
                  %}
                    <ul
                      class="list-unstyled list-social"
                      role="list"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.show_twitter and settings.social_twitter_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_twitter_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-twitter' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.twitter' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_facebook and settings.social_facebook_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_facebook_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-facebook' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.facebook' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_pinterest and settings.social_pinterest_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_pinterest_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-pinterest' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.pinterest' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_instagram and settings.social_instagram_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_instagram_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-instagram' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.instagram' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_tiktok and settings.social_tiktok_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_tiktok_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-tiktok' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.tiktok' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_tumblr and settings.social_tumblr_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_tumblr_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-tumblr' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.tumblr' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_snapchat and settings.social_snapchat_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_snapchat_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-snapchat' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.snapchat' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_youtube and settings.social_youtube_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_youtube_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-youtube' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.youtube' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if block.settings.show_vimeo and settings.social_vimeo_link != blank -%}
                        <li class="list-social__item">
                          <a
                            href="{{ settings.social_vimeo_link }}"
                            class="link link--text list-social__link"
                          >
                            {%- render 'icon-vimeo' -%}
                            <span class="visually-hidden">
                              {{- 'general.social.links.vimeo' | t -}}
                            </span>
                          </a>
                        </li>
                      {%- endif -%}
                    </ul>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>

          <button
            type="button"
            class="link modal-close-button popup-close focus-inset"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {% render 'icon-close' %}
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
{% if section.settings['show-overlay'] %}
  <div class="popup-overlay"></div>
{% endif %}

{% schema %}
{
  "name": "t:sections.overlay-group.popup.name",
  "class": "overlay-group-popup",
  "enabled_on": {
    "groups": ["custom.overlay"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.overlay-group.popup.settings.mobile_image.label"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "t:sections.overlay-group.popup.settings.desktop_image.label"
    },
    {
      "type": "select",
      "id": "image_layout",
      "label": "t:sections.overlay-group.popup.settings.image_layout.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.overlay-group.popup.settings.image_layout.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.overlay-group.popup.settings.image_layout.options__2.label"
        },
        {
          "value": "top",
          "label": "t:sections.overlay-group.popup.settings.image_layout.options__3.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.overlay-group.popup.settings.image_layout.options__4.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__1.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__4.label"
        }
      ],
      "default": "16/9",
      "label": "t:sections.overlay-group.all.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "desktop_image_ratio",
      "options": [
        {
          "value": "1/1",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__1.label"
        },
        {
          "value": "16/9",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__2.label"
        },
        {
          "value": "3/4",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__3.label"
        },
        {
          "value": "adapt",
          "label": "t:sections.overlay-group.all.settings.image_ratio.options__4.label"
        }
      ],
      "default": "1/1",
      "label": "t:sections.overlay-group.all.settings.image_ratio.label_secondary"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "limit-display",
      "min": 0,
      "max": 100,
      "default": 0,
      "label": "t:sections.overlay-group.all.settings.limit-display.label",
      "info": "t:sections.overlay-group.all.settings.limit-display.info"
    },
    {
      "type": "number",
      "id": "limit-cache",
      "default": 30,
      "label": "t:sections.overlay-group.all.settings.limit-cache.label"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.overlay-group.all.settings.position.options__2.label"
        },
        {
          "value": "center",
          "label": "t:sections.overlay-group.all.settings.position.options__5.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.overlay-group.all.settings.position.options__8.label"
        }
      ],
      "default": "bottom",
      "label": "t:sections.overlay-group.all.settings.mobile_position.label"
    },
    {
      "type": "select",
      "id": "desktop_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.overlay-group.all.settings.position.options__1.label"
        },
        {
          "value": "top",
          "label": "t:sections.overlay-group.all.settings.position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.overlay-group.all.settings.position.options__3.label"
        },
        {
          "value": "left",
          "label": "t:sections.overlay-group.all.settings.position.options__4.label"
        },
        {
          "value": "center",
          "label": "t:sections.overlay-group.all.settings.position.options__5.label"
        },
        {
