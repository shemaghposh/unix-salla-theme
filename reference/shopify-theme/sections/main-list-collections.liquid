{{ 'template-list-collections.css' | asset_url | stylesheet_tag }}
{%- if settings.pagination_type == 'load_more' or settings.pagination_type == 'infinite_scroll' -%}
  <script src="{{ 'load-more.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  {% render 'section-padding' %}
{%- endstyle -%}

<div class="section-{{ section.id }}-padding {% if section.settings.enable_border %} section-border collections-list--border {% endif %}">
  <div class="container">
    <div class="page-header">
      <div class="page-header__inner">
        <{{ section.settings.heading_tag | default: 'h1' }} class="main-page-title page-title title--page h2">{{ section.settings.title | escape }}</{{ section.settings.heading_tag | default: 'h1' }}>
      </div>
      <div class="collections-list__description body-large">
        {{ section.settings.description | newline_to_br }}
      </div>
    </div>

    {%- liquid
      case section.settings.sort
        when 'products_high', 'products_low'
          assign collections = collections | sort: 'all_products_count'
        when 'date', 'date_reversed'
          assign collections = collections | sort: 'published_at'
        when 'alphabetical', 'alphabetical_reversed'
          assign collections = collections | sort: 'title'
      endcase

      if section.settings.sort == 'products_high' or section.settings.sort == 'date_reversed' or section.settings.sort == 'alphabetical_reversed'
        assign collections = collections | reverse
      endif

      assign paginate_by = section.settings.collections_to_show | times: 6
    -%}

    {%- paginate collections by paginate_by -%}
      {% if paginate.current_page == 1 %}
        {% assign items_first = 1 %}
      {% else %}
        {% assign items_first = paginate.current_page | times: paginate_by | minus: paginate_by | plus: 1 %}
      {% endif %}
      {% assign items_last = paginate.current_page | times: paginate_by %}

      <ul
        class="
          collections-list collections-grid collections-grid--simple
          collections-grid--{{ section.settings.collections_to_show }}
          collections-grid--{{ section.settings.columns_mobile }}-mobile load-more-grid
          {% if section.settings.enable_border_top %} collections-list_border {% endif %}
        "
        role="list"
      >
        {%- for collection in collections -%}
          {% if forloop.index >= items_first and forloop.index <= items_last %}
            <li
              class="
                collections-grid__item  collections-grid__item--{{ collection.id }}
                collections-grid__item--simple
                {% if section.settings.image_ratio == 'portrait' or section.settings.image_ratio == 'portrait' %} collections-grid__card--portrait {% endif %}
                collections-grid__item--{{- section.settings.image_ratio }}
              "
            >
              {% assign collection_product_image = collection.featured_image %}

              {% if section.settings.image_ratio == 'adapt' and collection_product_image != blank %}
                {% style %}
                  .collections-grid__item--{{ collection.id }} .collections-grid__image {
                    padding-bottom: {{ 1 | divided_by: collection_product_image.aspect_ratio | times: 100 }}%;
                  }
                {% endstyle %}
              {% endif %}

              {%- if collection_product_image != blank -%}
                {% liquid
                  assign columns = section.settings.collections_to_show

                  if section.settings.image_ratio == 'portrait'
                    assign settings_aspect_ratio = 0.8
                  elsif section.settings.image_ratio == 'landscape'
                    assign settings_aspect_ratio = 1.78
                  elsif section.settings.image_ratio == 'square'
                    assign settings_aspect_ratio = 1
                  else
                    assign settings_aspect_ratio = collection_product_image.aspect_ratio
                  endif

                  assign width_ratio = 1
                  if collection_product_image.aspect_ratio > settings_aspect_ratio
                    assign width_ratio = collection_product_image.aspect_ratio | divided_by: settings_aspect_ratio | round: 2
                  endif
                %}
                <div
                  class="collections-grid__image collections-grid__image--{{ section.settings.image_ratio }} collections-grid__image--{{- section.settings.image_fit -}}"
                >
                  {% assign columns = section.settings.collections_to_show %}
                  {%- capture sizes -%}
                    {%- if columns == 6 -%}
                      (min-width: 1600px) calc({{ width_ratio }} * (100vw - 40px) / 6),
                    {%- endif -%}
                    {%- if columns >= 5 -%}
                      (min-width: 1360px) calc({{ width_ratio }} * (100vw - 40px) / 5),
                    {%- endif -%}
                    {%- if columns >= 4 -%}
                      (min-width: 1200px) calc({{ width_ratio }} * (100vw - 40px) / 4),
                    {%- endif -%}
                    {%- if columns >= 3 -%}
                      (min-width: 990px) calc({{ width_ratio }} * (100vw - 40px) / 3),
                    {%- endif -%}
                    {%- if columns >= 2 -%}
                      (min-width: 750px) calc({{ width_ratio }} * (100vw - 40px) / 2),
                    {%- endif -%}
                    calc((100vw - 40px)) * {{ width_ratio }}
                  {%- endcapture -%}

                  {{
                    collection_product_image
                    | image_url: width: collection_product_image.width
                    | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '360, 550, 750, 900, 1100, 1420, 1700, 1920, 2200, 2400, 2600'
                  }}
                </div>
              {% endif %}
              <div class="collections-grid__information">
                {% if section.settings.subtitle_card %}
                  <span class="collections-grid__subtitle-card subtitle">
                    {{ section.settings.subtitle_card }}
                  </span>
                {% endif %}
                <h2 class="collections-grid__title body-font body-xl">
                  <span>{{- collection.title -}}</span>
                </h2>
                {% if section.settings.show_desc %}
                  {%- if collection.description != blank -%}
                    <p class="collections-grid__desc">
                      {{- collection.description | strip_html | truncatewords: 50, '...' -}}
                    </p>
                  {% endif %}
                {% endif %}
              </div>
              <a
                href="{{ collection.url | default: '#' }}"
                class=" collections-grid__link_overlay"
                aria-label="{{ collection.title }}"
              >
                <span class="visibility-hidden">{{ collection.title }}</span>
              </a>
            </li>
          {% endif %}
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {%- if settings.pagination_type == 'load_more' -%}
          {% render 'load-more',
            next_url: paginate.next.url,
            count_pages: paginate.pages,
            current_page: paginate.current_page
          %}
          <div class="js-hidden">
            {% render 'pagination', paginate: paginate %}
          </div>
        {%- elsif settings.pagination_type == 'infinite_scroll' -%}
          {% render 'infinite-scroll',
            next_url: paginate.next.url,
            count_pages: paginate.pages,
            current_page: paginate.current_page
          %}
          <div class="js-hidden">
            {% render 'pagination', paginate: paginate %}
          </div>
        {% else %}
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-list-collections.name",
  "tag": "section",
  "class": "section-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.main-list-collections.settings.title.label",
      "default": "t:sections.main-list-collections.settings.title.default"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.all.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.all.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.all.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.all.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.all.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.all.heading_tag.options__7.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_tag.label",
      "info": "t:sections.all.heading_tag.info"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.main-list-collections.settings.description.label",
      "default": "t:sections.main-list-collections.settings.description.default"
    },
    {
      "type": "select",
      "id": "sort",
      "options": [
        {
          "value": "alphabetical",
          "label": "t:sections.main-list-collections.settings.sort.options__1.label"
        },
        {
          "value": "alphabetical_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__2.label"
        },
        {
          "value": "date_reversed",
          "label": "t:sections.main-list-collections.settings.sort.options__3.label"
        },
        {
          "value": "date",
          "label": "t:sections.main-list-collections.settings.sort.options__4.label"
        },
        {
          "value": "products_high",
          "label": "t:sections.main-list-collections.settings.sort.options__5.label"
        },
        {
          "value": "products_low",
          "label": "t:sections.main-list-collections.settings.sort.options__6.label"
        }
      ],
      "default": "alphabetical",
      "label": "t:sections.main-list-collections.settings.sort.label"
    },
    {
      "type": "checkbox",
      "id": "enable_border_top",
      "label": "t:sections.main-list-collections.settings.enable_border_top.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "t:sections.main-list-collections.settings.enable_border.label",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__1.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__3.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-list-collections.settings.image_ratio.options__4.label"
        }
      ],
      "default": "landscape",
      "label": "t:sections.main-list-collections.settings.image_ratio.label",
      "info": "t:sections.main-list-collections.settings.image_ratio.info"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:sections.all.card.image_fit.label",
      "options": [
        {
          "value": "contain",
          "label": "t:sections.all.card.image_fit.options__1.label"
        },
        {
          "value": "cover",
          "label": "t:sections.all.card.image_fit.options__2.label"
        }
      ],
      "default": "cover"
    },
    {
      "type": "text",
      "id": "subtitle_card",
      "label": "t:sections.main-list-collections.settings.subtitle_card.label",
      "default": "t:sections.main-list-collections.settings.subtitle_card.default"
    },
    {
      "type": "checkbox",
      "id": "show_desc",
      "default": true,
      "label": "t:sections.main-list-collections.settings.show_desc.label"
    },
    {
      "type": "range",
      "id": "collections_to_show",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.main-list-collections.settings.collections_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "1",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.section-padding.header.content"
    },
    {
      "type": "select",
      "id": "padding_top",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "no-indent",
      "label": "t:sections.all.section-padding.padding_top.label"
    },
    {
      "type": "select",
      "id": "padding_bottom",
      "options": [
        {
          "value": "no-indent",
          "label": "t:sections.all.section-padding.options__1.label"
        },
        {
          "value": "xs",
          "label": "t:sections.all.section-padding.options__2.label"
        },
        {
          "value": "s",
          "label": "t:sections.all.section-padding.options__3.label"
        },
        {
          "value": "m",
          "label": "t:sections.all.section-padding.options__4.label"
        },
        {
          "value": "l",
          "label": "t:sections.all.section-padding.options__5.label"
        },
        {
          "value": "xl",
          "label": "t:sections.all.section-padding.options__6.label"
        }
      ],
      "default": "l",
      "label": "t:sections.all.section-padding.padding_bottom.label"
    }
  ]
}
{% endschema %}
