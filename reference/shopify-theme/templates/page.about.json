    "collapsible-content": {
      "type": "collapsible-content",
      "blocks": {
        "block_1": {
          "type": "accordion",
          "settings": {
            "question": "What sizing options do you offer?",
            "answer": "<p>Our collection caters to a diverse range of body types, offering sizes from XS to XXL. We also feature selections for petite, tall, and plus sizes to ensure a perfect fit for everyone.</p>",
            "opened": true
          }
        },
        "block_2": {
          "type": "accordion",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order has been shipped, you will receive a confirmation email containing a tracking number and a link to follow the delivery progress.</p>",
            "opened": false
          }
        },
        "block_3": {
          "type": "accordion",
          "settings": {
            "question": "Do you offer international shipping?",
            "answer": "<p>Yes, we are pleased to offer international shipping to most countries. Shipping costs and delivery times vary depending on the destination.</p>",
            "opened": false
          }
        },
        "block_4": {
          "type": "accordion",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We accept returns within 30 days of purchase for most items in new, unused condition with original tags attached. Refunds will be processed in the original form of payment. Some exclusions may apply, and return shipping fees are the responsibility of the customer.</p>",
            "opened": false
          }
        },
        "block_5": {
          "type": "accordion",
          "settings": {
            "question": "Can I change or cancel my order?",
            "answer": "<p>We understand that you may need to make changes to your order. While we cannot modify orders once they have been placed, you can cancel your order within 24 hours of placement and create a new order with your desired changes. </p>",
            "opened": false
          }
        },
        "accordion_88CNyn": {
          "type": "accordion",
          "settings": {
            "question": "How do I apply a promo code?",
            "answer": "<p>To apply a promo code to your order, proceed to checkout and locate the 'Promo Code' field on the payment page. Enter your code exactly as it appears, then click 'Apply' to see your new total. Note that only one promo code can be used per order.</p>",
            "opened": false
          }
        }
      },
