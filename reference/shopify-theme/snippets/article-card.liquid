{% comment %}
  	Renders an article card for a given blog with settings to either show the image or not.

  	Accepts:
  	- blog: {Object} Blog object
  	- article: {Object} Article object
  	- show_image: {String} The setting either show the article image or not. If it's not included it will show the image by default
  	- show_date: {String} The setting either show the article date or not. If it's not included it will not show the image by default
  	- show_author: {String} The setting either show the article author or not. If it's not included it will not show the author by default

  	Usage:
  {% render 'article-card' blog: blog, article: article, show_image: section.settings.show_image %}
{% endcomment %}

{% if article.metafields.custom.author_image != blank %}
  {%- assign author_image = article.metafields.custom.author_image -%}
{% elsif section_author_image != blank %}
  {%- assign author_image = section_author_image -%}
{% endif %}

<article
  class="article-card"
  aria-labelledby="Article-{{ article.id }}"
>
  {%- if show_image == true and article.image -%}
    <div class="article-card__image article-card__image--{{ image_ratio }}">
      {% if sizes == blank %}
        {% capture sizes %}
          calc((100vw - 40px))
        {% endcapture %}
      {% endif %}
      {{
        article.image
        | image_url: width: article.image.width
        | image_tag: loading: 'lazy', sizes: sizes, widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920'
      }}
    </div>
  {%- endif -%}
  <div class="article-content motion-reduce">
    <div class="article-card__info">
      {% liquid
        assign is_visible_top = false
        if show_tags and article.tags != blank or show_date or article.comments_count > 0 and blog.comments_enabled?
          assign is_visible_top = true
        endif
      %}
      {% if is_visible_top %}
        <div class="article-card__top">
          {%- if show_tags and article.tags != blank -%}
            <ul class="article-card__tags">
              {% for tag in article.tags %}
                <li class="article-card__tag body-small">
                  {% if blog.url != blank %}
                    <a href="{{ blog.url }}/tagged/{{ tag | handle }}">
                      <span title="{{ tag }}">{{ tag }}</span>
                    </a>
                  {% else %}
                    <span title="{{ tag }}">{{ tag }}</span>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          {%- endif -%}
          {% if show_date or article.comments_count > 0 and blog.comments_enabled? %}
            <div class="article-card__meta">
              {%- if show_date -%}
                <span class="article-card__date body-small">
                  {{- article.published_at | time_tag: format: 'abbreviated_date' -}}
                </span>
              {%- endif -%}
              {%- if article.comments_count > 0 and blog.comments_enabled? -%}
                <span class="article-card__comments body-small">
                  {{- 'blogs.article.comments' | t: count: article.comments_count -}}
                </span>
              {%- endif -%}
            </div>
          {% endif %}
        </div>
      {% endif %}
      <header class="article-card__header">
        <{{ heading_tag | default: 'h3' }}
          class="article-card__title h3"
          id="Article-{{ article.id }}"
        >
          <a href="{{ article.url }}">
            {{ article.title | escape }}
          </a>
        </{{ heading_tag | default: 'h3' }}>
        {%- if show_excerpt and article.excerpt_or_content.size > 0 -%}
          <p class="article-card__excerpt body-small">
            {{ article.excerpt_or_content | strip_html | truncate: 150 }}
          </p>
        {%- endif -%}
      </header>

      {% if show_author %}
        <div class="article-card__author body-small">
          <span>{{- 'general.blog.author' | t -}}</span>
          {% if author_image %}
            <div class="article-card__author-image">
              {{ author_image | image_url: width: author_image.width | image_tag: loading: 'lazy', widths: '50, 100' }}
            </div>
          {% endif %}
          <span class="article-card__author-name">{{- article.author -}}</span>
        </div>
      {% endif %}
    </div>
  </div>
  <a class="article-card-link" href="{{ article.url }}" aria-label="{{ 'accessibility.article_link' | t }}"></a>
</article>
