{% comment %}
  	Renders a product card placeholder
  	Usage:
  {% render 'product-card-placeholder' %}
{% endcomment %}

{% liquid
  assign aspect_ratio = media_ratio | split: '/'
  assign temp = aspect_ratio[0] | append: '.0'
  assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2

  assign placeholder_index = 1
  if product_number != blank
    assign placeholder_index = product_number | modulo: 4 | plus: 1
  endif
%}

<div class="card-wrapper card-wrapper--{{ settings.card_secondary_text }}">
  <div class="card card--product card--product-placeholder" tabindex="-1">
    <div class="card__inner">
      <div
        class="media media--transparent media--hover-effect"
        style="padding-bottom: {{ padding_bottom }}%;"
      >
        {{ 'product-apparel-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    </div>
  </div>

  <div class="card-information">
    <div class="card-information__wrapper">
      {%- if show_vendor -%}
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        <div class="card__vendor body-small">
          {{ 'products.product.vendor' | t }}
        </div>
      {%- endif -%}
      <div class="card__group">
        <{{ heading_tag | default: 'h3' }} class="card__title">
          {{ 'products.product.product_heading' | t }}
        </{{ heading_tag | default: 'h3' }}>
      </div>
      {% render 'price' %}
    </div>
  </div>
</div>
