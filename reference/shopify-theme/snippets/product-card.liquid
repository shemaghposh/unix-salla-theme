{% comment %}
  	Renders a product card
  	Accepts:
  	- product_card_product: {Object} Product Liquid object (optional)
  	- show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  	- show_vendor: {Boolean} Show the product vendor. Default: true
  	- show_desc: {Boolean} Show the product vendor. Default: false
  	- section_id: {String} The ID of the section that contains this card.
  	Usage:
  {% render 'product-card', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{% liquid
  assign aspect_ratio = media_ratio | split: '/'
  assign temp = aspect_ratio[0] | append: '.0'
  assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2
%}

{%- if settings.show_on_mobile or settings.quickview_show or settings.add_to_cart_enabled -%}
  {%- assign first_3d_model = product_card_product.media | where: 'media_type', 'model' | first -%}

  {%- if first_3d_model -%}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product_card_product.id }}">
      {{ product_card_product.media | where: 'media_type', 'model' | json }}
    </script>
  {%- endif -%}
{%- endif -%}

<div
  class="
    card-wrapper js-color-swatches-wrapper {% if small %} card-wrapper_small {% endif %}
    card-wrapper--{{ settings.card_secondary_text }}
  "
  data-product="{{ product_card_product.handle }}"
>
  <span class="visually-hidden">{{ product_card_product.title | escape }}</span>

  <div class="card card--product" tabindex="-1">
    {%- comment -%} UNIX: Swym wishlist heart {%- endcomment -%}
    {% render 'swym-heart', product: product_card_product %}

    <div class="card__inner full-unstyled-link">
      <div
        class="media media--transparent media--hover-effect"
        style="padding-bottom: {{ padding_bottom }}%;"
      >
        {%- if product_card_product.featured_media -%}
          {% liquid
            assign aspect_ratio_settings = aspect_ratio[1] | divided_by: temp
            assign aspect_ratio_img_width = product_card_product.featured_media.height | plus: 0.0 | divided_by: product_card_product.featured_media.width | round: 2
            assign aspect_ratio_img_height = product_card_product.featured_media.width | plus: 0.0 | divided_by: product_card_product.featured_media.height | round: 2

            assign width_ratio = 1
            if aspect_ratio_settings < 1
              if aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width > 1
                assign width_ratio = aspect_ratio_img_width
              elsif aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width < 1
                assign width_ratio = aspect_ratio_img_height
              elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width < 1
                assign width_ratio = aspect_ratio_img_height
              else

              endif
            else
              if aspect_ratio_settings < aspect_ratio_img_width and aspect_ratio_img_width > 1
                assign width_ratio = aspect_ratio_img_width
              elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width > 1
                assign width_ratio = aspect_ratio_settings
              elsif aspect_ratio_settings > aspect_ratio_img_width and aspect_ratio_img_width < 1
                assign width_ratio = aspect_ratio_img_height | times: aspect_ratio_settings | round: 2 | plus: aspect_ratio_img_width
              else
                assign width_ratio = aspect_ratio_settings | plus: 0.25
              endif
            endif
          %}

          {%- if columns -%}
            {%- capture sizes -%}
              {% if columns == 5 %}
                (min-width: 1600px) calc(((100vw - 40px) / 5) * {{ width_ratio }}),
              {% endif %}
              {% if columns >= 4 %}
                (min-width: 1360px) calc(((100vw - 40px) / 4) * {{ width_ratio }}),
              {% endif %}
              {% if columns >= 3 %}
                (min-width: 990px) calc(((100vw - 40px) / 3) * {{ width_ratio }}),
              {% endif %}
              (min-width: 576px) calc(((100vw - 40px) / 2) * {{ width_ratio }}), calc(((100vw - 40px)) * {{ width_ratio }})
            {%- endcapture -%}
          {%- else -%}
            {%- capture sizes -%}
              (min-width: 1100px) calc(535px * {{ width_ratio }}), (min-width: 750px) calc(((100vw - 130px) / 2) * {{ width_ratio }}), calc(((100vw - 50px) / 2) * {{ width_ratio }})
            {%- endcapture -%}
          {% endif %}

          {%- capture style -%}
            {%- if media_fit == 'contain' -%}
              object-fit: contain;
            {%- endif -%}
            {%- if media_fit == 'cover' -%}
              object-fit: cover;
            {%- endif -%}
          {%- endcapture -%}

          {{
            product_card_product.featured_media
            | image_url: width: product_card_product.featured_media.width
            | image_tag:
              loading: 'lazy',
              class: 'motion-reduce media--first',
              widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920',
              sizes: sizes,
              style: style
          }}

          {%- if product_card_product.media[1] != null and show_secondary_image -%}
            {{
              product_card_product.media[1]
              | image_url: width: product_card_product.media[1].width
              | image_tag:
                loading: 'lazy',
                class: 'motion-reduce media--second',
                widths: '375, 425, 576, 768, 990, 1100, 1360, 1600, 1920',
                sizes: sizes,
                style: style
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="card__information-top">
        {%- if settings.badge_sale_show or settings.badge_soldout_show or settings.badge_custom_show -%}
          <div class="card__badge body-xs">
            {%- if product_card_product.available == false and settings.badge_soldout_show -%}
              <span
                class="badge badge--soldout color-{{ settings.badge_soldout_color_scheme }}"
                aria-hidden="true"
              >
                {{- 'products.product.sold_out' | t -}}
              </span>
            {%- elsif product_card_product.compare_at_price > product_card_product.price
              and product_card_product.available
              and settings.badge_sale_show
            -%}
              <span class="badge badge--sale color-{{ settings.badge_sale_color_scheme }}" aria-hidden="true">
                {% if settings.badge_sale_type == 'sale' %}
                  {{- 'products.product.on_sale' | t -}}
                {% else %}
                  {{- 'products.product.on_sale' | t -}}
                  <span>
                    {{
                      product_card_product.compare_at_price
                      | minus: product_card_product.price
                      | times: 100
                      | divided_by: product_card_product.compare_at_price
                    -}}
                    %
                  </span>
                {% endif %}
              </span>
            {%- endif -%}
            {% if settings.badge_custom_show
              and product_card_product.metafields.custom.badges != blank
              and small != true
            %}
              {% if product_card_product.metafields.custom.badges.list? %}
                {% for badge in product_card_product.metafields.custom.badges.value %}
                  <span class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}" aria-hidden="true">
                    {{ badge }}
                  </span>
                {% endfor %}
              {% else %}
                <span class="badge badge--custom color-{{ settings.badge_custom_color_scheme }}" aria-hidden="true">
                  {{ product_card_product.metafields.custom.badges }}
                </span>
              {% endif %}
            {% endif %}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if settings.add_to_cart_enabled
      and product_card_product.selected_or_first_available_variant.available
      and product_card_product.has_only_default_variant
      or product_card_product.options.size == 1
      and settings.type_color_swatch == 'custom'
      and product_card_product.options[0] == settings.trigger_swatch
    -%}
      {%- assign product_form_id = 'quick-add-' | append: section_id | append: product_card_product.id -%}
      <product-form class="card__add-to-cart card__button" data-source="{{ section_id }}">
        {%- form 'product',
          product_card_product,
          id: product_form_id,
          class: 'form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            value="{{ product_card_product.selected_or_first_available_variant.id }}"
            disabled
          >
          <button
            id="{{ product_form_id }}-submit"
            type="submit"
            class="
              card__link button
              button--{{ settings.quickview_button_style }}
              mobile-button--{{ settings.quickview_button_style_mobile }}
              card__link--{{ settings.quickview_button_layout }}
              {% if settings.show_on_mobile -%}card__link--show{%- endif %}
              card-focused color-{{ settings.quick_buy_color_scheme }}
            "
            name="add"
            aria-haspopup="dialog"
            aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
            aria-live="polite"
            data-sold-out-message="true"
            {% if product_card_product.selected_or_first_available_variant.available == false %}
              disabled
            {% endif %}
            aria-label="{{- 'general.card.quick__add' | t -}}"
          >
            {% if settings.quickview_button_style_mobile == 'link' %}
              <div class="mobile-button--link-wrapper">
            {% endif %}

            {% if settings.quickview_button_style == 'link' or settings.quickview_button_style_mobile == 'link' %}
              {% render 'icon-cart' %}
            {% endif %}

            {% if settings.quickview_button_style != 'link' or settings.quickview_button_style_mobile != 'link' %}
              <span class="card__quickview-text">
                {{- 'general.card.quick__add' | t -}}
              </span>
            {% endif %}
            <span class="sold-out-message hidden">
              {{ 'products.product.sold_out' | t }}
            </span>
            <div class="loading-overlay__spinner hidden">
              <div class="spinner"></div>
            </div>
            {% if settings.quickview_button_style_mobile == 'link' %}
              </div>
            {% endif %}
          </button>
        {%- endform -%}
      </product-form>
    {%- elsif settings.show_on_mobile and product_card_product.selected_or_first_available_variant.available -%}
      <style>
        @media screen and (max-width: 989px) {
          .quick-add-modal_desktop {
            display: none;
          }
        }
        @media screen and (min-width: 990px) {
          .quick-add-modal_mobile {
            display: none;
          }
        }
      </style>
      <div class="quick-add no-js-hidden">
        {%- assign product_form_id = 'quick-add-' | append: section_id | append: product_card_product.id -%}
        <modal-opener-quick-view data-modal="#QuickAdd-{{ product_card_product.id }}">
          <button
            id="{{ product_form_id }}-submit"
            type="submit"
            name="add"
            class="
              card__link button
              mobile-button--{{ settings.quickview_button_style_mobile }} mobile-button--qv
              card__link--{{ settings.quickview_button_layout }}
              card__link--show
              card-focused color-{{ settings.quick_buy_color_scheme }}
            "
            {% if settings.quickview_button_style_mobile == 'link' %}
              aria-label="{{- 'products.product.choose_options' | t -}}"
            {% endif %}
            aria-haspopup="dialog"
            aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
            data-product-url="{{ product_card_product.url }}"
            data-modal-aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
            data-product-id="{{ product_card_product.id }}"
            data-modal-id="QuickAdd-{{ product_card_product.id }}"
            data-modal-class="quick-add-modal{% if settings.quickview_show == false %} quick-add-modal_mobile{% endif %}"
          >
            {% if settings.quickview_button_style_mobile == 'link' %}
              <div class="mobile-button--link-wrapper">
                {% render 'icon-cart' %}
            {% else %}
              <span class="card__quickview-text">
                {{- 'products.product.choose_options' | t -}}
              </span>
            {% endif %}
            <div class="loading-overlay__spinner hidden">
              <div class="spinner"></div>
            </div>
            {% if settings.quickview_button_style_mobile == 'link' %}
              </div>
            {% endif %}
          </button>
        </modal-opener-quick-view>
      </div>
    {%- endif -%}
  </div>

  <div class="card-information">
    <div class="card-information__wrapper">
      {%- if show_vendor and product_card_product.vendor -%}
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        <div class="card__vendor body-small {% if settings.enable_vendor_link %} card__vendor_link {% endif %}">
          {% if settings.enable_vendor_link %}
            {{ product_card_product.vendor | link_to_vendor: class: 'focus-inset' }}
          {% else %}
            {{ product_card_product.vendor }}
          {% endif %}
        </div>
      {%- endif -%}
      <div class="card__group">
        <{{ heading_tag | default: 'h3' }} class="card__title h3">
          <a
            class="full-unstyled-link"
            href="{{ product_card_product.url | default: '#' }}"
          >
            {{- product_card_product.title | escape -}}
          </a>
        </{{ heading_tag | default: 'h3' }}>

        {%- comment -%} UNIX: Judge.me star rating {%- endcomment -%}
        {% render 'unix-card-stars', card_product: product_card_product %}

        <div class="product-parameters">
          {%- unless product_card_product.has_only_default_variant or settings.card_color_swatches_mode == 'none' -%}
            {%- for option in product_card_product.options_with_values -%}
              {%- liquid
                assign color_trigger = settings.trigger_swatch | handle | strip
                assign name_option = option.name | handle | strip

                assign is_color_option = false
                # for custom swatch type
                if settings.type_color_swatch == 'custom'
                  if name_option == color_trigger
                    assign is_color_option = true
                  endif
                endif

                # for standart swatch type
                # !!! for product card need Swatch trigger in settings
                if settings.type_color_swatch == 'standart'
                  if name_option == color_trigger
                    for value in option.values
                      if value.swatch.color != blank
                        assign is_color_option = true
                      endif
                    endfor
                  endif
                endif
              -%}
              {%- if is_color_option and option.values.size > 1 -%}
                <div class="product-form__controls js-color-swatches">
                  <div class="product-form__controls-group">
                    {% render 'product-variant-options',
                      product: product_card_product,
                      option: option,
                      section_obj: section,
                      has_color_swatch: true,
                      is_product_card: true
                    %}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}
        </div>
      </div>
      <div class="card__info-group">
        {% render 'price', product: product_card_product, price_class: '' %}
        <div class="card__buttons">
          <a href="{{ product_card_product.url }}" class="card__more button button--simple">
            <span>{{ settings.more_label }}</span>
          </a>
          {%- if settings.quickview_show -%}
            <div class="quick-add no-js-hidden">
              <style>
                @media screen and (max-width: 989px) {
                  .quick-add-modal_desktop {
                    display: none;
                  }
                }
                @media screen and (min-width: 990px) {
                  .quick-add-modal_mobile {
                    display: none;
                  }
                }
              </style>
              {%- assign product_form_id = 'quick-add-' | append: section_id | append: product_card_product.id -%}
              <modal-opener-quick-view data-modal="#QuickAdd-{{ product_card_product.id }}">
                <button
                  id="{{ product_form_id }}-submit"
                  type="submit"
                  name="add"
                  class="button button--simple card-focused"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ product_card_product.id }}"
                  data-product-url="{{ product_card_product.url }}"
                  data-modal-aria-label="{{ 'products.product.choose_product_options' | t: product_name: product_card_product.title | escape }}"
                  data-product-id="{{ product_card_product.id }}"
                  data-modal-id="QuickAdd-{{ product_card_product.id }}"
                  data-modal-class="quick-add-modal{% if settings.quickview_show == false %} quick-add-modal_mobile{% endif %}"
                >
                  <span class="card__quickview-text">
                    {{- 'general.card.quick__view' | t -}}
                  </span>
                  <div class="loading-overlay__spinner hidden">
                    <div class="spinner"></div>
                  </div>
                </button>
              </modal-opener-quick-view>
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if show_desc and product_card_product.description != blank -%}
        <div class="card__description">
          {{ product_card_product.description | strip_html | truncate: 120 }}
        </div>
      {%- endif -%}
    </div>
  </div>
  <a
    href="{{ product_card_product.url | default: '#' }}"
    class="link link--overlay card-wrapper__link--overlay js-color-swatches-link"
    aria-label="{{ 'accessibility.product_link' | t }}"
  ></a>
</div>
