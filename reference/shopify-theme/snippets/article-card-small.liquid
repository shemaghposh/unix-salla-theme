{% comment %}
  	Renders an article card for a given blog with settings to either show the image or not.

  	Accepts:
  	- blog: {Object} Blog object
  	- article: {Object} Article object
  	- show_image: {String} The setting either show the article image or not. If it's not included it will show the image by default
  	- show_date: {String} The setting either show the article date or not. If it's not included it will not show the image by default
  	- show_author: {String} The setting either show the article author or not. If it's not included it will not show the author by default

  	Usage:
  {% render 'article-card-small' blog: blog, article: article, show_image: section.settings.show_image %}
{% endcomment %}

{% if article.metafields.custom.author_image != blank %}
  {%- assign author_image = article.metafields.custom.author_image -%}
{% elsif section_author_image != blank %}
  {%- assign author_image = section_author_image -%}
{% endif %}

<article
  class="article-card-small article-card-small--{{ image_ratio }}"
  aria-labelledby="Article-{{ article.id }}"
>
  {%- if show_image == true and article.image -%}
    <div class="article-card-small__image">
      {% capture sizes %}
      	(min-width: 576px) 400px, 250px
      {% endcapture %}
      {{
        article.image
        | image_url: width: 1100
        | image_tag: loading: 'lazy', sizes: sizes, widths: '106, 170, 375, 425, 576, 768, 990, 1100'
      }}
    </div>
  {%- endif -%}
  <div class="article-card-small__content motion-reduce">
    <div class="article-card-small__info">
      <div class="article-card-small__top">
        {%- if show_tags and article.tags != blank -%}
          <ul class="article-card-small__tags">
            {% for tag in article.tags %}
              <li class="article-card-small__tag body-small">
                <a href="{{ blog.url }}/tagged/{{ tag | handle }}">
                  <span title="{{ tag }}">{{ tag }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {%- endif -%}
        {% if show_date or article.comments_count > 0 and blog.comments_enabled? %}
          <div class="article-card-small__meta">
            {%- if show_date -%}
              <span class="article-card-small__date body-small">
                {{- article.published_at | time_tag: format: 'abbreviated_date' -}}
              </span>
            {%- endif -%}
            {%- if article.comments_count > 0 and blog.comments_enabled? -%}
              <span class="article-card-small__comments body-small">
                {{- 'blogs.article.comments' | t: count: article.comments_count -}}
              </span>
            {%- endif -%}
          </div>
        {% endif %}
      </div>

      <div class="article-card-small__bottom">
        <header class="article-card-small__header">
          <{{ heading_tag | default: 'h3' }}
            class="article-card-small__title h3"
            id="Article-{{ article.id }}"
          >
            <a href="{{ article.url }}">
              {{ article.title | escape }}
            </a>
          </{{ heading_tag | default: 'h3' }}>
        </header>
        {%- if show_excerpt and article.excerpt_or_content.size > 0 -%}
          <p class="article-card-small__excerpt body-small">
            {{ article.excerpt_or_content | strip_html | truncate: 150 }}
          </p>
        {%- endif -%}
        {% if show_author %}
          <div class="article-card-small__author body-small">
            <span>{{- 'general.blog.author' | t -}}</span>
            {% if author_image %}
              <div class="article-card-small__author-image">
                {{
                  author_image
                  | image_url: width: author_image.width
                  | image_tag: loading: 'lazy', widths: '50, 100'
                }}
              </div>
            {% endif %}
            <span class="article-card-small__author-name">{{- article.author -}}</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
  <a class="article-card-small-link" href="{{ article.url }}" aria-label="{{ "accessibility.article_link" | t }}"></a>
</article>
