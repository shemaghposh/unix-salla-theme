{% comment %}
  	Renders a horizontal product card
  	Accepts:
  	- product_card_product: {Object} Product Liquid object (optional)
  	- media_size: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  	- show_vendor: {Boolean} Show the product vendor. Default: true
  	Usage:
  {% render 'product-card-horizontal',
  	product_card_product: product,
  	show_vendor: true
  %}
{% endcomment %}

{% liquid
  assign aspect_ratio = media_ratio | split: '/'
  assign temp = aspect_ratio[0] | append: '.0'
  assign padding_bottom = aspect_ratio[1] | divided_by: temp | times: 100 | round: 2

  assign card_index = 1

  if forloop_index != blank
    assign card_index = forloop_index | modulo: 4 | plus: 1
  endif
%}

<div
  class="
    card-horizontal-wrapper color-{{ color_scheme }}
    card-horizontal-wrapper--{{ settings.card_secondary_text }}
    {% if product_card_product == blank %} card-horizontal-wrapper_blank {% endif %}
  "
  data-product="{{ product_card_product.handle }}"
>
  <span class="visually-hidden">{{ product_card_product.title | escape }}</span>

  <div class="card-horizontal__image" tabindex="-1">
    <div
      class="media"
      style="padding-bottom: {{ padding_bottom }}%; --object_fit: {{ media_fit }};"
    >
      {%- if product_card_product.featured_media -%}
        <img
          srcset="{{ product_card_product.featured_media | image_url: width: 85 }}, {{ product_card_product.featured_media | image_url: width: 170 }} 2x"
          src="{{ product_card_product.featured_media | image_url: width: 170 }}"
          alt="{{ product_card_product.featured_media.alt | escape }}"
          loading="lazy"
          width="{{ product_card_product.featured_media.width }}"
          height="{{ product_card_product.featured_media.height }}"
        >

        {% comment %}
          {{
            product_card_product.featured_media
            | image_url: width: 170
            | image_tag: loading: 'lazy', class: 'motion-reduce media--first'
          }}
        {% endcomment %}
      {%- else -%}
        {{ 'product-apparel-' | append: card_index | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>

  <div class="card-horizontal__group">
    <div class="card-horizontal__information">
      {%- if show_vendor and product_card_product.vendor -%}
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        <div class="card-horizontal__vendor body-small {% if settings.enable_vendor_link %} card-horizontal__vendor_link {% endif %}">
          {% if settings.enable_vendor_link %}
            {{ product_card_product.vendor | link_to_vendor: class: 'focus-inset' }}
          {% else %}
            {{ product_card_product.vendor }}
          {% endif %}
        </div>
      {%- endif -%}

      <{{ heading_tag | default: 'h3' }} class="card-horizontal__title">
        {% if product_card_product.title %}
          <a
            class="full-unstyled-link"
            href="{{ product_card_product.url | default: '#' }}"
            title="{{ product_card_product.title | escape }}"
          >
            {{ product_card_product.title | escape }}
          </a>
        {% else %}
          {{ 'products.product.product_heading' | t }}
        {% endif %}
      </{{ heading_tag | default: 'h3' }}>
      {% render 'price', product: product_card_product, price_class: '' %}
    </div>
    {% render 'icon-caret-right' %}
  </div>
  {% if product_card_product.url %}
    <a
      href="{{ product_card_product.url | default: '#' }}"
      class="link link--overlay card-wrapper__link--overlay"
      aria-label="{{ 'accessibility.product_link' | t }}"
    ></a>
  {% endif %}
</div>
