{% comment %}
  Example: {% render 'header-logo', tag: 'h1' %}
{% endcomment %}

{%- if request.page_type == 'index' and  tag != blank-%}
  <{{ tag }} class="header__heading">
{%- endif -%}
<a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
  {%- if section.settings.logo != blank -%}
    {%- assign image_size = section.settings.logo_width | append: 'x' -%}
    {%- assign image_size_2_x = section.settings.logo_width | times: 2 | at_most: 5760 -%}
    <img
      srcset="{{ section.settings.logo | image_url: width: image_size }} 1x, {{ section.settings.logo | image_url: width: image_size_2_x }} 2x"
      src="{{ section.settings.logo | image_url: width: image_size }}"
      class="header__heading-logo{% if class != blank %} {{ class }}{% endif %}"
      width="{{ section.settings.logo_width }}"
      height="{{ 1 | divided_by: section.settings.logo.aspect_ratio | times: 100 | round: 2 }}"
      alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
      fetch_priority="high"
    >
    {%- if section.settings.logo_2 != blank -%}
      <img
        srcset="{{ section.settings.logo_2 | image_url: width: image_size }} 1x, {{ section.settings.logo_2 | image_url: width: image_size_2_x }} 2x"
        src="{{ section.settings.logo_2 | image_url: width: image_size }}"
        class="header__heading-logo header__heading-logo--overlay{% if class != blank %} {{ class }}{% endif %}"
        width="{{ section.settings.logo_width }}"
        height="{{ 1 | divided_by: section.settings.logo_2.aspect_ratio | times: 100 | round: 2 }}"
        alt="{{ section.settings.logo_2.alt | default: shop.name | escape }}"
        fetch_priority="high"
      >
    {%- endif -%}
  {%- elsif section.settings.logo_2 != blank -%}
    {%- assign image_size = section.settings.logo_width | append: 'x' -%}
    {%- assign image_size_2_x = section.settings.logo_width | times: 2 | at_most: 5760 -%}
    <img
      srcset="{{ section.settings.logo_2 | image_url: width: image_size }} 1x, {{ section.settings.logo_2 | image_url: width: image_size_2_x }} 2x"
      src="{{ section.settings.logo_2 | image_url: width: image_size }}"
      class="header__heading-logo header__heading-logo--overlay"
      width="{{ section.settings.logo_width }}"
      height="{{ 1 | divided_by: section.settings.logo_2.aspect_ratio | times: 100 | round: 2 }}"
      alt="{{ section.settings.logo_2.alt | default: shop.name | escape }}"
      fetch_priority="high"
    >
  {%- else -%}
    <span>{{ shop.name }}</span>
  {%- endif -%}
</a>
{%- if request.page_type == 'index' and  tag != blank-%}
  </{{ tag }}>
{%- endif -%}
